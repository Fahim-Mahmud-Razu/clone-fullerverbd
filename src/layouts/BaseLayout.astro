---
import BRAND from '../config/site';
import SiteHeader from '../components/SiteHeader.astro';
import MobileMenu from '../components/MobileMenu.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/shared.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  locale?: 'en' | 'jp' | 'kr';
  bodyClass?: string;
}

const {
  title = `${BRAND.companyName} - ${BRAND.tagline}`,
  description = `${BRAND.companyName} is a premier manufacturer of high quality safety gloves, leather driver gloves, welding articles, and protective apparel based in ${BRAND.factoryAddress}. ${BRAND.tagline}.`,
  currentPath = '/',
  locale = 'en',
  bodyClass = 'sticky-header'
} = Astro.props;
---

<!doctype html>
<html class="no-js" lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="theme-color" content={BRAND.colors.navy} />

    <!-- Favicons & App Icons -->
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Open Graph & Twitter Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BRAND.companyName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${BRAND.websiteUrl}${currentPath}`} />
    <meta property="og:image" content={`${BRAND.websiteUrl}${BRAND.logo.stacked}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${BRAND.websiteUrl}${BRAND.logo.stacked}`} />

    <!-- JSON-LD Structured Data: Organization & LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": BRAND.companyName,
      "alternateName": BRAND.shortName,
      "url": BRAND.websiteUrl,
      "logo": `${BRAND.websiteUrl}${BRAND.logo.stacked}`,
      "email": BRAND.email,
      "telephone": BRAND.phone,
      "slogan": BRAND.tagline,
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "585/C, Khilgaon, C Block",
        "addressLocality": "Dhaka",
        "postalCode": "1219",
        "addressCountry": "BD"
      },
      "location": [
        {
          "@type": "Place",
          "name": "Head Office",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": BRAND.officeAddress,
            "addressLocality": "Dhaka",
            "postalCode": "1219",
            "addressCountry": "BD"
          }
        },
        {
          "@type": "Place",
          "name": "Manufacturing Factory",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": BRAND.factoryAddress,
            "addressCountry": "BD"
          }
        }
      ]
    })} />

    <!-- Google Fonts (Montserrat for headings, Inter for body) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <!-- Source Stylesheets in Exact Cascade Order -->
    <link rel="stylesheet" href="/front-end/css/normalize.css" />
    <link rel="stylesheet" href="/front-end/css/main.css" />
    <link rel="stylesheet" href="/front-end/css/bootstrap.min.css" />
    <link rel="stylesheet" href="/front-end/css/meanmenu.min.css" />
    <link rel="stylesheet" href="/front-end/css/fontawesome-all.min.css" />
    <link rel="stylesheet" href="/front-end/css/animate.min.css" />
    <link rel="stylesheet" href="/front-end/font/flaticon.css" />
    <link rel="stylesheet" href="/front-end/vendor/slick/slick.css" />
    <link rel="stylesheet" href="/front-end/vendor/slick/slick-theme.css" />
    <link rel="stylesheet" href="/front-end/css/select2.min.css" />
    <link rel="stylesheet" href="/front-end/css/magnific-popup.css" />
    <link rel="stylesheet" href="/front-end/css/style.css" />

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <div id="wrapper" class="wrapper">
      <SiteHeader currentPath={currentPath} locale={locale} />
      <MobileMenu currentPath={currentPath} locale={locale} />

      <main id="main-content">
        <slot />
      </main>

      <SiteFooter locale={locale} />
    </div>

    <!-- Client Interactivity Script -->
    <script>
      // 1. Sticky Header with Zero Layout Shift
      const headerMenu = document.getElementById('header-menu');
      const stickyPlaceholder = document.getElementById('rt-sticky-placeholder');
      const scrollUpBtn = document.getElementById('scrollUpBtn');

      let naturalMenuHeight = 0;
      function updateMenuMetrics() {
        if (headerMenu && !headerMenu.classList.contains('rt-sticky')) {
          naturalMenuHeight = headerMenu.offsetHeight;
        }
      }
      updateMenuMetrics();
      window.addEventListener('resize', updateMenuMetrics, { passive: true });

      function handleScroll() {
        const scrollY = window.scrollY || window.pageYOffset;
        if (headerMenu && stickyPlaceholder && window.innerWidth >= 992) {
          if (scrollY > 60) {
            if (!headerMenu.classList.contains('rt-sticky')) {
              updateMenuMetrics();
              stickyPlaceholder.style.height = `${naturalMenuHeight || 80}px`;
              stickyPlaceholder.classList.add('is-active');
              headerMenu.classList.add('rt-sticky');
            }
          } else {
            if (headerMenu.classList.contains('rt-sticky')) {
              headerMenu.classList.remove('rt-sticky');
              stickyPlaceholder.classList.remove('is-active');
              stickyPlaceholder.style.height = '0px';
            }
          }
        }

        // Scroll-to-top button visibility
        if (scrollUpBtn) {
          if (scrollY > 300) {
            scrollUpBtn.classList.add('back-top');
          } else {
            scrollUpBtn.classList.remove('back-top');
          }
        }
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();

      // Scroll to top action
      if (scrollUpBtn) {
        scrollUpBtn.addEventListener('click', (e) => {
          e.preventDefault();
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      }

      // 2. Mobile Menu Toggle & Accordion (closes on navigation)
      const mobileBtn = document.getElementById('mobileMenuBtn');
      const mobileNav = document.getElementById('mobileNavMenu');
      const prodExpandBtn = document.getElementById('mobileProductsExpand');
      const prodSubmenu = document.getElementById('mobileProductsSubmenu');
      const langExpandBtn = document.getElementById('mobileLangExpand');
      const langSubmenu = document.getElementById('mobileLangSubmenu');

      if (mobileBtn && mobileNav) {
        mobileBtn.addEventListener('click', (e) => {
          e.preventDefault();
          const isOpen = mobileNav.classList.toggle('is-open');
          mobileBtn.classList.toggle('meanclose', isOpen);
        });

        // Close menu immediately after link is tapped
        mobileNav.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            const href = link.getAttribute('href');
            if (href && href !== '#' && !link.classList.contains('mean-expand')) {
              mobileNav.classList.remove('is-open');
              mobileBtn.classList.remove('meanclose');
            }
          });
        });

        // Close when clicking outside mobile nav and button
        document.addEventListener('click', (e) => {
          const target = e.target as HTMLElement | null;
          if (
            mobileNav.classList.contains('is-open') &&
            target &&
            !mobileNav.contains(target) &&
            !mobileBtn.contains(target)
          ) {
            mobileNav.classList.remove('is-open');
            mobileBtn.classList.remove('meanclose');
          }
        });

        // Close when window resized to desktop
        window.addEventListener('resize', () => {
          if (window.innerWidth >= 992 && mobileNav.classList.contains('is-open')) {
            mobileNav.classList.remove('is-open');
            mobileBtn.classList.remove('meanclose');
          }
        }, { passive: true });
      }

      function toggleSubmenu(btn: HTMLElement | null, submenu: HTMLElement | null) {
        if (!btn || !submenu) return;
        const isExpanded = submenu.classList.toggle('sub-open');
        btn.textContent = isExpanded ? '-' : '+';
      }

      if (prodExpandBtn && prodSubmenu) {
        prodExpandBtn.addEventListener('click', (e) => {
          e.preventDefault();
          toggleSubmenu(prodExpandBtn, prodSubmenu);
        });
        const prodParentLink = prodExpandBtn.parentElement?.querySelector('a:not(.mean-expand)');
        prodParentLink?.addEventListener('click', (e) => {
          e.preventDefault();
          toggleSubmenu(prodExpandBtn, prodSubmenu);
        });
      }

      if (langExpandBtn && langSubmenu) {
        langExpandBtn.addEventListener('click', (e) => {
          e.preventDefault();
          toggleSubmenu(langExpandBtn, langSubmenu);
        });
        const langParentLink = langExpandBtn.parentElement?.querySelector('a:not(.mean-expand)');
        langParentLink?.addEventListener('click', (e) => {
          e.preventDefault();
          toggleSubmenu(langExpandBtn, langSubmenu);
        });
      }

      // 3. Desktop Language Dropdown Toggle
      const langBtn = document.getElementById('dropdownMenuButton');
      if (langBtn) {
        langBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const menu = langBtn.nextElementSibling as HTMLElement;
          if (menu) {
            menu.classList.toggle('show');
          }
        });
        document.addEventListener('click', () => {
          const menu = langBtn.nextElementSibling as HTMLElement;
          if (menu && menu.classList.contains('show')) {
            menu.classList.remove('show');
          }
        });
      }
    </script>
  </body>
</html>
