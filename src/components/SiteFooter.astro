---
interface Props {
  locale?: 'en' | 'jp' | 'kr';
}

const { locale = 'en' } = Astro.props;

const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
const aboutUrl = locale === 'en' ? '/about' : `/${locale}/about`;
const complianceUrl = locale === 'en' ? '/compliance' : `/${locale}/compliance`;
const facilitiesUrl = locale === 'en' ? '/facilities' : `/${locale}/facilities`;
const contactUrl = locale === 'en' ? '/contact' : `/${locale}/contact`;
---

<footer class="footer-wrap-layout1">
  <div class="footer-top-wrap-layout1">
    <div class="container">
      <div class="row">
        <div class="col-lg-4" style="margin-top: -32px;">
          <div class="footer-box-layout1">
            <div class="footer-logo">
              <a href={homeUrl}><img src="/front-end/img/bd_logo-bw.png" alt="logo" width="318" height="84" /></a>
            </div>
            <p>We always deliver 100% customer satisfaction and absolute quality work without any other compromise, just like we've been doing since 1978.</p>
            <hr style="background-color:#ffffff; margin-top: -25px;" />
            <h3 class="footer-title" style="color: #fff; margin-top: -5px; font-size: 24px; font-weight: 500;">CLASS "A" MEMBER OF FLAXA</h3>
            <img src="/front-end/img/FLAXA.png" alt="FLAXA" style="margin-top: -15px;" />
          </div>
        </div>

        <div class="col-lg-4">
          <div class="footer-box-layout1">
            <div class="footer-title">
              <h3>Quick Links</h3>
            </div>
            <div class="footer-menu-box">
              <ul class="footer-menu-list">
                <li><a href={homeUrl}>Home</a></li>
                <li><a href={aboutUrl}>About Us</a></li>
                <li><a href={complianceUrl}>Compliance</a></li>
                <li><a href={facilitiesUrl}>Our Facilities</a></li>
                <li><a href={contactUrl}>Contact us</a></li>
                <li><a href="/category/17">Driver Gloves</a></li>
              </ul>
              <ul class="footer-menu-list">
                <li><a href="/category/18">Grain Gloves</a></li>
                <li><a href="/category/19">Split Gloves</a></li>
                <li><a href="/category/20">Welding Gloves</a></li>
                <li><a href="/category/21">Palm Gloves</a></li>
                <li><a href="/category/24">Leather Welding Jacket</a></li>
                <li><a href="/category/25">Leather Welding Trouser</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="col-lg-4">
          <div class="footer-box-layout1">
            <div class="footer-title">
              <h3>Contact Us</h3>
            </div>
            <div class="footer-contac">
              <h3>FULLEVER BD LIMITED</h3>
              <p>
                <i class="flaticon-maps-and-flags"></i> 320, Choydana (Hazirpukur), National University, Gacha, Gazipur, Bangladesh.
              </p>
            </div>
            <ul class="footer-social">
              <li><a href="https://www.facebook.com/FULLEVERBD" target="_blank" rel="noopener noreferrer"><i class="fab fa-facebook-f"></i></a></li>
              <li><a href="https://www.linkedin.com/company/full-ever-bd-limited" target="_blank" rel="noopener noreferrer"><i class="fab fa-linkedin-in"></i></a></li>
              <li><a href="https://www.instagram.com/fulleverbd/" target="_blank" rel="noopener noreferrer"><i class="fab fa-instagram"></i></a></li>
              <li><a href="https://twitter.com/FullEverBD" target="_blank" rel="noopener noreferrer"><i class="fab fa-twitter"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom-wrap-layout1" style="margin-top:-50px;">
    <div class="container">
      <div class="row">
        <div class="col-lg-12">
          <div class="copyright text-center">
            Copyright © 2026 <a href={homeUrl}>FULLEVER BD LIMITED by</a> All Rights Reserved.
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- ScrollUp Button -->
<a href="#wrapper" data-type="section-switch" class="scrollup" id="scrollUpBtn" aria-label="Scroll to top">
  <i class="fas fa-angle-double-up"></i>
</a>
