---
import BRAND from '../config/site';

interface Props {
  locale?: 'en' | 'jp' | 'kr';
}

const { locale = 'en' } = Astro.props;

const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
const aboutUrl = locale === 'en' ? '/about' : `/${locale}/about`;
const complianceUrl = locale === 'en' ? '/compliance' : `/${locale}/compliance`;
const facilitiesUrl = locale === 'en' ? '/facilities' : `/${locale}/facilities`;
const contactUrl = locale === 'en' ? '/contact' : `/${locale}/contact`;
---

<footer class="footer-wrap-layout1" style="position: relative; overflow: hidden;">
  <!-- Letterhead Signature Navy Wave with Orange Curved Accent Strip -->
  <div class="footer-letterhead-wave" aria-hidden="true" style="width: 100%; overflow: hidden; line-height: 0; background: transparent;">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" style="display: block; width: 100%; height: 42px;">
      <!-- Orange Curved Strip Accent (from letterhead) -->
      <path d="M0,20 C360,55 720,5 1080,38 C1260,52 1380,24 1440,30 L1440,60 L0,60 Z" fill={BRAND.colors.orange} opacity="0.95"></path>
      <!-- Dominant Navy Wave Joining Footer Body -->
      <path d="M0,28 C340,60 700,16 1060,46 C1240,60 1370,32 1440,38 L1440,60 L0,60 Z" fill={BRAND.colors.navy}></path>
    </svg>
  </div>

  <div class="footer-top-wrap-layout1" style="padding-top: 40px;">
    <div class="container">
      <div class="row">
        <!-- Brand & Mission Column -->
        <div class="col-lg-4" style="margin-top: -15px;">
          <div class="footer-box-layout1">
            <div class="footer-logo" style="margin-bottom: 20px;">
              <a href={homeUrl}>
                <img
                  src={BRAND.logo.stackedWhite}
                  alt={BRAND.logo.alt}
                  width="180"
                  height="210"
                  style="max-height: 140px; width: auto; object-fit: contain; display: block;"
                />
              </a>
            </div>
            <p style="color: #cbd5e1; font-size: 15px; line-height: 1.6; margin-bottom: 15px;">
              <strong style="color: #ffffff;">{BRAND.companyName}</strong> — {BRAND.tagline}. Dedicated to delivering absolute quality safety and leather protective equipment.
            </p>
            <hr style="background-color: rgba(255, 255, 255, 0.15); margin: 20px 0;" />
            <div class="tagline-badge" style="display: inline-flex; align-items: center; gap: 8px; color: var(--brand-orange); font-weight: 700; font-size: 14px;">
              <i class="fas fa-shield-alt"></i> {BRAND.tagline}
            </div>
          </div>
        </div>

        <!-- Quick Links Column -->
        <div class="col-lg-4">
          <div class="footer-box-layout1">
            <div class="footer-title">
              <h3 style="color: #ffffff; font-size: 20px; font-weight: 700; margin-bottom: 20px; position: relative;">
                Quick Links
              </h3>
            </div>
            <div class="footer-menu-box">
              <ul class="footer-menu-list">
                <li><a href={homeUrl}>Home</a></li>
                <li><a href={aboutUrl}>About Us</a></li>
                <li><a href={complianceUrl}>Compliance</a></li>
                <li><a href={facilitiesUrl}>Our Facilities</a></li>
                <li><a href={contactUrl}>Contact Us</a></li>
                <li><a href="/category/17">Leather Driver Gloves</a></li>
              </ul>
              <ul class="footer-menu-list">
                <li><a href="/category/18">Leather Grain Gloves</a></li>
                <li><a href="/category/19">Leather Split Gloves</a></li>
                <li><a href="/category/20">Leather Welding Gloves</a></li>
                <li><a href="/category/21">Leather Palm Gloves</a></li>
                <li><a href="/category/24">Leather Welding Jackets</a></li>
                <li><a href="/category/25">Leather Welding Trousers</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Contact Information Block (Order: Phone -> Email -> Office -> Factory) -->
        <div class="col-lg-4">
          <div class="footer-box-layout1">
            <div class="footer-title">
              <h3 style="color: #ffffff; font-size: 20px; font-weight: 700; margin-bottom: 20px;">
                Contact Us
              </h3>
            </div>
            <div class="footer-contac" style="color: #cbd5e1; font-size: 14.5px; line-height: 28px;">
              <h4 style="color: #ffffff; font-size: 18px; font-weight: 700; margin-bottom: 12px;">
                {BRAND.companyName}
              </h4>
              <!-- 1. Phone -->
              <p style="margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-phone-alt" style="color: var(--brand-orange);" aria-hidden="true"></i>
                <span><a href={BRAND.phoneTel} style="color: #ffffff; text-decoration: none; font-weight: 600;">{BRAND.phone}</a></span>
              </p>
              <!-- 2. Email -->
              <p style="margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">
                <i class="far fa-envelope" style="color: var(--brand-orange);" aria-hidden="true"></i>
                <span><a href={BRAND.emailMailto} style="color: #ffffff; text-decoration: none;">{BRAND.email}</a></span>
              </p>
              <!-- 3. Office -->
              <p style="margin-bottom: 8px; display: flex; align-items: flex-start; gap: 10px;">
                <i class="fas fa-building" style="color: var(--brand-orange); margin-top: 5px;" aria-hidden="true"></i>
                <span><strong>Office:</strong> {BRAND.officeAddress}</span>
              </p>
              <!-- 4. Factory -->
              <p style="margin-bottom: 8px; display: flex; align-items: flex-start; gap: 10px;">
                <i class="fas fa-industry" style="color: var(--brand-orange); margin-top: 5px;" aria-hidden="true"></i>
                <span><strong>Factory:</strong> {BRAND.factoryAddress}</span>
              </p>
              <!-- Website -->
              <p style="margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-globe" style="color: var(--brand-orange);" aria-hidden="true"></i>
                <span><a href={BRAND.websiteUrl} target="_blank" rel="noopener noreferrer" style="color: #ffffff; text-decoration: none;">{BRAND.website}</a></span>
              </p>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom-wrap-layout1" style="margin-top: -30px; padding: 22px 0;">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-12">
          <div class="copyright text-center" style="color: rgba(255, 255, 255, 0.85); font-size: 14.5px;">
            <div>{BRAND.copyright} &nbsp;|&nbsp; <span style="color: var(--brand-orange); font-weight: 600;">{BRAND.tagline}</span></div>
            <div style="margin-top: 6px; font-size: 12px; color: rgba(255, 255, 255, 0.55);">{BRAND.developerCredit}</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- ScrollUp Button -->
<a href="#wrapper" data-type="section-switch" class="scrollup" id="scrollUpBtn" aria-label="Scroll to top">
  <i class="fas fa-angle-double-up" aria-hidden="true"></i>
</a>
