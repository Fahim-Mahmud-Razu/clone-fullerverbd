---
interface Props {
  locale?: 'en' | 'jp' | 'kr';
}

const { locale = 'en' } = Astro.props;

const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
const aboutUrl = locale === 'en' ? '/about' : `/${locale}/about`;
const complianceUrl = locale === 'en' ? '/compliance' : `/${locale}/compliance`;
const facilitiesUrl = locale === 'en' ? '/facilities' : `/${locale}/facilities`;
const contactUrl = locale === 'en' ? '/contact' : `/${locale}/contact`;
---

<footer class="footer-wrap-layout1">
  <div class="footer-top-wrap-layout1">
    <div class="container">
      <div class="row">
        <!-- Brand & Mission Column -->
        <div class="col-lg-4" style="margin-top: -15px;">
          <div class="footer-box-layout1">
            <div class="footer-logo" style="margin-bottom: 20px;">
              <a href={homeUrl}>
                <img
                  src="/front-end/img/max-logo-stacked-white.png"
                  alt="Max Gloves BD Ltd. logo"
                  width="180"
                  height="210"
                  style="max-height: 140px; width: auto; object-fit: contain; display: block;"
                />
              </a>
            </div>
            <p style="color: #cbd5e1; font-size: 15px; line-height: 1.6; margin-bottom: 15px;">
              <strong style="color: #ffffff;">Max Gloves BD Ltd.</strong> — Protecting Hands, Building Futures. Dedicated to delivering absolute quality safety and leather protective equipment.
            </p>
            <hr style="background-color: rgba(255, 255, 255, 0.15); margin: 20px 0;" />
            <div class="tagline-badge" style="display: inline-flex; align-items: center; gap: 8px; color: var(--brand-orange); font-weight: 700; font-size: 14px;">
              <i class="fas fa-shield-alt"></i> Protecting Hands, Building Futures
            </div>
          </div>
        </div>

        <!-- Quick Links Column -->
        <div class="col-lg-4">
          <div class="footer-box-layout1">
            <div class="footer-title">
              <h3 style="color: #ffffff; font-size: 20px; font-weight: 700; margin-bottom: 20px; position: relative;">
                Quick Links
              </h3>
            </div>
            <div class="footer-menu-box">
              <ul class="footer-menu-list">
                <li><a href={homeUrl}>Home</a></li>
                <li><a href={aboutUrl}>About Us</a></li>
                <li><a href={complianceUrl}>Compliance</a></li>
                <li><a href={facilitiesUrl}>Our Facilities</a></li>
                <li><a href={contactUrl}>Contact Us</a></li>
                <li><a href="/category/17">Driver Gloves</a></li>
              </ul>
              <ul class="footer-menu-list">
                <li><a href="/category/18">Grain Gloves</a></li>
                <li><a href="/category/19">Split Gloves</a></li>
                <li><a href="/category/20">Welding Gloves</a></li>
                <li><a href="/category/21">Palm Gloves</a></li>
                <li><a href="/category/24">Leather Welding Apparel</a></li>
                <li><a href="/category/27">Synthetic Gloves</a></li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Contact Information Block -->
        <div class="col-lg-4">
          <div class="footer-box-layout1">
            <div class="footer-title">
              <h3 style="color: #ffffff; font-size: 20px; font-weight: 700; margin-bottom: 20px;">
                Contact Us
              </h3>
            </div>
            <div class="footer-contac" style="color: #cbd5e1; font-size: 14.5px; line-height: 28px;">
              <h4 style="color: #ffffff; font-size: 18px; font-weight: 700; margin-bottom: 12px;">
                Max Gloves BD Ltd.
              </h4>
              <p style="margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-phone-alt" style="color: var(--brand-orange);"></i>
                <span><a href="tel:+8801710591088" style="color: #ffffff; text-decoration: none; font-weight: 600;">+880 1710-591088</a></span>
              </p>
              <p style="margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-envelope" style="color: var(--brand-orange);"></i>
                <span><a href="mailto:maxglovesbdltd@gmail.com" style="color: #ffffff; text-decoration: none;">maxglovesbdltd@gmail.com</a></span>
              </p>
              <p style="margin-bottom: 8px; display: flex; align-items: flex-start; gap: 10px;">
                <i class="fas fa-building" style="color: var(--brand-orange); margin-top: 5px;"></i>
                <span>Office: 585/C, Khilgaon, C Block, Dhaka-1219</span>
              </p>
              <p style="margin-bottom: 8px; display: flex; align-items: flex-start; gap: 10px;">
                <i class="fas fa-industry" style="color: var(--brand-orange); margin-top: 5px;"></i>
                <span>Factory: Savar, Hemayetpur</span>
              </p>
              <p style="margin-bottom: 8px; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-globe" style="color: var(--brand-orange);"></i>
                <span><a href="http://www.maxglovesbdltd.com" target="_blank" rel="noopener noreferrer" style="color: #ffffff; text-decoration: none;">www.maxglovesbdltd.com</a></span>
              </p>
            </div>
            <ul class="footer-social" style="margin-top: 15px; display: flex; gap: 10px; list-style: none; padding: 0;">
              <li><a href="#" title="[FACEBOOK_URL]" aria-label="[FACEBOOK_URL]"><i class="fab fa-facebook-f"></i></a></li>
              <li><a href="#" title="[LINKEDIN_URL]" aria-label="[LINKEDIN_URL]"><i class="fab fa-linkedin-in"></i></a></li>
              <li><a href="#" title="[INSTAGRAM_URL]" aria-label="[INSTAGRAM_URL]"><i class="fab fa-instagram"></i></a></li>
              <li><a href="#" title="[TWITTER_URL]" aria-label="[TWITTER_URL]"><i class="fab fa-twitter"></i></a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom-wrap-layout1" style="margin-top: -30px; padding: 22px 0;">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-lg-12">
          <div class="copyright text-center" style="color: rgba(255, 255, 255, 0.8); font-size: 14.5px;">
            © 2026 Max Gloves BD Ltd. All rights reserved. &nbsp;|&nbsp; <span style="color: var(--brand-orange); font-weight: 600;">Protecting Hands, Building Futures</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</footer>

<!-- ScrollUp Button -->
<a href="#wrapper" data-type="section-switch" class="scrollup" id="scrollUpBtn" aria-label="Scroll to top">
  <i class="fas fa-angle-double-up"></i>
</a>
