---
import BRAND from '../config/site';

interface Props {
  currentPath?: string;
  locale?: 'en' | 'jp' | 'kr';
}

const { currentPath = '/', locale = 'en' } = Astro.props;

const isHome = currentPath === '/' || currentPath === '/jp/' || currentPath === '/kr/';
const isAbout = currentPath.includes('/about');
const isFacilities = currentPath.includes('/facilities');
const isCompliance = currentPath.includes('/compliance');
const isGallery = currentPath.includes('/gallery');
const isContact = currentPath.includes('/contact');

const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
const aboutUrl = locale === 'en' ? '/about' : `/${locale}/about`;
const facilitiesUrl = locale === 'en' ? '/facilities' : `/${locale}/facilities`;
const complianceUrl = locale === 'en' ? '/compliance' : `/${locale}/compliance`;
const galleryUrl = locale === 'en' ? '/gallery' : `/${locale}/gallery`;
const contactUrl = locale === 'en' ? '/contact' : `/${locale}/contact`;

const labels = {
  en: {
    home: 'HOME',
    about: 'ABOUT US',
    facilities: 'OUR FACILITIES',
    compliance: 'COMPLIANCE',
    products: 'OUR PRODUCT',
    gallery: 'GALLERY',
    contact: 'CONTACT US',
    language: 'Language'
  },
  jp: {
    home: 'ホームページ',
    about: '私たちについて',
    facilities: '私たちの施設',
    compliance: 'コンプライアンス',
    products: '私たちの商品',
    gallery: 'ギャラリー',
    contact: 'お問い合わせ',
    language: '言語'
  },
  kr: {
    home: '홈 페이지',
    about: '회사 소개',
    facilities: '우리 시설',
    compliance: '규정 준수',
    products: '우리의 제품',
    gallery: '갤러리',
    contact: '문의하기',
    language: '언어'
  }
}[locale];
---

<div class="mean-container">
  <div class="mean-bar">
    <a href={homeUrl} class="mean-logo">
      <img src={BRAND.logo.horizontal} alt={BRAND.logo.alt} style="max-height: 38px; width: auto; object-fit: contain;" />
    </a>
    <a href="#nav" class="meanmenu-reveal" id="mobileMenuBtn" aria-label="Toggle Navigation">
      <span></span>
      <span></span>
      <span></span>
    </a>
  </div>
  <nav class="mean-nav" id="mobileNavMenu">
    <ul>
      <li>
        <a class={isHome ? 'active-m' : ''} href={homeUrl}>{labels.home}</a>
      </li>
      <li>
        <a class={isAbout ? 'active-m' : ''} href={aboutUrl}>{labels.about}</a>
      </li>
      <li>
        <a class={isFacilities ? 'active-m' : ''} href={facilitiesUrl}>{labels.facilities}</a>
      </li>
      <li>
        <a class={isCompliance ? 'active-m' : ''} href={complianceUrl}>{labels.compliance}</a>
      </li>
      <li class="has-submenu">
        <a href="#">{labels.products}</a>
        <a class="mean-expand" id="mobileProductsExpand" href="#" aria-label="Expand Products">+</a>
        <ul id="mobileProductsSubmenu">
          <li><a href="/category/23">Leather Winter Gloves</a></li>
          <li><a href="/category/17">Leather Driver Gloves</a></li>
          <li><a href="/category/18">Leather Grain Gloves</a></li>
          <li><a href="/category/19">Leather Split Gloves</a></li>
          <li><a href="/category/20">Leather Welding Gloves</a></li>
          <li><a href="/category/21">Leather Palm Gloves</a></li>
          <li><a href="/category/24">Leather Welding Jackets</a></li>
          <li><a href="/category/25">Leather Welding Trousers</a></li>
          <li><a href="/category/27">Synthetic Leather Gloves</a></li>
          <li><a href="/category/29">Mechanics Gloves</a></li>
          <li><a href="/category/30">Impact Gloves</a></li>
          <li><a href="/category/31">Cotton Gloves</a></li>
          <li><a href="/category/32">Gardening Gloves</a></li>
        </ul>
      </li>
      <li>
        <a class={isGallery ? 'active-m' : ''} href={galleryUrl}>{labels.gallery}</a>
      </li>
      <li>
        <a class={isContact ? 'active-m' : ''} href={contactUrl}>{labels.contact}</a>
      </li>
      <li class="has-submenu">
        <a href="#">{labels.language}</a>
        <a class="mean-expand" id="mobileLangExpand" href="#" aria-label="Expand Languages">+</a>
        <ul id="mobileLangSubmenu">
          <li><a href="/">English</a></li>
          <li><a href="/jp/">日本語</a></li>
          <li><a href="/kr/">한국인</a></li>
        </ul>
      </li>
    </ul>
  </nav>
</div>
