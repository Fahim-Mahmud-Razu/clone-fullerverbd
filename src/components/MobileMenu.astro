---
import BRAND from '../config/site';

interface Props {
  currentPath?: string;
  locale?: 'en' | 'jp' | 'kr';
}

const { currentPath = '/', locale = 'en' } = Astro.props;

const isHome = currentPath === '/' || currentPath === '/jp/' || currentPath === '/kr/';
const isAbout = currentPath.includes('/about');
const isFacilities = currentPath.includes('/facilities');
const isCompliance = currentPath.includes('/compliance');
const isGallery = currentPath.includes('/gallery');
const isContact = currentPath.includes('/contact');

const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
const aboutUrl = locale === 'en' ? '/about' : `/${locale}/about`;
const facilitiesUrl = locale === 'en' ? '/facilities' : `/${locale}/facilities`;
const complianceUrl = locale === 'en' ? '/compliance' : `/${locale}/compliance`;
const galleryUrl = locale === 'en' ? '/gallery' : `/${locale}/gallery`;
const contactUrl = locale === 'en' ? '/contact' : `/${locale}/contact`;

const labels = {
  en: {
    home: 'HOME',
    about: 'ABOUT US',
    facilities: 'OUR FACILITIES',
    compliance: 'COMPLIANCE',
    products: 'GLOVE CATALOG',
    gallery: 'GALLERY',
    contact: 'CONTACT US',
    language: 'LANGUAGE',
    rfq: 'SUBMIT RFQ INQUIRY'
  },
  jp: {
    home: 'ホーム',
    about: '企業情報',
    facilities: '製造施設',
    compliance: '認証規格',
    products: '製品カタログ',
    gallery: 'ギャラリー',
    contact: 'お問い合わせ',
    language: '言語選択',
    rfq: 'お見積り依頼'
  },
  kr: {
    home: '홈',
    about: '회사 소개',
    facilities: '생산 시설',
    compliance: '품질 인증',
    products: '제품 카탈로그',
    gallery: '갤러리',
    contact: '문의하기',
    language: '언어 선택',
    rfq: '견적 요청'
  }
}[locale];

const categories = [
  { id: 20, name: 'Leather Welding Gloves', url: '/category/20' },
  { id: 19, name: 'Leather Split Gloves', url: '/category/19' },
  { id: 17, name: 'Leather Driver Gloves', url: '/category/17' },
  { id: 18, name: 'Leather Grain Gloves', url: '/category/18' },
  { id: 23, name: 'Leather Winter Gloves', url: '/category/23' },
  { id: 21, name: 'Leather Palm Gloves', url: '/category/21' },
  { id: 27, name: 'Synthetic Leather Gloves', url: '/category/27' },
  { id: 29, name: 'Mechanic\'s Gloves', url: '/category/29' },
  { id: 30, name: 'Impact Gloves', url: '/category/30' },
  { id: 24, name: 'Leather Welding Jackets', url: '/category/24' },
  { id: 25, name: 'Leather Welding Trousers', url: '/category/25' },
  { id: 31, name: 'Cotton Interlock Gloves', url: '/category/31' },
  { id: 32, name: 'Gardening Gloves', url: '/category/32' }
];
---

<div class="architectural-mobile-bar d-lg-none">
  <!-- Carbon-Steel Industrial Mobile Topbar (Identical to Desktop Topbar) -->
  <div class="mobile-topbar-steel">
    <div class="mobile-topbar-inner">
      <a
        href={BRAND.whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-topbar-link font-mono"
        aria-label={`WhatsApp ${BRAND.phone}`}
      >
        <i class="fab fa-whatsapp text-whatsapp" aria-hidden="true"></i>
        <span>{BRAND.phone}</span>
      </a>
      <span class="mobile-topbar-sep" aria-hidden="true">|</span>
      <a href={BRAND.emailMailto} class="mobile-topbar-link font-mono" aria-label={`Email ${BRAND.email}`}>
        <i class="far fa-envelope text-crimson" aria-hidden="true"></i>
        <span>{BRAND.email}</span>
      </a>
    </div>
  </div>

  <!-- Crisp White Mobile Main Bar (Matching Desktop Image 1) -->
  <div class="mobile-bar-inner">
    <a href={homeUrl} class="mobile-logo-anchor" aria-label={`${BRAND.companyName} Home`}>
      <img
        src={BRAND.logo.horizontal}
        alt={BRAND.logo.alt}
        width="190"
        height="48"
        class="mobile-brand-logo"
      />
    </a>

    <div class="mobile-bar-actions">
      <a href={contactUrl} class="btn-mobile-rfq-action font-mono" aria-label="Request RFQ">
        <span>RFQ</span>
        <i class="fas fa-arrow-right" aria-hidden="true"></i>
      </a>

      <button
        type="button"
        id="mobileMenuBtn"
        class="mobile-toggle-btn"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobileNavMenu"
      >
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <nav class="mobile-drawer-menu" id="mobileNavMenu" aria-label="Mobile Navigation" aria-hidden="true">
    <div class="mobile-drawer-header font-mono">
      <span>MAX GLOVES BD // NAVIGATION</span>
    </div>

    <ul class="mobile-nav-list">
      <li>
        <a href={homeUrl} class={`mobile-nav-item ${isHome ? 'active' : ''}`}>{labels.home}</a>
      </li>
      <li>
        <a href={aboutUrl} class={`mobile-nav-item ${isAbout ? 'active' : ''}`}>{labels.about}</a>
      </li>
      <li>
        <a href={facilitiesUrl} class={`mobile-nav-item ${isFacilities ? 'active' : ''}`}>{labels.facilities}</a>
      </li>
      <li>
        <a href={complianceUrl} class={`mobile-nav-item ${isCompliance ? 'active' : ''}`}>{labels.compliance}</a>
      </li>

      <!-- Products Accordion -->
      <li class="mobile-accordion-group">
        <div class="accordion-trigger-row">
          <a href="/category/20" class="mobile-nav-item">{labels.products}</a>
          <button
            type="button"
            id="mobileProductsExpand"
            class="accordion-expand-btn font-mono"
            aria-label="Toggle products categories"
            aria-expanded="false"
            aria-controls="mobileProductsSubmenu"
          >+</button>
        </div>
        <ul id="mobileProductsSubmenu" class="mobile-submenu">
          {categories.map((c) => (
            <li>
              <a href={c.url} class="mobile-sub-item">
                <i class="fas fa-angle-right text-crimson" aria-hidden="true"></i>
                <span>{c.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </li>

      <li>
        <a href={galleryUrl} class={`mobile-nav-item ${isGallery ? 'active' : ''}`}>{labels.gallery}</a>
      </li>
      <li>
        <a href={contactUrl} class={`mobile-nav-item ${isContact ? 'active' : ''}`}>{labels.contact}</a>
      </li>

      <!-- Language Switcher Accordion -->
      <li class="mobile-accordion-group">
        <div class="accordion-trigger-row">
          <span class="mobile-nav-item">{labels.language}</span>
          <button
            type="button"
            id="mobileLangExpand"
            class="accordion-expand-btn font-mono"
            aria-label="Toggle language menu"
            aria-expanded="false"
            aria-controls="mobileLangSubmenu"
          >+</button>
        </div>
        <ul id="mobileLangSubmenu" class="mobile-submenu">
          <li>
            <a href="/" class="mobile-sub-item">
              <span class="flag-circle font-mono">EN</span>
              <span>English</span>
            </a>
          </li>
          <li>
            <a href="/jp/" class="mobile-sub-item">
              <span class="flag-circle font-mono">JP</span>
              <span>日本語 (Japanese)</span>
            </a>
          </li>
          <li>
            <a href="/kr/" class="mobile-sub-item">
              <span class="flag-circle font-mono">KR</span>
              <span>한국어 (Korean)</span>
            </a>
          </li>
        </ul>
      </li>
    </ul>

    <!-- Bottom Mobile RFQ Action -->
    <div class="mobile-drawer-footer">
      <a href={contactUrl} class="btn-mobile-rfq font-mono">
        <i class="far fa-paper-plane" aria-hidden="true"></i>
        <span>{labels.rfq}</span>
      </a>
      <div class="mobile-drawer-contact font-mono">
        <div>
          <a
            href={BRAND.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            style="color: inherit; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;"
          >
            <i class="fab fa-whatsapp" aria-hidden="true" style="color: #25D366; font-size: 15px;"></i>
            <span>{BRAND.phone}</span>
          </a>
        </div>
        <div>MAIL: {BRAND.email}</div>
      </div>
    </div>
  </nav>
</div>

<style>
  /* Carbon-Steel Industrial Mobile Topbar */
  .mobile-topbar-steel {
    background-color: var(--color-steel, #0B1118);
    border-bottom: 1px solid var(--color-steel-border, #223242);
    padding: 5px 14px;
  }
  .mobile-topbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 11.5px;
  }
  .mobile-topbar-link {
    color: #CBD5E1;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    letter-spacing: 0.02em;
  }
  .text-whatsapp {
    color: #25D366 !important;
  }
  .text-crimson {
    color: var(--color-crimson, #C81E1E) !important;
  }
  .mobile-topbar-sep {
    color: #334155;
    font-size: 11px;
  }

  /* Crisp White Mobile Main Bar (Image 1 Aesthetic) */
  .architectural-mobile-bar {
    background: #FFFFFF;
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    position: sticky;
    top: 0;
    z-index: 1050;
    box-shadow: 0 2px 8px rgba(11, 17, 24, 0.06);
  }
  .mobile-bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 14px;
    background: #FFFFFF;
  }
  .mobile-logo-anchor {
    display: flex;
    align-items: center;
    text-decoration: none;
  }
  .mobile-brand-logo {
    max-height: 42px;
    width: auto;
    object-fit: contain;
    display: block;
  }
  .mobile-bar-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .btn-mobile-rfq-action {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 6px 12px;
    background-color: var(--color-crimson, #C81E1E);
    color: #FFFFFF;
    border: 1px solid var(--color-crimson, #C81E1E);
    border-radius: 4px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 1px 4px rgba(200, 30, 30, 0.25);
    transition: all 0.2s ease;
  }
  .btn-mobile-rfq-action:hover {
    background-color: var(--color-crimson-hover, #A81818);
    color: #FFFFFF;
  }
  .mobile-toggle-btn {
    width: 38px;
    height: 38px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
    background: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }
  .mobile-toggle-btn:hover {
    background: #F1F5F9;
    border-color: #94A3B8;
  }
  .hamburger-bar {
    width: 19px;
    height: 2px;
    background-color: #0B1118;
    border-radius: 2px;
    transition: all 0.25s ease;
  }
  .mobile-toggle-btn.is-active .hamburger-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .mobile-toggle-btn.is-active .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  .mobile-toggle-btn.is-active .hamburger-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Drawer Navigation */
  .mobile-drawer-menu {
    display: none;
    background: #0B1118;
    border-bottom: 2px solid var(--color-crimson, #C81E1E);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
  }
  .mobile-drawer-menu.is-open {
    display: block;
  }
  .mobile-drawer-header {
    padding: 12px 18px 8px;
    font-size: 11px;
    color: #64748B;
    letter-spacing: 0.08em;
    border-bottom: 1px solid #1E293B;
  }

  .mobile-nav-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mobile-nav-item {
    display: block;
    padding: 14px 18px;
    color: #F8FAFC;
    font-family: var(--font-heading, 'Barlow', sans-serif);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-bottom: 1px solid #15202B;
    transition: background 0.15s ease;
  }
  .mobile-nav-item:hover,
  .mobile-nav-item.active {
    background: #15202B;
    color: var(--color-crimson, #C81E1E);
  }

  .accordion-trigger-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #15202B;
  }
  .accordion-trigger-row .mobile-nav-item {
    border-bottom: none;
    flex: 1;
  }
  .accordion-expand-btn {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: none;
    color: #CBD5E1;
    font-size: 20px;
    font-weight: 700;
    cursor: pointer;
  }
  .mobile-submenu {
    display: none;
    list-style: none;
    margin: 0;
    padding: 8px 0;
    background: #15202B;
    border-bottom: 1px solid #223242;
  }
  .mobile-submenu.sub-open {
    display: block;
  }
  .mobile-sub-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 24px;
    color: #94A3B8;
    font-size: 14px;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .mobile-sub-item:hover {
    color: #FFFFFF;
  }
  .flag-circle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 18px;
    background: #223242;
    color: #E2E8F0;
    font-size: 10px;
    border-radius: 2px;
  }

  /* Drawer Footer */
  .mobile-drawer-footer {
    padding: 20px 18px 25px;
    background: #0B1118;
  }
  .btn-mobile-rfq {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    padding: 14px;
    background-color: var(--color-crimson, #C81E1E);
    color: #FFFFFF;
    border-radius: 4px;
    font-size: 13.5px;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.04em;
  }
  .btn-mobile-rfq:hover {
    background-color: var(--color-crimson-hover, #A81818);
    color: #FFFFFF;
  }
  .mobile-drawer-contact {
    margin-top: 14px;
    font-size: 11px;
    color: #64748B;
    line-height: 1.6;
    text-align: center;
  }
</style>
