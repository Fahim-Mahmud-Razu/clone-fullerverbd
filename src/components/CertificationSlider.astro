---
const certifications = [
  {
    code: 'SQP',
    title: 'Supplier Qualification Program',
    desc: 'Audited manufacturing operations and facility workflow compliance.',
    logo: '/front-end/img/SQP-Logo-Web.png',
    status: 'VERIFIED AUDIT'
  },
  {
    code: 'GSV',
    title: 'Global Security Verification',
    desc: 'International supply chain and export transport security compliance.',
    logo: '/front-end/img/gsv-logo-web.png',
    status: 'SECURITY AUDITED'
  },
  {
    code: 'WCA',
    title: 'Workplace Conditions Assessment',
    desc: 'Social accountability, fair labor standards, and safe working conditions.',
    logo: '/front-end/img/WCA.png',
    status: 'WORKPLACE STANDARDS'
  },
  {
    code: 'ISO 9001',
    title: 'Quality Management System',
    desc: 'Continuous manufacturing quality control and leather grading protocol.',
    logo: '/front-end/img/ISO_9001.png',
    status: 'QMS CERTIFIED'
  },
  {
    code: 'ISO 14001',
    title: 'Environmental Management',
    desc: 'Sustainable waste reduction, eco-conscious leather processing controls.',
    logo: '/front-end/img/ISO_14001.png',
    status: 'EMS COMPLIANT'
  },
  {
    code: 'EN 388 / 407',
    title: 'Harmonized PPE Safety Standards',
    desc: 'Abrasion, tear, puncture, and thermal heat resistant glove testing.',
    icon: 'fas fa-shield-alt',
    status: 'PPE TECHNICAL SPECS'
  }
];
---

<section class="trust-grid-section" aria-label="Quality certifications and standards">
  <div class="container">
    <!-- Header Block -->
    <div class="trust-header text-center">
      <div class="trust-kicker font-mono">
        <span class="crimson-dot"></span>
        <span>VERIFIED INDUSTRIAL STANDARDS & ACCREDITATIONS</span>
      </div>
      <h2 class="trust-title">
        Quality Assurance & International Compliance
      </h2>
      <p class="trust-subtitle">
        Every leather glove production batch undergoes strict incoming material grading, dimensional tolerance testing, and pre-shipment safety inspections at our Savar manufacturing plant.
      </p>
    </div>

    <!-- Clean Bordered Trust Grid (4px radii, 1px #E2E8F0 borders, no tacky shadows) -->
    <div class="trust-cards-grid">
      {certifications.map((cert) => (
        <div class="trust-card">
          <div class="trust-card-top">
            <div class="trust-logo-box">
              {cert.logo ? (
                <img src={cert.logo} alt={`${cert.code} accreditation`} loading="lazy" decoding="async" class="cert-img" />
              ) : (
                <i class={`${cert.icon} cert-icon text-crimson`} aria-hidden="true"></i>
              )}
            </div>
            <div class="trust-status-badge font-mono">{cert.status}</div>
          </div>

          <div class="trust-card-body">
            <div class="trust-code font-mono">{cert.code}</div>
            <h3 class="trust-card-heading">{cert.title}</h3>
            <p class="trust-card-desc">{cert.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .trust-grid-section {
    background-color: var(--color-canvas, #F8FAFC);
    border-top: 1px solid var(--color-border, #E2E8F0);
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    padding: 80px 0 90px;
  }

  .trust-header {
    max-width: 760px;
    margin: 0 auto 50px;
  }
  .trust-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #64748B);
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 5px 12px;
    border-radius: 4px;
    margin-bottom: 14px;
  }
  .crimson-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-crimson, #C81E1E);
    display: inline-block;
  }

  .trust-title {
    font-size: clamp(26px, 3.5vw, 38px);
    font-weight: 800;
    color: var(--color-steel, #0B1118);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  .trust-subtitle {
    color: var(--color-text-muted, #64748B);
    font-size: 15.5px;
    line-height: 1.6;
    margin: 0;
  }

  /* Grid Layout: Crisp 1px borders & 4px radii */
  .trust-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
  }

  .trust-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.2s ease;
  }
  .trust-card:hover {
    border-color: var(--color-border-dark, #CBD5E1);
    box-shadow: 0 4px 16px rgba(11, 17, 24, 0.04);
  }

  .trust-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 18px;
  }

  .trust-logo-box {
    width: 70px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }
  .cert-img {
    max-height: 44px;
    max-width: 68px;
    object-fit: contain;
  }
  .cert-icon {
    font-size: 32px;
  }

  .trust-status-badge {
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: #475569;
    background: var(--color-well, #F1F5F9);
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 3px 8px;
    border-radius: 3px;
  }

  .trust-card-body {
    flex: 1;
  }

  .trust-code {
    font-size: 12px;
    font-weight: 700;
    color: var(--color-crimson, #C81E1E);
    margin-bottom: 4px;
  }

  .trust-card-heading {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-steel, #0B1118);
    margin-bottom: 8px;
  }

  .trust-card-desc {
    color: var(--color-text-muted, #64748B);
    font-size: 13.5px;
    line-height: 1.5;
    margin: 0;
  }

  @media (max-width: 575px) {
    .trust-cards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
