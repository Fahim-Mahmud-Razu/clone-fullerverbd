---
const slides = [
  { image: '/front-end/img/slider/max_banner1.png', label: 'Welcome MAX Gloves', alt: 'Welcome to Max Gloves BD Ltd.' },
  { image: '/front-end/img/slider/Driver_gloves26.png', label: 'Driver Gloves', alt: 'Driver Gloves' },
  { image: '/front-end/img/slider/Grain-Gloves.png', label: 'Grain Gloves', alt: 'Grain Gloves' },
  { image: '/front-end/img/slider/max_split_gloves.jpg', label: 'Split Gloves', alt: 'Split Gloves - Max Gloves BD Ltd.' },
  { image: '/front-end/img/slider/Welding-gloves2026_09.jpg', label: 'Welding Articles', alt: 'Welding Articles' },
  { image: '/front-end/img/slider/Palm-Gloves.jpg', label: 'Leather Palm Gloves', alt: 'Leather Palm Gloves' }
];

// Prepend last slide and append first slide for seamless infinite horizontal sliding
const loopSlides = [
  { ...slides[slides.length - 1], isClone: true, origIdx: slides.length - 1 },
  ...slides.map((s, idx) => ({ ...s, isClone: false, origIdx: idx })),
  { ...slides[0], isClone: true, origIdx: 0 }
];
---

<section class="slick-slider-wrap-layout1" id="heroSliderSection">
  <div class="slick-slider-layout1">
    <!-- Main Big Slide Display (Continuous Horizontal Sliding Carousel) -->
    <div class="slick-carousel slick-content hero-viewport" id="heroViewport">
      <div class="hero-track" id="heroTrack">
        {loopSlides.map((slide, trackIdx) => (
          <div
            class="hero-slide slick-slider"
            data-track-index={trackIdx}
            data-orig-index={slide.origIdx}
          >
            <div class="item-img">
              <img
                src={slide.image}
                alt={slide.alt}
                loading={trackIdx <= 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Synchronized Navigation Control Strip -->
    <div class="slick-nav-wrap">
      <div class="container">
        <div class="slick-carousel slick-nav" id="heroNavStrip">
          {slides.map((slide, idx) => (
            <div
              class={`nav-item ${idx === 0 ? 'slick-current' : ''}`}
              data-nav-index={idx}
              role="button"
              tabindex="0"
              style="cursor: pointer;"
            >
              <div class="item-icon">
                <img src="/front-end/img/ggafp.png" alt="service" width="32" height="51" />
              </div>
              <h4 class="item-title">{slide.label}</h4>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #heroSliderSection {
    overflow-anchor: none;
  }

  .hero-viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin: 0;
    padding: 0;
    contain: layout paint;
    overflow-anchor: none;
  }

  .hero-track {
    display: flex;
    flex-direction: row;
    width: 100%;
    will-change: transform;
    transform: translate3d(-100%, 0, 0);
    transition: transform 1000ms ease;
  }

  .hero-slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .hero-slide .item-img {
    width: 100%;
    text-align: center;
    position: relative;
    margin-bottom: -10px;
    background: #05254f;
    min-height: 240px;
  }

  .hero-slide .item-img img {
    width: 100%;
    height: auto;
    max-height: 700px;
    object-fit: cover;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  #heroNavStrip {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    justify-content: space-between !important;
    height: 193px !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    -webkit-overflow-scrolling: touch;
    overflow-anchor: none;
  }

  #heroNavStrip::-webkit-scrollbar {
    display: none !important;
  }

  #heroNavStrip .nav-item {
    flex: 1 1 0 !important;
    max-width: 195px !important;
    height: 193px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background-color 0.25s ease;
    flex-shrink: 0;
  }

  .slick-nav .nav-item.slick-current {
    background-color: var(--brand-orange) !important;
  }

  .slick-nav .nav-item:hover {
    background-color: var(--brand-orange-hover) !important;
  }

  @media only screen and (max-width: 1199px) {
    #heroNavStrip {
      height: 160px !important;
    }
    #heroNavStrip .nav-item {
      height: 160px !important;
      padding: 30px 5px 18px !important;
    }
    #heroNavStrip .nav-item .item-title {
      font-size: 16px !important;
    }
  }

  @media only screen and (max-width: 991px) {
    #heroNavStrip {
      height: 130px !important;
      justify-content: flex-start !important;
    }
    #heroNavStrip .nav-item {
      flex: 0 0 33.333% !important;
      max-width: 33.333% !important;
      min-width: 33.333% !important;
      height: 130px !important;
      padding: 16px 5px 12px !important;
    }
    #heroNavStrip .nav-item .item-icon {
      margin-bottom: 10px !important;
    }
    #heroNavStrip .nav-item .item-icon img {
      height: 38px !important;
      width: auto !important;
    }
    #heroNavStrip .nav-item .item-title {
      font-size: 14px !important;
      line-height: 1.25 !important;
    }
  }

  @media only screen and (max-width: 767px) {
    .hero-slide .item-img {
      margin-bottom: 0 !important;
      min-height: 180px;
    }
    .hero-slide .item-img img {
      max-height: 400px !important;
    }
  }

  @media only screen and (max-width: 575px) {
    #heroNavStrip {
      height: 105px !important;
    }
    #heroNavStrip .nav-item {
      flex: 0 0 50% !important;
      max-width: 50% !important;
      min-width: 50% !important;
      height: 105px !important;
      padding: 12px 6px 10px !important;
    }
    #heroNavStrip .nav-item .item-icon {
      margin-bottom: 6px !important;
    }
    #heroNavStrip .nav-item .item-icon img {
      height: 28px !important;
      width: auto !important;
    }
    #heroNavStrip .nav-item .item-title {
      font-size: 13px !important;
      line-height: 1.2 !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-track {
      transition: none !important;
    }
  }
</style>

<script>
  function initHeroSlider() {
    const track = document.getElementById('heroTrack') as HTMLElement | null;
    const navItems = document.querySelectorAll<HTMLElement>('#heroNavStrip .nav-item');
    const heroSection = document.getElementById('heroSliderSection');
    const navStrip = document.getElementById('heroNavStrip');
    if (!track || !navItems.length) return;

    const TOTAL_REAL_SLIDES = navItems.length; // 6
    let currentTrackIndex = 1;
    let isTransitioning = false;
    let autoplayTimer: number | null = null;
    let isHeroInView = true;
    const AUTOPLAY_DELAY = 3500;
    const TRANSITION_STYLE = 'transform 1000ms ease';
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Set initial position
    track.style.transition = 'none';
    track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
    void track.offsetWidth;

    // ROOT CAUSE FIX: Never call nav.scrollIntoView() which scrolls the whole window viewport!
    // Instead, scroll ONLY the horizontal navStrip container element.
    function updateNav(realIndex: number) {
      navItems.forEach((nav, idx) => {
        if (idx === realIndex) {
          nav.classList.add('slick-current');
          if (navStrip) {
            const navLeft = nav.offsetLeft;
            const navWidth = nav.offsetWidth;
            const stripWidth = navStrip.clientWidth;
            const targetLeft = navLeft - (stripWidth / 2) + (navWidth / 2);
            navStrip.scrollTo({
              left: Math.max(0, targetLeft),
              behavior: prefersReducedMotion ? 'auto' : 'smooth'
            });
          }
        } else {
          nav.classList.remove('slick-current');
        }
      });
    }

    function goToTrackIndex(targetIndex: number) {
      if (!track) return;
      currentTrackIndex = targetIndex;
      isTransitioning = true;

      track.style.transition = prefersReducedMotion ? 'none' : TRANSITION_STYLE;
      track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;

      // Determine active nav index immediately
      let realIndex = 0;
      if (currentTrackIndex === 0) {
        realIndex = TOTAL_REAL_SLIDES - 1;
      } else if (currentTrackIndex === TOTAL_REAL_SLIDES + 1) {
        realIndex = 0;
      } else {
        realIndex = currentTrackIndex - 1;
      }
      updateNav(realIndex);
    }

    function nextSlide() {
      if (isTransitioning) return;
      goToTrackIndex(currentTrackIndex + 1);
    }

    function prevSlide() {
      if (isTransitioning) return;
      goToTrackIndex(currentTrackIndex - 1);
    }

    // Handle seamless infinite looping jump on transition end
    track.addEventListener('transitionend', (e) => {
      if (e.target !== track || e.propertyName !== 'transform') return;
      isTransitioning = false;

      // Past last slide -> jump to slide 1
      if (currentTrackIndex === TOTAL_REAL_SLIDES + 1) {
        track.style.transition = 'none';
        currentTrackIndex = 1;
        track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
        void track.offsetWidth;
      }
      // Before first slide -> jump to last slide
      else if (currentTrackIndex === 0) {
        track.style.transition = 'none';
        currentTrackIndex = TOTAL_REAL_SLIDES;
        track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
        void track.offsetWidth;
      }
    });

    function startAutoplay() {
      stopAutoplay();
      if (prefersReducedMotion || !isHeroInView || document.hidden) return;
      autoplayTimer = window.setInterval(nextSlide, AUTOPLAY_DELAY);
    }

    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // ROOT CAUSE MITIGATION: Pause autoplay whenever the hero section is not visible on screen.
    // When the user scrolls past the hero to "Our Working Process", slider pauses completely.
    if ('IntersectionObserver' in window && heroSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isHeroInView = entry.isIntersecting;
            if (isHeroInView) {
              startAutoplay();
            } else {
              stopAutoplay();
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(heroSection);
    }

    // Pause on background tab or app minimize
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoplay();
      } else if (isHeroInView) {
        startAutoplay();
      }
    });

    // Navigation item click & keyboard accessibility (no window scroll)
    navItems.forEach((item, idx) => {
      item.addEventListener('click', () => {
        goToTrackIndex(idx + 1);
        startAutoplay();
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          goToTrackIndex(idx + 1);
          startAutoplay();
        }
      });
    });

    // Pause on mouse hover (desktop)
    if (heroSection) {
      heroSection.addEventListener('mouseenter', stopAutoplay);
      heroSection.addEventListener('mouseleave', () => {
        if (isHeroInView) startAutoplay();
      });
    }

    // Touch swipe support for mobile (pure horizontal, passive)
    let touchStartX = 0;
    let touchEndX = 0;
    track.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoplay();
      },
      { passive: true }
    );

    track.addEventListener(
      'touchend',
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchEndX - touchStartX;
        if (Math.abs(diffX) > 50) {
          if (diffX < 0) {
            nextSlide();
          } else {
            prevSlide();
          }
        }
        if (isHeroInView) startAutoplay();
      },
      { passive: true }
    );

    startAutoplay();
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }
</script>
