---
const slides = [
  { image: '/front-end/img/slider/Fullever_Banner1.png', label: 'Welcome Fullever', alt: 'Welcome to Fullever BD' },
  { image: '/front-end/img/slider/Driver_gloves26.png', label: 'Driver Gloves', alt: 'Driver Gloves' },
  { image: '/front-end/img/slider/Grain-Gloves.png', label: 'Grain Gloves', alt: 'Grain Gloves' },
  { image: '/front-end/img/slider/FULLEVER_SPLIT_GLOVES_1920x700_150kb.jpg', label: 'Split Gloves', alt: 'Split Gloves' },
  { image: '/front-end/img/slider/Welding-gloves2026_09.jpg', label: 'Welding Articles', alt: 'Welding Articles' },
  { image: '/front-end/img/slider/Palm-Gloves.jpg', label: 'Leather Palm Gloves', alt: 'Leather Palm Gloves' }
];

// Prepend last slide and append first slide for seamless infinite horizontal sliding
const loopSlides = [
  { ...slides[slides.length - 1], isClone: true, origIdx: slides.length - 1 },
  ...slides.map((s, idx) => ({ ...s, isClone: false, origIdx: idx })),
  { ...slides[0], isClone: true, origIdx: 0 }
];
---

<section class="slick-slider-wrap-layout1" id="heroSliderSection">
  <div class="slick-slider-layout1">
    <!-- Main Big Slide Display (Continuous Horizontal Sliding Carousel) -->
    <div class="slick-carousel slick-content hero-viewport" id="heroViewport">
      <div class="hero-track" id="heroTrack">
        {loopSlides.map((slide, trackIdx) => (
          <div
            class="hero-slide slick-slider"
            data-track-index={trackIdx}
            data-orig-index={slide.origIdx}
          >
            <div class="item-img">
              <img
                src={slide.image}
                alt={slide.alt}
                loading={trackIdx <= 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Synchronized Navigation Control Strip -->
    <div class="slick-nav-wrap">
      <div class="container">
        <div class="slick-carousel slick-nav" id="heroNavStrip">
          {slides.map((slide, idx) => (
            <div
              class={`nav-item ${idx === 0 ? 'slick-current' : ''}`}
              data-nav-index={idx}
              role="button"
              tabindex="0"
              style="cursor: pointer;"
            >
              <div class="item-icon">
                <img src="/front-end/img/ggafp.png" alt="service" width="32" height="51" />
              </div>
              <h4 class="item-title">{slide.label}</h4>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-viewport {
    position: relative;
    overflow: hidden;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .hero-track {
    display: flex;
    flex-direction: row;
    width: 100%;
    will-change: transform;
    transform: translate3d(-100%, 0, 0);
    transition: transform 1000ms ease;
  }

  .hero-slide {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  .hero-slide .item-img {
    width: 100%;
    text-align: center;
    position: relative;
    margin-bottom: -10px;
  }

  .hero-slide .item-img img {
    width: 100%;
    height: auto;
    max-height: 700px;
    object-fit: cover;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
  }

  #heroNavStrip {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    justify-content: space-between !important;
    height: 193px !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }

  #heroNavStrip::-webkit-scrollbar {
    display: none !important;
  }

  #heroNavStrip .nav-item {
    flex: 1 1 0 !important;
    max-width: 195px !important;
    height: 193px !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    transition: background-color 0.25s ease;
    scroll-snap-align: start;
    flex-shrink: 0;
  }

  .slick-nav .nav-item.slick-current {
    background-color: #cd0d16 !important;
  }

  .slick-nav .nav-item:hover {
    background-color: #da101a;
  }

  @media only screen and (max-width: 1199px) {
    #heroNavStrip {
      height: 160px !important;
    }
    #heroNavStrip .nav-item {
      height: 160px !important;
      padding: 30px 5px 18px !important;
    }
    #heroNavStrip .nav-item .item-title {
      font-size: 16px !important;
    }
  }

  @media only screen and (max-width: 991px) {
    #heroNavStrip {
      height: 130px !important;
      justify-content: flex-start !important;
    }
    #heroNavStrip .nav-item {
      flex: 0 0 33.333% !important;
      max-width: 33.333% !important;
      min-width: 33.333% !important;
      height: 130px !important;
      padding: 16px 5px 12px !important;
    }
    #heroNavStrip .nav-item .item-icon {
      margin-bottom: 10px !important;
    }
    #heroNavStrip .nav-item .item-icon img {
      height: 38px !important;
      width: auto !important;
    }
    #heroNavStrip .nav-item .item-title {
      font-size: 14px !important;
      line-height: 1.25 !important;
    }
  }

  @media only screen and (max-width: 767px) {
    .hero-slide .item-img {
      margin-bottom: 0 !important;
    }
    .hero-slide .item-img img {
      max-height: 400px !important;
    }
  }

  @media only screen and (max-width: 575px) {
    #heroNavStrip {
      height: 105px !important;
    }
    #heroNavStrip .nav-item {
      flex: 0 0 50% !important;
      max-width: 50% !important;
      min-width: 50% !important;
      height: 105px !important;
      padding: 12px 6px 10px !important;
    }
    #heroNavStrip .nav-item .item-icon {
      margin-bottom: 6px !important;
    }
    #heroNavStrip .nav-item .item-icon img {
      height: 28px !important;
      width: auto !important;
    }
    #heroNavStrip .nav-item .item-title {
      font-size: 13px !important;
      line-height: 1.2 !important;
    }
  }
</style>

<script>
  function initHeroSlider() {
    const track = document.getElementById('heroTrack') as HTMLElement | null;
    const navItems = document.querySelectorAll<HTMLElement>('#heroNavStrip .nav-item');
    const heroSection = document.getElementById('heroSliderSection');
    if (!track || !navItems.length) return;

    const TOTAL_REAL_SLIDES = navItems.length; // 6
    // Track indices: 0 is clone of slide 5, 1..6 are slides 0..5, 7 is clone of slide 0
    let currentTrackIndex = 1;
    let isTransitioning = false;
    let autoplayTimer: number | null = null;
    const AUTOPLAY_DELAY = 3000;
    const TRANSITION_STYLE = 'transform 1000ms ease';

    // Set initial position
    track.style.transition = 'none';
    track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
    void track.offsetWidth;

    function updateNav(realIndex: number) {
      navItems.forEach((nav, idx) => {
        if (idx === realIndex) {
          nav.classList.add('slick-current');
          // Smoothly keep active nav item in view on mobile devices
          nav.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        } else {
          nav.classList.remove('slick-current');
        }
      });
    }

    function goToTrackIndex(targetIndex: number) {
      if (!track) return;
      currentTrackIndex = targetIndex;
      isTransitioning = true;

      track.style.transition = TRANSITION_STYLE;
      track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;

      // Determine active nav index immediately
      let realIndex = 0;
      if (currentTrackIndex === 0) {
        realIndex = TOTAL_REAL_SLIDES - 1;
      } else if (currentTrackIndex === TOTAL_REAL_SLIDES + 1) {
        realIndex = 0;
      } else {
        realIndex = currentTrackIndex - 1;
      }
      updateNav(realIndex);
    }

    function nextSlide() {
      if (isTransitioning) return;
      goToTrackIndex(currentTrackIndex + 1);
    }

    function prevSlide() {
      if (isTransitioning) return;
      goToTrackIndex(currentTrackIndex - 1);
    }

    // Handle seamless infinite looping jump on transition end
    track.addEventListener('transitionend', (e) => {
      if (e.target !== track || e.propertyName !== 'transform') return;
      isTransitioning = false;

      // If we just slid past the last slide onto the clone of slide 0 (index 7)
      if (currentTrackIndex === TOTAL_REAL_SLIDES + 1) {
        track.style.transition = 'none';
        currentTrackIndex = 1;
        track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
        void track.offsetWidth;
      }
      // If we just slid backward past the first slide onto the clone of slide 5 (index 0)
      else if (currentTrackIndex === 0) {
        track.style.transition = 'none';
        currentTrackIndex = TOTAL_REAL_SLIDES;
        track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
        void track.offsetWidth;
      }
    });

    function startAutoplay() {
      stopAutoplay();
      autoplayTimer = window.setInterval(nextSlide, AUTOPLAY_DELAY);
    }

    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Navigation item click
    navItems.forEach((item, idx) => {
      item.addEventListener('click', () => {
        goToTrackIndex(idx + 1);
        startAutoplay();
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          goToTrackIndex(idx + 1);
          startAutoplay();
        }
      });
    });

    // Pause on hover
    if (heroSection) {
      heroSection.addEventListener('mouseenter', stopAutoplay);
      heroSection.addEventListener('mouseleave', startAutoplay);
    }

    // Touch swipe support for mobile
    let touchStartX = 0;
    let touchEndX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoplay();
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diffX = touchEndX - touchStartX;
      if (Math.abs(diffX) > 50) {
        if (diffX < 0) {
          nextSlide();
        } else {
          prevSlide();
        }
      }
      startAutoplay();
    }, { passive: true });

    startAutoplay();
  }

  // Initialize on load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }
</script>
