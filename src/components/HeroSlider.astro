---
const slides = [
  {
    image: '/front-end/img/slider/max_welcome_hero.jpg',
    kicker: 'BANGLADESH DIRECT EXPORTER // SAVAR MANUFACTURING FACILITY',
    title: 'Precision-Engineered Industrial Safety & Leather Gloves',
    desc: 'Direct-from-factory personal protective equipment for international procurement teams. Heavy-duty cowhide, goat grain, split, and heat-resistant welding gloves certified for demanding industrial environments.',
    primaryBtn: { text: 'EXPLORE GLOVE CATALOG', url: '/category/20' },
    secondaryBtn: { text: 'REQUEST FACTORY RFQ', url: '/contact' },
    label: 'Welcome Max Gloves',
    num: '01'
  },
  {
    image: '/front-end/img/slider/max_split_gloves.jpg',
    kicker: 'HEAVY INDUSTRIAL ABRASION PROTECTION // EN 388 STANDARDS',
    title: 'Reinforced Leather Split Work Gloves',
    desc: 'Engineered from premium shoulder split leather with reinforced cotton drill backs and safety rubberized cuffs for heavy metalworking, foundries, construction, and rigging.',
    primaryBtn: { text: 'VIEW SPLIT GLOVES', url: '/category/19' },
    secondaryBtn: { text: 'INQUIRE SPECIFICATIONS', url: '/contact' },
    label: 'Leather Split Gloves',
    num: '02'
  },
  {
    image: '/front-end/img/slider/max_welding_gloves.jpg',
    kicker: 'EXTREME HEAT & SPATTER RESISTANCE // EN 407 CERTIFICATION',
    title: 'Kevlar-Stitched Leather Welding Gloves',
    desc: 'One-piece back construction crafted from specialized heat-treated cow split leather with soft fleece lining and reinforced thumb crotches for MIG, TIG, and arc welding applications.',
    primaryBtn: { text: 'VIEW WELDING GLOVES', url: '/category/20' },
    secondaryBtn: { text: 'INQUIRE SPECIFICATIONS', url: '/contact' },
    label: 'Leather Welding Gloves',
    num: '03'
  },
  {
    image: '/front-end/img/slider/max_leather_palm_gloves.jpg',
    kicker: 'DURABLE PALM GRIP & ERGONOMIC AGILITY',
    title: 'Heavy Duty Leather Palm Gloves',
    desc: 'High-friction leather palm reinforcement combined with breathable cotton striped backs and knuckle straps. Ideal for general assembly, warehousing, logistics, and material handling.',
    primaryBtn: { text: 'VIEW PALM GLOVES', url: '/category/21' },
    secondaryBtn: { text: 'INQUIRE SPECIFICATIONS', url: '/contact' },
    label: 'Leather Palm Gloves',
    num: '04'
  }
];

// Prepend last slide and append first slide for seamless infinite horizontal sliding
const loopSlides = [
  { ...slides[slides.length - 1], isClone: true, origIdx: slides.length - 1 },
  ...slides.map((s, idx) => ({ ...s, isClone: false, origIdx: idx })),
  { ...slides[0], isClone: true, origIdx: 0 }
];
---

<section class="architectural-hero-section" id="heroSliderSection" aria-label="Featured industrial glove products">
  <!-- Main Viewport Carousel -->
  <div class="hero-viewport" id="heroViewport">
    <div class="hero-track" id="heroTrack">
      {loopSlides.map((slide, trackIdx) => (
        <div
          class="hero-slide-pane"
          data-track-index={trackIdx}
          data-orig-index={slide.origIdx}
          aria-hidden={trackIdx !== 1 ? 'true' : 'false'}
        >
          <!-- Background Image with High-Contrast Dark Scrim -->
          <div class="hero-image-backdrop">
            <img
              src={slide.image}
              alt=""
              loading={trackIdx <= 2 ? 'eager' : 'lazy'}
              decoding="async"
              class="hero-img-element"
            />
            <div class="hero-scrim-overlay"></div>
          </div>

          <!-- Architectural Content Container -->
          <div class="container hero-content-container">
            <div class="row">
              <div class="col-xl-8 col-lg-9 col-12">
                <div class="hero-text-card">
                  <div class="hero-kicker font-mono">
                    <span class="crimson-tick"></span>
                    <span>{slide.kicker}</span>
                  </div>

                  <h1 class="hero-headline">
                    {slide.title}
                  </h1>

                  <p class="hero-description">
                    {slide.desc}
                  </p>

                  <div class="hero-cta-cluster">
                    <a href={slide.primaryBtn.url} class="btn-crimson">
                      <span>{slide.primaryBtn.text}</span>
                      <i class="fas fa-arrow-right" aria-hidden="true"></i>
                    </a>
                    <a href={slide.secondaryBtn.url} class="btn-steel-glass font-mono">
                      <span>{slide.secondaryBtn.text}</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Synchronized Tabular Navigation Strip (Anchored directly over #0B1118) -->
  <div class="hero-nav-strip-wrap">
    <div class="container">
      <div class="hero-nav-strip" id="heroNavStrip" role="tablist" aria-label="Hero carousel slide navigation">
        {slides.map((slide, idx) => (
          <button
            type="button"
            class={`hero-nav-tab ${idx === 0 ? 'is-active' : ''}`}
            data-nav-index={idx}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            id={`hero-tab-${idx}`}
            aria-label={`Slide ${idx + 1}: ${slide.label}`}
          >
            <div class="nav-tab-header font-mono">
              <span class="tab-index">{slide.num}</span>
              <span class="tab-divider">//</span>
              <span class="tab-category">INDUSTRIAL PPE</span>
            </div>
            <div class="nav-tab-title">{slide.label}</div>
            <div class="nav-active-bar" aria-hidden="true"></div>
          </button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .architectural-hero-section {
    position: relative;
    background-color: var(--color-steel, #0B1118);
    overflow: hidden;
    contain: layout paint;
    overflow-anchor: none;
  }

  .hero-viewport {
    position: relative;
    width: 100%;
    height: clamp(520px, 68vh, 680px);
    overflow: hidden;
  }

  .hero-track {
    display: flex;
    height: 100%;
    width: 100%;
    will-change: transform;
  }

  .hero-slide-pane {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
  }

  .hero-image-backdrop {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
  }

  .hero-img-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    filter: brightness(0.95);
  }

  /* High-Contrast Industrial Scrim */
  .hero-scrim-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(11, 17, 24, 0.94) 0%,
      rgba(11, 17, 24, 0.82) 45%,
      rgba(11, 17, 24, 0.45) 80%,
      rgba(11, 17, 24, 0.25) 100%
    );
  }

  .hero-content-container {
    position: relative;
    z-index: 2;
    padding-top: 20px;
    padding-bottom: 70px;
  }

  .hero-text-card {
    max-width: 720px;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: #94A3B8;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid #223242;
    padding: 5px 12px;
    border-radius: 4px;
    margin-bottom: 18px;
  }

  .crimson-tick {
    width: 6px;
    height: 6px;
    background: var(--color-crimson, #C81E1E);
    border-radius: 1px;
    display: inline-block;
  }

  .hero-headline {
    color: #FFFFFF !important;
    font-size: clamp(32px, 4.5vw, 56px) !important;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin-bottom: 18px;
  }

  .hero-description {
    color: #CBD5E1;
    font-size: clamp(15px, 1.8vw, 17.5px);
    line-height: 1.6;
    max-width: 640px;
    margin-bottom: 28px;
  }

  .hero-cta-cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .btn-steel-glass {
    background: rgba(30, 41, 59, 0.6);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(226, 232, 240, 0.25);
    color: #FFFFFF !important;
    padding: 12px 22px;
    border-radius: 4px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .btn-steel-glass:hover {
    background: rgba(30, 41, 59, 0.95);
    border-color: #FFFFFF;
    color: #FFFFFF !important;
  }

  /* Synchronized Tabular Navigation Strip */
  .hero-nav-strip-wrap {
    position: relative;
    z-index: 10;
    background-color: #0B1118;
    border-top: 1px solid #223242;
    border-bottom: 1px solid #223242;
  }

  .hero-nav-strip {
    display: flex;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    margin: 0;
    padding: 0;
  }
  .hero-nav-strip::-webkit-scrollbar {
    display: none;
  }

  .hero-nav-tab {
    flex: 1 0 240px;
    min-width: 200px;
    background: transparent;
    border: none;
    border-right: 1px solid #1E293B;
    padding: 16px 20px 18px;
    text-align: left;
    cursor: pointer;
    position: relative;
    transition: background 0.2s ease;
  }
  .hero-nav-tab:last-child {
    border-right: none;
  }
  .hero-nav-tab:hover {
    background: #15202B;
  }
  .hero-nav-tab.is-active {
    background: #15202B;
  }

  .nav-tab-header {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: #64748B;
    margin-bottom: 4px;
  }
  .hero-nav-tab.is-active .tab-index {
    color: var(--color-crimson, #C81E1E);
    font-weight: 700;
  }
  .tab-category {
    letter-spacing: 0.05em;
  }

  .nav-tab-title {
    font-family: var(--font-heading, 'Barlow', sans-serif);
    font-size: 14.5px;
    font-weight: 700;
    color: #94A3B8;
    transition: color 0.2s ease;
  }
  .hero-nav-tab.is-active .nav-tab-title {
    color: #FFFFFF;
  }

  .nav-active-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: transparent;
    transition: background-color 0.2s ease;
  }
  .hero-nav-tab.is-active .nav-active-bar {
    background-color: var(--color-crimson, #C81E1E);
  }

  @media (max-width: 767px) {
    .hero-viewport {
      height: 540px;
    }
    .hero-content-container {
      padding-top: 10px;
      padding-bottom: 40px;
    }
    .hero-nav-tab {
      flex: 0 0 75%;
      min-width: 75%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-track {
      transition: none !important;
    }
  }
</style>

<script>
  function initArchitecturalHero() {
    const track = document.getElementById('heroTrack') as HTMLElement | null;
    const navTabs = document.querySelectorAll<HTMLButtonElement>('#heroNavStrip .hero-nav-tab');
    const heroSection = document.getElementById('heroSliderSection');
    const navStrip = document.getElementById('heroNavStrip');
    if (!track || !navTabs.length) return;

    const TOTAL_REAL_SLIDES = navTabs.length;
    let currentTrackIndex = 1;
    let isTransitioning = false;
    let autoplayTimer: number | null = null;
    let isHeroInView = true;
    const AUTOPLAY_DELAY = 4200;
    const TRANSITION_STYLE = 'transform 800ms cubic-bezier(0.16, 1, 0.3, 1)';
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Set initial position
    track.style.transition = 'none';
    track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
    void track.offsetWidth;

    // Container-level scroll (never whole window)
    function updateNav(realIndex: number) {
      navTabs.forEach((tab, idx) => {
        const isMatch = idx === realIndex;
        tab.classList.toggle('is-active', isMatch);
        tab.setAttribute('aria-selected', String(isMatch));

        if (isMatch && navStrip) {
          const tabLeft = tab.offsetLeft;
          const tabWidth = tab.offsetWidth;
          const stripWidth = navStrip.clientWidth;
          const targetLeft = tabLeft - (stripWidth / 2) + (tabWidth / 2);
          navStrip.scrollTo({
            left: Math.max(0, targetLeft),
            behavior: prefersReducedMotion ? 'auto' : 'smooth'
          });
        }
      });
    }

    function goToTrackIndex(targetIndex: number) {
      if (!track) return;
      currentTrackIndex = targetIndex;
      isTransitioning = true;

      track.style.transition = prefersReducedMotion ? 'none' : TRANSITION_STYLE;
      track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;

      let realIndex = 0;
      if (currentTrackIndex === 0) {
        realIndex = TOTAL_REAL_SLIDES - 1;
      } else if (currentTrackIndex === TOTAL_REAL_SLIDES + 1) {
        realIndex = 0;
      } else {
        realIndex = currentTrackIndex - 1;
      }
      updateNav(realIndex);
    }

    function nextSlide() {
      if (isTransitioning) return;
      goToTrackIndex(currentTrackIndex + 1);
    }

    function prevSlide() {
      if (isTransitioning) return;
      goToTrackIndex(currentTrackIndex - 1);
    }

    track.addEventListener('transitionend', (e) => {
      if (e.target !== track || e.propertyName !== 'transform') return;
      isTransitioning = false;

      // Wrap around seamless loop
      if (currentTrackIndex === TOTAL_REAL_SLIDES + 1) {
        track.style.transition = 'none';
        currentTrackIndex = 1;
        track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
        void track.offsetWidth;
      } else if (currentTrackIndex === 0) {
        track.style.transition = 'none';
        currentTrackIndex = TOTAL_REAL_SLIDES;
        track.style.transform = `translate3d(-${currentTrackIndex * 100}%, 0, 0)`;
        void track.offsetWidth;
      }
    });

    function startAutoplay() {
      stopAutoplay();
      if (prefersReducedMotion || !isHeroInView || document.hidden) return;
      autoplayTimer = window.setInterval(nextSlide, AUTOPLAY_DELAY);
    }

    function stopAutoplay() {
      if (autoplayTimer !== null) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    }

    // Pause autoplay when hero is scrolled out of viewport
    if ('IntersectionObserver' in window && heroSection) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isHeroInView = entry.isIntersecting;
            if (isHeroInView) {
              startAutoplay();
            } else {
              stopAutoplay();
            }
          });
        },
        { threshold: 0.05 }
      );
      observer.observe(heroSection);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopAutoplay();
      } else if (isHeroInView) {
        startAutoplay();
      }
    });

    navTabs.forEach((tab, idx) => {
      tab.addEventListener('click', () => {
        goToTrackIndex(idx + 1);
        startAutoplay();
      });
      tab.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          goToTrackIndex(idx + 1);
          startAutoplay();
        }
      });
    });

    if (heroSection) {
      heroSection.addEventListener('mouseenter', stopAutoplay);
      heroSection.addEventListener('mouseleave', () => {
        if (isHeroInView) startAutoplay();
      });
    }

    // Touch swipe support (passive)
    let touchStartX = 0;
    let touchEndX = 0;
    track.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
      stopAutoplay();
    }, { passive: true });

    track.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      const diffX = touchEndX - touchStartX;
      if (Math.abs(diffX) > 40) {
        if (diffX < 0) nextSlide();
        else prevSlide();
      }
      if (isHeroInView) startAutoplay();
    }, { passive: true });

    startAutoplay();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initArchitecturalHero);
  } else {
    initArchitecturalHero();
  }
</script>
