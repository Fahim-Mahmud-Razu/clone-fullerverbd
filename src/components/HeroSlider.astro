---
const slides = [
  {
    image: '/front-end/img/slider/max_banner1.png',
    label: 'Welcome Max Gloves',
    alt: 'Welcome to Max Gloves BD Ltd. — Industrial Safety Gloves Manufacturer & Exporter',
    url: '/category/20'
  },
  {
    image: '/front-end/img/slider/Driver_gloves26.png',
    label: 'Driver Gloves',
    alt: 'Driver Gloves — Top Products, Premium Quality Leather & Maximum Comfort',
    url: '/category/17'
  },
  {
    image: '/front-end/img/slider/Grain-Gloves.jpg',
    label: 'Grain Gloves',
    alt: 'Grain Gloves — High-Grade Cowhide & Goatskin Ergonomic Protection',
    url: '/category/18'
  },
  {
    image: '/front-end/img/slider/Split-Gloves.jpg',
    label: 'Split Gloves',
    alt: 'Split Gloves — Heavy Duty Abrasion & Puncture Resistance',
    url: '/category/19'
  },
  {
    image: '/front-end/img/slider/Welding-gloves.jpg',
    label: 'Welding Articles',
    alt: 'Welding Articles — Heat & Spatter Resistant Kevlar Stitched Gloves',
    url: '/category/20'
  },
  {
    image: '/front-end/img/slider/Leather-Palm-Gloves.jpg',
    label: 'Leather Palm Gloves',
    alt: 'Leather Palm Gloves — Heavy Industrial Grip & Agility',
    url: '/category/21'
  }
];
---

<section class="slick-slider-wrap-layout1" id="heroSliderSection" aria-label="Featured Product Showcase">
  <div class="slick-slider-layout1">
    <!-- Main Big Graphic Slide Display (1920x700 Banner Showcase) -->
    <div class="slick-carousel slick-content" id="heroContentTrack">
      {slides.map((slide, idx) => (
        <div
          class={`hero-slide ${idx === 0 ? 'is-active' : ''}`}
          data-slide-index={idx}
          role="group"
          aria-roledescription="slide"
          aria-label={`${slide.label} (${idx + 1} of ${slides.length})`}
        >
          <a href={slide.url} class="hero-slide-link" aria-label={`Explore ${slide.label}`}>
            <div class="item-img">
              <img
                src={slide.image}
                alt={slide.alt}
                width="1920"
                height="700"
                loading={idx === 0 ? 'eager' : 'lazy'}
                decoding="async"
                class="hero-banner-img"
              />
            </div>
          </a>
        </div>
      ))}

      <!-- Slider Arrows (< and > Navigation Overlays) -->
      <button
        type="button"
        class="hero-arrow-btn hero-arrow-prev"
        id="heroPrevBtn"
        aria-label="Previous slide"
      >
        <i class="fas fa-chevron-left" aria-hidden="true"></i>
      </button>
      <button
        type="button"
        class="hero-arrow-btn hero-arrow-next"
        id="heroNextBtn"
        aria-label="Next slide"
      >
        <i class="fas fa-chevron-right" aria-hidden="true"></i>
      </button>

      <!-- Bottom Animated Progress Line (Fuller Ver BD Signature Accent) -->
      <div class="hero-progress-bar" aria-hidden="true">
        <div class="hero-progress-fill" id="heroProgressFill"></div>
      </div>
    </div>

    <!-- Synchronized Navigation Control Strip (Fuller Ver BD Signature 6-Category Bar) -->
    <div class="slick-nav-wrap">
      <div class="container-fluid px-0 px-lg-3">
        <div class="slick-carousel slick-nav" id="heroNavStrip" role="tablist" aria-label="Category slides">
          {slides.map((slide, idx) => (
            <div
              class={`nav-item ${idx === 0 ? 'slick-current' : ''}`}
              data-nav-index={idx}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
              tabindex="0"
            >
              <!-- Signature Glove Icon -->
              <div class="item-icon" aria-hidden="true">
                <img
                  src="/front-end/img/ggafp.png"
                  alt=""
                  width="28"
                  height="45"
                  class="nav-glove-icon"
                />
              </div>
              <h4 class="item-title font-heading">{slide.label}</h4>
              <div class="nav-active-notch" aria-hidden="true"></div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* --------------------------------------------------------------------------
     Slider Container & Viewport
     -------------------------------------------------------------------------- */
  .slick-slider-wrap-layout1 {
    width: 100%;
    position: relative;
    background-color: var(--color-steel, #0B1118);
    overflow: hidden;
  }

  .slick-content {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / 700;
    max-height: 700px;
    overflow: hidden;
    background-color: #070B10;
  }

  /* Slide Panes */
  .hero-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.65s ease;
    pointer-events: none;
    z-index: 1;
  }

  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    z-index: 2;
  }

  .hero-slide-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  .item-img {
    width: 100%;
    height: 100%;
    text-align: center;
    background-color: #070B10;
  }

  .hero-banner-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /* --------------------------------------------------------------------------
     Navigation Arrows (< and > Buttons on Banner)
     -------------------------------------------------------------------------- */
  .hero-arrow-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 48px;
    height: 48px;
    border-radius: 4px;
    background: rgba(11, 17, 24, 0.65);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    cursor: pointer;
    z-index: 10;
    transition: all 0.2s ease;
  }

  .hero-arrow-btn:hover {
    background: var(--color-crimson, #C81E1E);
    border-color: var(--color-crimson, #C81E1E);
    color: #FFFFFF;
    transform: translateY(-50%) scale(1.06);
  }

  .hero-arrow-prev {
    left: 20px;
  }
  .hero-arrow-next {
    right: 20px;
  }

  @media (max-width: 768px) {
    .hero-arrow-btn {
      width: 38px;
      height: 38px;
      font-size: 13px;
    }
    .hero-arrow-prev { left: 10px; }
    .hero-arrow-next { right: 10px; }
  }

  /* --------------------------------------------------------------------------
     Bottom Progress Bar
     -------------------------------------------------------------------------- */
  .hero-progress-bar {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: rgba(255, 255, 255, 0.15);
    z-index: 10;
  }
  .hero-progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-crimson, #C81E1E);
    box-shadow: 0 0 8px rgba(200, 30, 30, 0.6);
  }

  /* --------------------------------------------------------------------------
     Synchronized 6-Category Navigation Strip (Fuller Ver BD Hallmark)
     -------------------------------------------------------------------------- */
  .slick-nav-wrap {
    background-color: var(--color-steel, #0B1118);
    border-top: 1px solid #1E293B;
    border-bottom: 2px solid var(--color-crimson, #C81E1E);
    position: relative;
    z-index: 5;
  }

  .slick-nav {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    justify-content: space-between;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .slick-nav::-webkit-scrollbar {
    display: none;
  }

  .nav-item {
    flex: 1 1 0;
    min-width: 140px;
    padding: 30px 10px 20px;
    text-align: center;
    cursor: pointer;
    background-color: #DA101A;
    border-right: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: background-color 0.25s ease;
    user-select: none;
  }

  .nav-item:last-child {
    border-right: none;
  }

  .nav-item:hover {
    background-color: #C81E1E;
  }

  .nav-item:focus-visible {
    outline: 2px solid #FFFFFF;
    outline-offset: -2px;
  }

  /* Active Nav Item */
  .nav-item.slick-current {
    background-color: #B91C1C !important;
    border-right-color: rgba(255, 255, 255, 0.25);
  }

  .nav-item .item-icon {
    margin-bottom: 12px;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .nav-glove-icon {
    width: 26px;
    height: 42px;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.4));
  }

  .nav-item .item-title {
    color: #FFFFFF;
    font-size: 14.5px;
    font-weight: 700;
    margin: 0;
    letter-spacing: -0.01em;
    line-height: 1.25;
    transition: color 0.2s ease;
  }

  /* Triangle Notch Indicator on Active Nav */
  .nav-active-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 7px solid transparent;
    border-right: 7px solid transparent;
    border-top: 7px solid #FFFFFF;
    display: none;
  }
  .nav-item.slick-current .nav-active-notch {
    display: block;
  }

  /* --------------------------------------------------------------------------
     Responsive Breakpoints: Flawless Mobile & Desktop Parity (Image 1 Parity)
     -------------------------------------------------------------------------- */
  @media (max-width: 991px) {
    .slick-content {
      aspect-ratio: 1920 / 700 !important;
      height: auto !important;
      min-height: unset !important;
    }
    .slick-slider-layout1 .slick-nav-wrap .slick-nav .nav-item,
    .nav-item {
      padding: 16px 8px 12px !important;
      min-width: 110px !important;
    }
    .slick-slider-layout1 .slick-nav-wrap .slick-nav .nav-item .item-icon,
    .nav-item .item-icon {
      margin-bottom: 6px !important;
    }
    .nav-glove-icon {
      width: 20px !important;
      height: 32px !important;
    }
    .slick-slider-layout1 .slick-nav-wrap .slick-nav .nav-item .item-title,
    .nav-item .item-title {
      font-size: 12.5px !important;
    }
    .hero-arrow-btn {
      width: 36px !important;
      height: 36px !important;
      font-size: 13px !important;
    }
  }

  @media (max-width: 640px) {
    .slick-content {
      aspect-ratio: 1920 / 700 !important;
      height: auto !important;
      min-height: unset !important;
    }
    .hero-arrow-btn {
      width: 26px !important;
      height: 26px !important;
      font-size: 11px !important;
      background: rgba(11, 17, 24, 0.55) !important;
      border-radius: 3px !important;
    }
    .hero-arrow-prev { left: 4px !important; }
    .hero-arrow-next { right: 4px !important; }

    .slick-slider-layout1 .slick-nav-wrap .slick-nav .nav-item,
    .nav-item {
      padding: 10px 6px 8px !important;
      min-width: 90px !important;
    }
    .slick-slider-layout1 .slick-nav-wrap .slick-nav .nav-item .item-icon,
    .nav-item .item-icon {
      margin-bottom: 3px !important;
    }
    .nav-glove-icon {
      width: 14px !important;
      height: 22px !important;
    }
    .slick-slider-layout1 .slick-nav-wrap .slick-nav .nav-item .item-title,
    .nav-item .item-title {
      font-size: 10px !important;
      line-height: 1.15 !important;
      font-weight: 600 !important;
    }
    .nav-active-notch {
      border-left-width: 5px !important;
      border-right-width: 5px !important;
      border-top-width: 5px !important;
    }
  }
</style>

<script>
  function initHeroSlider() {
    const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
    const navItems = document.querySelectorAll<HTMLElement>('.slick-nav .nav-item');
    const prevBtn = document.getElementById('heroPrevBtn');
    const nextBtn = document.getElementById('heroNextBtn');
    const progressFill = document.getElementById('heroProgressFill');
    const heroSection = document.getElementById('heroSliderSection');

    if (!slides.length || !navItems.length) return;

    let currentIndex = 0;
    let timer: number | null = null;
    const AUTOPLAY_DELAY = 4500;

    function goToSlide(index: number) {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        if (i === currentIndex) {
          slide.classList.add('is-active');
          slide.setAttribute('aria-hidden', 'false');
        } else {
          slide.classList.remove('is-active');
          slide.setAttribute('aria-hidden', 'true');
        }
      });

      navItems.forEach((nav, i) => {
        if (i === currentIndex) {
          nav.classList.add('slick-current');
          nav.setAttribute('aria-selected', 'true');
          // Scroll active nav item horizontally within the strip container only (never scrolls the window)
          const navStrip = document.getElementById('heroNavStrip');
          if (navStrip && navStrip.scrollWidth > navStrip.clientWidth) {
            const navLeft = nav.offsetLeft;
            const navWidth = nav.offsetWidth;
            const stripWidth = navStrip.clientWidth;
            navStrip.scrollTo({
              left: navLeft - (stripWidth / 2) + (navWidth / 2),
              behavior: 'smooth'
            });
          }
        } else {
          nav.classList.remove('slick-current');
          nav.setAttribute('aria-selected', 'false');
        }
      });

      resetProgress();
    }

    function resetProgress() {
      if (progressFill) {
        progressFill.style.transition = 'none';
        progressFill.style.width = '0%';
        // Force reflow
        void progressFill.offsetWidth;
        progressFill.style.transition = `width ${AUTOPLAY_DELAY}ms linear`;
        progressFill.style.width = '100%';
      }
    }

    function startAutoplay() {
      stopAutoplay();
      resetProgress();
      timer = window.setInterval(() => {
        goToSlide(currentIndex + 1);
      }, AUTOPLAY_DELAY);
    }

    function stopAutoplay() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
      if (progressFill) {
        progressFill.style.transition = 'none';
      }
    }

    // Nav Item Click & Keydown
    navItems.forEach((item, idx) => {
      item.addEventListener('click', () => {
        goToSlide(idx);
        startAutoplay();
      });
      item.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          goToSlide(idx);
          startAutoplay();
        }
      });
    });

    // Arrow Buttons
    prevBtn?.addEventListener('click', () => {
      goToSlide(currentIndex - 1);
      startAutoplay();
    });
    nextBtn?.addEventListener('click', () => {
      goToSlide(currentIndex + 1);
      startAutoplay();
    });

    // Mouse Enter / Leave Pause
    if (heroSection) {
      heroSection.addEventListener('mouseenter', stopAutoplay);
      heroSection.addEventListener('mouseleave', startAutoplay);
    }

    // Touch Swipe Gesture
    let touchStartX = 0;
    let touchEndX = 0;

    heroSection?.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoplay();
      },
      { passive: true }
    );

    heroSection?.addEventListener(
      'touchend',
      (e) => {
        touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 50) {
          if (diff > 0) {
            goToSlide(currentIndex + 1);
          } else {
            goToSlide(currentIndex - 1);
          }
        }
        startAutoplay();
      },
      { passive: true }
    );

    // Pause autoplay when hero slider is scrolled out of viewport
    if (heroSection && 'IntersectionObserver' in window) {
      const heroObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              startAutoplay();
            } else {
              stopAutoplay();
            }
          });
        },
        { threshold: 0.15 }
      );
      heroObserver.observe(heroSection);
    }

    // Initial Start
    goToSlide(0);
    startAutoplay();
  }

  // Initialize on load & Astro View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeroSlider);
  } else {
    initHeroSlider();
  }
  document.addEventListener('astro:page-load', initHeroSlider);
</script>
