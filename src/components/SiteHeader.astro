---
import BRAND from '../config/site';

interface Props {
  currentPath?: string;
  locale?: 'en' | 'jp' | 'kr';
}

const { currentPath = '/', locale = 'en' } = Astro.props;

// Determine active paths
const isHome = currentPath === '/' || currentPath === '/jp/' || currentPath === '/kr/';
const isAbout = currentPath.includes('/about');
const isFacilities = currentPath.includes('/facilities');
const isCompliance = currentPath.includes('/compliance');
const isProduct = currentPath.includes('/category') || currentPath.includes('/product');
const isGallery = currentPath.includes('/gallery');
const isContact = currentPath.includes('/contact');

const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
const aboutUrl = locale === 'en' ? '/about' : `/${locale}/about`;
const facilitiesUrl = locale === 'en' ? '/facilities' : `/${locale}/facilities`;
const complianceUrl = locale === 'en' ? '/compliance' : `/${locale}/compliance`;
const galleryUrl = locale === 'en' ? '/gallery' : `/${locale}/gallery`;
const contactUrl = locale === 'en' ? '/contact' : `/${locale}/contact`;

const labels = {
  en: {
    home: 'HOME',
    about: 'ABOUT US',
    facilities: 'OUR FACILITIES',
    compliance: 'COMPLIANCE',
    products: 'OUR PRODUCT',
    gallery: 'GALLERY',
    contact: 'CONTACT US',
    language: 'LANGUAGE',
    welcome: `Welcome to ${BRAND.companyName}`
  },
  jp: {
    home: 'ホームページ',
    about: '私たちについて',
    facilities: '私たちの施設',
    compliance: 'コンプライアンス',
    products: '私たちの商品',
    gallery: 'ギャラリー',
    contact: 'お問い合わせ',
    language: '言語',
    welcome: `${BRAND.companyName} へようこそ`
  },
  kr: {
    home: '홈 페이지',
    about: '회사 소개',
    facilities: '우리 시설',
    compliance: '규정 준수',
    products: '우리의 제품',
    gallery: '갤러리',
    contact: '문의하기',
    language: '언어',
    welcome: `${BRAND.companyName}에 오신 것을 환영합니다`
  }
}[locale];
---

<header class="header">
  <div id="header-topbar" class="bg-accent pd-x-85">
    <div class="container-fluid">
      <div class="row align-items-center">
        <div class="col-lg-6">
          <div class="header-topbar-layout1">
            <ul class="header-top-left" style="display: flex; align-items: center; list-style: none; margin: 0; padding: 0;">
              <li style="margin-right: 25px; display: inline-flex; align-items: center; gap: 8px;">
                <i style="color: white;" class="far fa-envelope"></i>
                <a style="color: white; text-decoration: none; font-size: 14px;" href={BRAND.emailMailto}>{BRAND.email}</a>
              </li>
              <li style="flex: 1; margin-right: 0;">
                <marquee width="100%" direction="left" style="color: white; font-size: 14px; line-height: 1;">
                  {labels.welcome}
                </marquee>
              </li>
            </ul>
          </div>
        </div>
        <div class="col-lg-6 d-flex justify-content-end align-items-center">
          <div class="header-topbar-layout1">
            <ul class="header-top-right" style="list-style: none; margin: 0; padding: 0; display: flex; align-items: center;">
              <li class="social-icon">
                <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer"><i class="fab fa-facebook-f"></i></a>
                <a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer"><i class="fab fa-linkedin-in"></i></a>
                <a href="https://www.instagram.com" target="_blank" rel="noopener noreferrer"><i class="fab fa-instagram"></i></a>
                <a href="https://twitter.com" target="_blank" rel="noopener noreferrer"><i class="fab fa-twitter"></i></a>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="rt-sticky-placeholder"></div>

  <div id="header-menu" class="header-menu menu-layout1 pd-x-85" style="position: relative;">
    <div class="container-fluid">
      <div class="row d-flex align-items-center">
        <div class="col-xl-2 col-lg-2">
          <div class="logo-area" style="padding: 10px 0;">
            <a href={homeUrl} class="temp-logo" style="display: inline-block;">
              <img
                src={BRAND.logo.horizontal}
                alt={BRAND.logo.alt}
                class="img-fluid"
                width="240"
                height="68"
                style="max-height: 56px; width: auto; object-fit: contain; display: block;"
              />
            </a>
          </div>
        </div>
        <div class="col-xl-10 col-lg-10 d-flex justify-content-end possition-static">
          <nav id="dropdown" class="template-main-menu">
            <ul>
              <li>
                <a class={isHome ? 'active-m' : ''} href={homeUrl}>{labels.home}</a>
              </li>
              <li>
                <a class={isAbout ? 'active-m' : ''} href={aboutUrl}>{labels.about}</a>
              </li>
              <li>
                <a class={isFacilities ? 'active-m' : ''} href={facilitiesUrl}>{labels.facilities}</a>
              </li>
              <li>
                <a class={isCompliance ? 'active-m' : ''} href={complianceUrl}>{labels.compliance}</a>
              </li>
              <li>
                <a class={isProduct ? 'active-m' : ''} href="#">{labels.products} <i class="fa fa-caret-down" aria-hidden="true"></i></a>
                <ul class="dropdown-menu-col-1">
                  <li><a href="/category/23">Leather Winter Gloves</a></li>
                  <li><a href="/category/17">Leather Driver Gloves</a></li>
                  <li><a href="/category/18">Leather Grain Gloves</a></li>
                  <li><a href="/category/19">Leather Split Gloves</a></li>
                  <li><a href="/category/20">Leather Welding Gloves</a></li>
                  <li><a href="/category/21">Leather Palm Gloves</a></li>
                  <li><a href="/category/24">Leather Welding Jackets</a></li>
                  <li><a href="/category/25">Leather Welding Trousers</a></li>
                  <li><a href="/category/27">Synthetic Leather Gloves</a></li>
                  <li><a href="/category/29">Mechanics Gloves</a></li>
                  <li><a href="/category/30">Impact Gloves</a></li>
                  <li><a href="/category/31">Cotton Gloves</a></li>
                  <li><a href="/category/32">Gardening Gloves</a></li>
                </ul>
              </li>
              <li>
                <a class={isGallery ? 'active-m' : ''} href={galleryUrl}>{labels.gallery}</a>
              </li>
              <li>
                <a class={isContact ? 'active-m' : ''} href={contactUrl}>{labels.contact}</a>
              </li>
              <li>
                <div class="dropdown" style="padding-top: 22px;">
                  <button class="btn dropdown-toggle" type="button" id="dropdownMenuButton" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" style="font-size: 15px; font-weight: bold; padding-top: 10px; background: transparent; color: #111111;">
                    {labels.language}
                  </button>
                  <div class="dropdown-menu" aria-labelledby="dropdownMenuButton" style="min-width: 130px; padding: 8px 12px;">
                    <a href="/" style="display: flex; align-items: center; gap: 8px; padding: 4px 0; color: #333; text-decoration: none;">English</a>
                    <a href="/jp/" style="display: flex; align-items: center; gap: 8px; padding: 4px 0; color: #333; text-decoration: none;"><img src="https://cdn.parcellab.com/img/flags/jp.png" class="flag" alt="JP" width="18" height="12" /> 日本語</a>
                    <a href="/kr/" style="display: flex; align-items: center; gap: 8px; padding: 4px 0; color: #333; text-decoration: none;"><img src="https://cdn.parcellab.com/img/flags/kr.png" class="flag" alt="KR" width="18" height="12" /> 한국인</a>
                  </div>
                </div>
              </li>
            </ul>
          </nav>
        </div>
      </div>
    </div>
  </div>
</header>
