---
import BRAND from '../config/site';

interface Props {
  currentPath?: string;
  locale?: 'en' | 'jp' | 'kr';
}

const { currentPath = '/', locale = 'en' } = Astro.props;

// Determine active paths
const isHome = currentPath === '/' || currentPath === '/jp/' || currentPath === '/kr/';
const isAbout = currentPath.includes('/about');
const isFacilities = currentPath.includes('/facilities');
const isCompliance = currentPath.includes('/compliance');
const isProduct = currentPath.includes('/category') || currentPath.includes('/product');
const isGallery = currentPath.includes('/gallery');
const isContact = currentPath.includes('/contact');

const homeUrl = locale === 'en' ? '/' : `/${locale}/`;
const aboutUrl = locale === 'en' ? '/about' : `/${locale}/about`;
const facilitiesUrl = locale === 'en' ? '/facilities' : `/${locale}/facilities`;
const complianceUrl = locale === 'en' ? '/compliance' : `/${locale}/compliance`;
const galleryUrl = locale === 'en' ? '/gallery' : `/${locale}/gallery`;
const contactUrl = locale === 'en' ? '/contact' : `/${locale}/contact`;

const labels = {
  en: {
    home: 'HOME',
    about: 'ABOUT US',
    facilities: 'FACILITIES',
    compliance: 'COMPLIANCE',
    products: 'GLOVE CATALOG',
    gallery: 'GALLERY',
    contact: 'CONTACT',
    language: 'EN',
    rfq: 'REQUEST RFQ',
    statusBanner: 'DIRECT PPE MANUFACTURER & EXPORTER • SAVAR FACTORY & DHAKA HQ'
  },
  jp: {
    home: 'ホーム',
    about: '企業情報',
    facilities: '製造施設',
    compliance: '認証規格',
    products: '製品カタログ',
    gallery: 'ギャラリー',
    contact: 'お問い合わせ',
    language: 'JP',
    rfq: 'お見積り依頼',
    statusBanner: '産業用作業用手袋の直接製造・輸出企業 • バングラデシュ工場'
  },
  kr: {
    home: '홈',
    about: '회사 소개',
    facilities: '생산 시설',
    compliance: '품질 인증',
    products: '제품 카탈로그',
    gallery: '갤러리',
    contact: '문의하기',
    language: 'KR',
    rfq: '견적 요청',
    statusBanner: '산업용 안전 장갑 직접 제조 및 수출 • 사바르 공장 및 다카 본사'
  }
}[locale];

// 7 Structured Glove Categories
const gloveNavGroups = [
  { code: '01', title: 'Leather Welding Gloves', url: '/category/20', count: '27 Models' },
  { code: '02', title: 'Leather Split Gloves', url: '/category/19', count: '11 Models' },
  { code: '03', title: 'Leather Driver Gloves', url: '/category/17', count: '7 Models' },
  { code: '04', title: 'Leather Grain Gloves', url: '/category/18', count: '10 Models' },
  { code: '05', title: 'Mechanics & Impact', url: '/category/29', count: '15 Models' },
  { code: '06', title: 'Leather Palm & Synthetic', url: '/category/21', count: '20 Models' },
  { code: '07', title: 'Welding Apparel & Utility', url: '/category/24', count: '27 Models' }
];

const allCategories = [
  { id: 20, name: 'Leather Welding Gloves', url: '/category/20' },
  { id: 19, name: 'Leather Split Gloves', url: '/category/19' },
  { id: 17, name: 'Leather Driver Gloves', url: '/category/17' },
  { id: 18, name: 'Leather Grain Gloves', url: '/category/18' },
  { id: 23, name: 'Leather Winter Gloves', url: '/category/23' },
  { id: 21, name: 'Leather Palm Gloves', url: '/category/21' },
  { id: 27, name: 'Synthetic Leather Gloves', url: '/category/27' },
  { id: 29, name: 'Mechanic\'s Gloves', url: '/category/29' },
  { id: 30, name: 'Impact Gloves', url: '/category/30' },
  { id: 24, name: 'Leather Welding Jackets', url: '/category/24' },
  { id: 25, name: 'Leather Welding Trousers', url: '/category/25' },
  { id: 31, name: 'Cotton Interlock Gloves', url: '/category/31' },
  { id: 32, name: 'Gardening Gloves', url: '/category/32' }
];
---

<header class="header architectural-header">
  <!-- 1. Carbon-Steel Industrial Topbar -->
  <div class="header-topbar-steel">
    <div class="container-fluid px-lg-5">
      <div class="row align-items-center">
        <!-- Status & Operational Notice -->
        <div class="col-lg-7 d-none d-lg-flex align-items-center gap-4">
          <div class="topbar-status-badge">
            <span class="status-indicator-dot"></span>
            <span class="status-text font-mono">{labels.statusBanner}</span>
          </div>
        </div>

        <!-- Direct Contact Channels & Social -->
        <div class="col-lg-5 col-12 d-flex justify-content-end align-items-center gap-3">
          <a
            href={BRAND.whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="topbar-link font-mono topbar-whatsapp-link"
            aria-label={`WhatsApp ${BRAND.phone}`}
            title={`Chat on WhatsApp (${BRAND.phone})`}
          >
            <i class="fab fa-whatsapp text-whatsapp" aria-hidden="true"></i>
            <span>{BRAND.phone}</span>
          </a>
          <span class="topbar-divider" aria-hidden="true">|</span>
          <a href={BRAND.emailMailto} class="topbar-link font-mono" aria-label={`Email ${BRAND.email}`}>
            <i class="far fa-envelope text-crimson" aria-hidden="true"></i>
            <span>{BRAND.email}</span>
          </a>
          <span class="topbar-divider" aria-hidden="true">|</span>
          <!-- Social Icons with >=44px Touch Targets -->
          <div class="topbar-socials" role="group" aria-label="Social media channels">
            <a href="https://www.facebook.com" target="_blank" rel="noopener noreferrer" class="social-target-btn" aria-label="Max Gloves on Facebook">
              <i class="fab fa-facebook-f" aria-hidden="true"></i>
            </a>
            <a href="https://www.linkedin.com" target="_blank" rel="noopener noreferrer" class="social-target-btn" aria-label="Max Gloves on LinkedIn">
              <i class="fab fa-linkedin-in" aria-hidden="true"></i>
            </a>
            <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="social-target-btn" aria-label="Max Gloves on Twitter">
              <i class="fab fa-twitter" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="rt-sticky-placeholder" aria-hidden="true"></div>

  <!-- 2. Clean Architectural Sticky Main Header -->
  <div id="header-menu" class="header-menu-bar">
    <div class="container-fluid px-lg-5">
      <div class="d-flex align-items-center justify-content-between">
        <!-- Logo Area -->
        <div class="brand-logo-area">
          <a href={homeUrl} class="brand-logo-anchor" aria-label={`${BRAND.companyName} Home`}>
            <img
              src={BRAND.logo.horizontal}
              alt={BRAND.logo.alt}
              width="240"
              height="60"
              style="max-height: 52px; width: auto; object-fit: contain; display: block;"
            />
          </a>
        </div>

        <!-- Desktop Navigation -->
        <nav class="architectural-desktop-nav d-none d-lg-flex align-items-center" aria-label="Main Navigation">
          <ul class="nav-link-list">
            <li>
              <a href={homeUrl} class={`nav-item-link ${isHome ? 'active' : ''}`}>{labels.home}</a>
            </li>
            <li>
              <a href={aboutUrl} class={`nav-item-link ${isAbout ? 'active' : ''}`}>{labels.about}</a>
            </li>
            <li>
              <a href={facilitiesUrl} class={`nav-item-link ${isFacilities ? 'active' : ''}`}>{labels.facilities}</a>
            </li>
            <li>
              <a href={complianceUrl} class={`nav-item-link ${isCompliance ? 'active' : ''}`}>{labels.compliance}</a>
            </li>

            <!-- Glove Catalog Dropdown (Mega taxonomy) -->
            <li class="nav-dropdown-wrapper">
              <button
                type="button"
                class={`nav-item-link dropdown-toggle-btn ${isProduct ? 'active' : ''}`}
                aria-expanded="false"
                aria-haspopup="true"
                id="productsDropdownTrigger"
              >
                <span>{labels.products}</span>
                <i class="fas fa-chevron-down nav-caret" aria-hidden="true"></i>
              </button>

              <div class="catalog-megamenu-panel" aria-labelledby="productsDropdownTrigger">
                <div class="megamenu-header">
                  <span class="font-mono text-muted text-uppercase" style="font-size: 11px; letter-spacing: 0.08em;">
                    Direct Industrial Glove Exporter // 13 Certified Categories
                  </span>
                  <a href="/category/20" class="view-all-link font-mono">
                    View Complete Catalog <i class="fas fa-arrow-right" aria-hidden="true"></i>
                  </a>
                </div>

                <div class="megamenu-grid">
                  <!-- 7 Primary Clusters -->
                  <div class="megamenu-col primary-clusters">
                    <div class="col-kicker font-mono">PRIMARY CATEGORIES</div>
                    <ul class="cluster-list">
                      {gloveNavGroups.map((grp) => (
                        <li>
                          <a href={grp.url} class="cluster-link">
                            <span class="cluster-code font-mono">{grp.code}</span>
                            <span class="cluster-title">{grp.title}</span>
                            <span class="cluster-count font-mono">{grp.count}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Complete 13 Categories Index -->
                  <div class="megamenu-col all-categories">
                    <div class="col-kicker font-mono">ALL PRODUCT CATEGORIES</div>
                    <ul class="all-cats-list">
                      {allCategories.map((c) => (
                        <li>
                          <a href={c.url} class="cat-link">
                            <i class="fas fa-angle-right text-crimson" aria-hidden="true"></i>
                            <span>{c.name}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              </div>
            </li>

            <li>
              <a href={galleryUrl} class={`nav-item-link ${isGallery ? 'active' : ''}`}>{labels.gallery}</a>
            </li>
            <li>
              <a href={contactUrl} class={`nav-item-link ${isContact ? 'active' : ''}`}>{labels.contact}</a>
            </li>
          </ul>

          <!-- Right Action Cluster: Language Switcher & RFQ CTA -->
          <div class="nav-actions-cluster d-flex align-items-center gap-3 ms-4">
            <!-- Language Dropdown -->
            <div class="language-dropdown-wrapper">
              <button
                type="button"
                id="languageMenuBtn"
                class="language-btn font-mono"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label="Select Language"
              >
                <i class="fas fa-globe text-muted" aria-hidden="true"></i>
                <span>{labels.language}</span>
                <i class="fas fa-chevron-down" style="font-size: 10px;" aria-hidden="true"></i>
              </button>

              <div class="language-menu-panel" id="languageMenuPanel" aria-labelledby="languageMenuBtn">
                <a href="/" class={`lang-option ${locale === 'en' ? 'current' : ''}`}>
                  <span class="flag-icon-svg" aria-hidden="true">
                    <!-- EN SVG flag representation -->
                    <svg width="18" height="12" viewBox="0 0 60 30" style="border: 1px solid #E2E8F0; border-radius: 2px;">
                      <clipPath id="s"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
                      <clipPath id="t"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z"/></clipPath>
                      <g clip-path="url(#s)">
                        <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
                        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
                        <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#t)" stroke="#C81E1E" stroke-width="4"/>
                        <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
                        <path d="M30,0 v30 M0,15 h60" stroke="#C81E1E" stroke-width="6"/>
                      </g>
                    </svg>
                  </span>
                  <span>English</span>
                </a>
                <a href="/jp/" class={`lang-option ${locale === 'jp' ? 'current' : ''}`}>
                  <span class="flag-icon-svg" aria-hidden="true">
                    <!-- JP Flag SVG -->
                    <svg width="18" height="12" viewBox="0 0 900 600" style="border: 1px solid #E2E8F0; border-radius: 2px;">
                      <rect width="900" height="600" fill="#ffffff"/>
                      <circle cx="450" cy="300" r="180" fill="#bc002d"/>
                    </svg>
                  </span>
                  <span>日本語</span>
                </a>
                <a href="/kr/" class={`lang-option ${locale === 'kr' ? 'current' : ''}`}>
                  <span class="flag-icon-svg" aria-hidden="true">
                    <!-- KR Flag SVG -->
                    <svg width="18" height="12" viewBox="0 0 900 600" style="border: 1px solid #E2E8F0; border-radius: 2px;">
                      <rect width="900" height="600" fill="#ffffff"/>
                      <circle cx="450" cy="300" r="150" fill="#cd2e3a"/>
                    </svg>
                  </span>
                  <span>한국어</span>
                </a>
              </div>
            </div>

            <!-- Architectural RFQ Button -->
            <a href={contactUrl} class="btn-architectural-rfq font-mono">
              <span>{labels.rfq}</span>
              <i class="fas fa-arrow-right" aria-hidden="true"></i>
            </a>
          </div>
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  /* Carbon-Steel Topbar */
  .header-topbar-steel {
    background-color: var(--color-steel, #0B1118);
    border-bottom: 1px solid var(--color-steel-border, #223242);
    padding: 7px 0;
    font-size: 13px;
    color: #94A3B8;
  }
  .topbar-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #15202B;
    border: 1px solid #223242;
    padding: 4px 10px;
    border-radius: 4px;
  }
  .status-indicator-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-crimson, #C81E1E);
    box-shadow: 0 0 6px var(--color-crimson, #C81E1E);
    display: inline-block;
  }
  .status-text {
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: #E2E8F0;
    font-weight: 500;
  }
  .topbar-link {
    color: #CBD5E1;
    text-decoration: none;
    font-size: 12.5px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color 0.2s ease;
  }
  .topbar-link:hover {
    color: #FFFFFF;
  }
  .text-whatsapp {
    color: #25D366 !important;
  }
  .topbar-whatsapp-link:hover {
    color: #25D366 !important;
  }
  .topbar-divider {
    color: #334155;
    user-select: none;
  }
  .topbar-socials {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
  .social-target-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 4px;
    color: #94A3B8;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .social-target-btn:hover {
    background: #15202B;
    color: #FFFFFF;
  }

  /* Main Header Menu */
  .header-menu-bar {
    background-color: #FFFFFF;
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    position: relative;
    z-index: 1020;
    transition: box-shadow 0.2s ease;
  }
  .header-menu-bar.rt-sticky {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    box-shadow: 0 4px 16px rgba(11, 17, 24, 0.08);
  }

  .brand-logo-area {
    padding: 12px 0;
  }
  .nav-link-list {
    display: flex;
    align-items: center;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-item-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    font-family: var(--font-heading, 'Barlow', sans-serif);
    font-size: 14.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--color-steel, #0B1118);
    text-decoration: none;
    border-radius: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .nav-item-link:hover,
  .nav-item-link.active {
    color: var(--color-crimson, #C81E1E);
    background-color: var(--color-canvas, #F8FAFC);
  }

  /* Mega Menu Dropdown */
  .nav-dropdown-wrapper {
    position: relative;
  }
  .nav-caret {
    font-size: 10px;
    transition: transform 0.2s ease;
  }
  .nav-dropdown-wrapper:hover .nav-caret,
  .nav-dropdown-wrapper:focus-within .nav-caret {
    transform: rotate(180deg);
  }
  .catalog-megamenu-panel {
    position: absolute;
    top: 100%;
    left: -120px;
    width: 680px;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    box-shadow: 0 12px 30px rgba(11, 17, 24, 0.12);
    padding: 20px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1030;
  }
  .nav-dropdown-wrapper:hover .catalog-megamenu-panel,
  .nav-dropdown-wrapper:focus-within .catalog-megamenu-panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .megamenu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 12px;
    margin-bottom: 16px;
    border-bottom: 1px solid var(--color-border, #E2E8F0);
  }
  .view-all-link {
    font-size: 12px;
    color: var(--color-crimson, #C81E1E);
    text-decoration: none;
    font-weight: 600;
  }
  .view-all-link:hover {
    text-decoration: underline;
  }

  .megamenu-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 20px;
  }
  .col-kicker {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--color-text-muted, #64748B);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }

  .cluster-list,
  .all-cats-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .cluster-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 7px 10px;
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-steel, #0B1118);
    font-family: var(--font-body);
    font-size: 13.5px;
    transition: all 0.15s ease;
  }
  .cluster-link:hover {
    background: var(--color-well, #F1F5F9);
    color: var(--color-crimson, #C81E1E);
  }
  .cluster-code {
    font-size: 11px;
    color: var(--color-crimson, #C81E1E);
    font-weight: 600;
    margin-right: 8px;
  }
  .cluster-count {
    font-size: 11px;
    color: var(--color-text-muted, #64748B);
  }

  .cat-link {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 5px 8px;
    font-size: 13px;
    color: #334155;
    text-decoration: none;
    border-radius: 4px;
    transition: all 0.15s ease;
  }
  .cat-link:hover {
    background: var(--color-well, #F1F5F9);
    color: var(--color-crimson, #C81E1E);
  }

  /* Language Switcher */
  .language-dropdown-wrapper {
    position: relative;
  }
  .language-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    background: var(--color-canvas, #F8FAFC);
    color: var(--color-steel, #0B1118);
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .language-btn:hover {
    border-color: var(--color-border-dark, #CBD5E1);
    background: #FFFFFF;
  }
  .language-menu-panel {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 6px;
    width: 140px;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    box-shadow: 0 8px 24px rgba(11, 17, 24, 0.1);
    padding: 6px;
    display: none;
    z-index: 1040;
  }
  .language-menu-panel.show {
    display: block;
  }
  .lang-option {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 10px;
    border-radius: 4px;
    font-size: 13px;
    color: var(--color-steel, #0B1118);
    text-decoration: none;
    transition: background 0.15s ease;
  }
  .lang-option:hover,
  .lang-option.current {
    background: var(--color-well, #F1F5F9);
    font-weight: 600;
  }

  /* Architectural RFQ Action Button */
  .btn-architectural-rfq {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    background-color: var(--color-crimson, #C81E1E);
    color: #FFFFFF;
    border: 1px solid var(--color-crimson, #C81E1E);
    border-radius: 4px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(200, 30, 30, 0.2);
    transition: all 0.2s ease;
  }
  .btn-architectural-rfq:hover {
    background-color: var(--color-crimson-hover, #A81818);
    border-color: var(--color-crimson-hover, #A81818);
    color: #FFFFFF;
    box-shadow: 0 4px 12px rgba(200, 30, 30, 0.35);
  }
</style>
