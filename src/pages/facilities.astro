---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import BRAND from '../config/site';

const plantFeatures = [
  {
    icon: 'fas fa-award',
    code: 'QA-01',
    title: 'Incoming Leather Inspection',
    desc: 'Automated thickness gauge verification, tensile testing, and raw hide grain sorting before cutting.'
  },
  {
    icon: 'fas fa-users-cog',
    code: 'OPS-02',
    title: '150+ Skilled Glove Craftsmen',
    desc: 'Expert leather stitchers trained in Kevlar lockstitch seam execution and palm welt reinforcement.'
  },
  {
    icon: 'fas fa-industry',
    code: 'CAP-03',
    title: '1,530 m² Production Floor',
    desc: 'Dedicated hydraulic clicker press banks, heavy sewing lines, conditioning bays, and export palletizing.'
  },
  {
    icon: 'fas fa-shield-alt',
    code: 'STD-04',
    title: 'Pre-Shipment Compliance',
    desc: 'Full batch mechanical abrasion, tear resistance, and anti-mold export protocol before container sealing.'
  }
];
---

<BaseLayout title={`Savar Manufacturing Facilities — ${BRAND.companyName}`} currentPath="/facilities">
  <PageBanner title="Manufacturing Facilities" breadcrumbs={[{ label: 'Home', url: '/' }, { label: 'Our Facilities' }]} />

  <section class="facilities-architectural-section" aria-label="Savar glove manufacturing facility">
    <div class="container">
      <div class="row g-5 align-items-center mb-5">
        <!-- Text Column -->
        <div class="col-lg-6 col-12">
          <div class="facility-overview-content">
            <div class="kicker-tag font-mono">
              <span class="crimson-dot"></span>
              <span>PLANT SPECIFICATION // SAVAR, HEMAYETPUR</span>
            </div>

            <h1 class="facility-main-heading">
              Modern Leather Glove Manufacturing Plant
            </h1>

            <p class="facility-lead-text">
              <strong>MAX GLOVES BD LTD.</strong> operates a specialized 1,530 m² industrial manufacturing plant in Savar, Hemayetpur, Bangladesh, situated strategically in the country's primary industrial export corridor.
            </p>

            <p class="facility-body-text">
              Our location provides direct highway transit to the capital Dhaka (1 hour), rapid airfreight access via Hazrat Shahjalal International Airport, and direct transport links to the country’s primary seaport at Chittagong for streamlined ocean freight dispatch.
            </p>

            <p class="facility-body-text">
              By leveraging Bangladesh's world-class leather and tannery supply chains, our Savar facility delivers large-scale export orders of cowhide welding, split leather, driver, and mechanics gloves with exceptional cost efficiency and uncompromising international PPE quality.
            </p>

            <div class="pt-3">
              <a href="/contact" class="btn-crimson font-mono">
                <i class="far fa-paper-plane" aria-hidden="true"></i>
                <span>SCHEDULE FACTORY INSPECTION</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Image Column -->
        <div class="col-lg-6 col-12">
          <div class="facility-photo-frame">
            <img
              src="/front-end/img/about/facilities.jpg"
              alt="Max Gloves BD Ltd. Savar Manufacturing Plant Facility"
              loading="lazy"
              decoding="async"
              class="facility-showcase-img"
            />
            <div class="facility-photo-badge font-mono">
              <i class="fas fa-industry text-crimson" aria-hidden="true"></i>
              <span>SAVAR PLANT FLOOR // HYDRAULIC CUTTING & STITCHING BAYS</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 4-Grid Operational Features (1px #E2E8F0 structural borders, 4px radii) -->
      <div class="row g-4 mt-2">
        {plantFeatures.map((feat) => (
          <div class="col-xl-3 col-md-6 col-12">
            <div class="facility-feature-box">
              <div class="d-flex align-items-center justify-content-between mb-3">
                <div class="feature-icon-bubble">
                  <i class={`${feat.icon} text-crimson`} aria-hidden="true"></i>
                </div>
                <span class="feature-code font-mono">{feat.code}</span>
              </div>
              <h3 class="feature-title">{feat.title}</h3>
              <p class="feature-desc">{feat.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .facilities-architectural-section {
    background-color: var(--color-canvas, #F8FAFC);
    padding: 80px 0 100px;
  }

  .facility-main-heading {
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 800;
    color: var(--color-steel, #0B1118);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-bottom: 18px;
  }
  .facility-lead-text {
    font-size: 16.5px;
    line-height: 1.6;
    color: var(--color-steel, #0B1118);
    margin-bottom: 14px;
  }
  .facility-body-text {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-muted, #64748B);
    margin-bottom: 16px;
  }

  .facility-photo-frame {
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    overflow: hidden;
  }
  .facility-showcase-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }
  .facility-photo-badge {
    background: #0B1118;
    color: #CBD5E1;
    padding: 10px 16px;
    font-size: 11px;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.05em;
  }

  /* 4-Box Feature Cards */
  .facility-feature-box {
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    padding: 24px;
    height: 100%;
    transition: all 0.2s ease;
  }
  .facility-feature-box:hover {
    border-color: var(--color-border-dark, #CBD5E1);
    box-shadow: 0 4px 16px rgba(11, 17, 24, 0.04);
  }

  .feature-icon-bubble {
    width: 44px;
    height: 44px;
    border-radius: 4px;
    background: var(--color-well, #F1F5F9);
    border: 1px solid var(--color-border, #E2E8F0);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }
  .feature-code {
    font-size: 11px;
    color: var(--color-text-muted, #64748B);
  }

  .feature-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-steel, #0B1118);
    margin-bottom: 8px;
  }
  .feature-desc {
    color: var(--color-text-muted, #64748B);
    font-size: 13.5px;
    line-height: 1.55;
    margin: 0;
  }
</style>
