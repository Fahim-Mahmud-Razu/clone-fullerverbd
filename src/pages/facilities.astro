---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
---

<BaseLayout title="Our Facilities - Max Gloves BD Ltd." currentPath="/facilities">
  <PageBanner title="Our Facilities" breadcrumbs={[{ label: 'Home', url: '/' }, { label: 'Our Facilities' }]} />

  <section class="facilities">
    <div class="container1">
      <div class="content">
        <span class="eyebrow">/// WHAT WE HAVE</span>
        <h1>Our Facilities</h1>
        <div class="line"></div>

        <p><strong>Max Gloves BD Ltd.</strong> is based in Savar, Hemayetpur, Bangladesh, in a prime manufacturing area only 1 hour outside the capital Dhaka, and the airport. Further benefits of our location include convenient transport links to the nearest port, Chittagong.</p>

        <p>Bangladesh has a globally recognized leather and apparel manufacturing ecosystem. This environment enables <strong>Max Gloves BD Ltd.</strong> to employ experienced, highly skilled craftsmen and technicians who maintain rigorous quality standards and manufacturing agility.</p>

        <p><strong>Max Gloves BD Ltd.</strong> produces reliable leather drivers and welding gloves that are shipped to global clients across the world.</p>

        <p>We create advanced leather gloves with increased comfort and heat resistance. Our team can develop custom products based on customer requirements.</p>

        <p>We are capable of producing high volume stock at a lower cost while maintaining quality, safety, and consistent production capability.</p>
      </div>

      <div class="gallery">
        <div class="single-item right-item" style="padding-right: 20px;">
          <img style="border: 2px solid var(--brand-navy); width: 100%; border-radius: 4px; box-shadow: 0 10px 30px rgba(0,0,0,0.12);" src="/front-end/img/about/facilities.jpg" alt="Our Facilities" />
        </div>
      </div>
    </div>

    <div class="features">
      <div><b>🏅 Premium Quality</b><span>High quality raw materials and strict quality control.</span></div>
      <div><b>👥 Skilled Workforce</b><span>Experienced and efficient team ensuring excellence.</span></div>
      <div><b>🏭 High Capacity</b><span>Large scale production with on-time delivery.</span></div>
      <div><b>🛡 Safety First</b><span>Committed to safety standards and compliance.</span></div>
    </div>
  </section>
</BaseLayout>

<style>
  .facilities {
    padding: 70px 5%;
    background: #ffffff;
  }
  .container1 {
    max-width: 1200px;
    margin: auto;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 55px;
    align-items: center;
  }
  .eyebrow {
    font-size: 14px;
    font-weight: 700;
    color: var(--brand-orange);
    letter-spacing: 1px;
    display: block;
  }
  .content h1 {
    font-size: 58px;
    margin: 18px 0;
    color: var(--brand-navy);
    font-weight: 700;
    line-height: 1.1;
  }
  .line {
    width: 45px;
    height: 4px;
    background: var(--brand-orange);
    margin-bottom: 25px;
  }
  .content p {
    font-size: 17px;
    line-height: 1.9;
    color: #596273;
    margin-bottom: 22px;
  }
  .content strong {
    color: var(--brand-orange);
  }
  .features {
    max-width: 1200px;
    margin: 50px auto 0;
    padding: 25px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.08);
  }
  .features div {
    padding: 15px;
    border-right: 1px solid #eee;
  }
  .features div:last-child {
    border-right: none;
  }
  .features b {
    display: block;
    font-size: 18px;
    margin-bottom: 10px;
    color: var(--brand-navy);
  }
  .features span {
    color: #667085;
    line-height: 1.5;
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .facilities {
      padding: 40px 15px !important;
    }
    .container1 {
      grid-template-columns: 1fr;
      gap: 35px;
    }
    .content h1 {
      font-size: clamp(28px, 6vw, 42px);
    }
    .single-item.right-item {
      padding-right: 0 !important;
    }
    .features {
      grid-template-columns: 1fr;
      margin-top: 35px;
      padding: 16px;
    }
    .features div {
      border-right: none;
      border-bottom: 1px solid #eee;
      padding: 12px 6px;
    }
    .features div:last-child {
      border-bottom: none;
    }
  }
</style>
