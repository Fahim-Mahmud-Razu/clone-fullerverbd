---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import CertificationSlider from '../components/CertificationSlider.astro';
import BRAND from '../config/site';

const workingProcess = [
  { num: '01', title: 'Raw Materials', url: '/raw-materials', img: '/front-end/img/service/rawmaterials.webp' },
  { num: '02', title: 'Cutting Process', url: '/cutting-process', img: '/front-end/img/service/catting.webp' },
  { num: '03', title: 'Sewing Process', url: '/sewing-process', img: '/front-end/img/service/swwim.webp' },
  { num: '04', title: 'Packaging', url: '/packaging', img: '/front-end/img/service/Packaging.webp' }
];

const categoryTiles = [
  { id: 23, title: 'Leather Winter Gloves', url: '/category/23', img: '/media-library/wenter.png' },
  { id: 17, title: 'Leather Driver Gloves', url: '/category/17', img: '/media-library/driver.png' },
  { id: 18, title: 'Leather Grain Gloves', url: '/category/18', img: '/media-library/Grain-Gloves.png' },
  { id: 19, title: 'Leather Split Gloves', url: '/category/19', img: '/media-library/slipt.png' },
  { id: 20, title: 'Leather Welding Gloves', url: '/category/20', img: '/media-library/walding.png' },
  { id: 21, title: 'Leather Palm Gloves', url: '/category/21', img: '/media-library/117356021.png' },
  { id: 25, title: 'Leather Welding Apparel', url: '/category/25', img: '/media-library/pant.png' },
  { id: 24, title: 'Leather Welding Apparel', url: '/category/24', img: '/media-library/jek.png' },
  { id: 27, title: 'Synthetic Leather Gloves', url: '/category/27', img: '/media-library/Micro-Gloves.png' },
  { id: 29, title: "Mechanic's Gloves", url: '/category/29', img: '/media-library/0172317000.png' },
  { id: 30, title: 'Impact Gloves', url: '/category/30', img: '/media-library/0000025056864_1.png' },
  { id: 31, title: '100% Cotton Interlock Gloves', url: '/category/31', img: '/media-library/cotton_new.png' },
  { id: 32, title: 'Gardening Gloves', url: '/category/32', img: '/media-library/GG1_F.png' }
];

const stats = [
  { icon: 'flaticon-apartment', target: 1200, display: '1,200', title: 'Skilled Workers' },
  { icon: 'flaticon-industry', target: 12000, display: '12,000', title: 'Square Meters' },
  { icon: 'flaticon-helmet', target: 100000, display: '1,00,000', title: 'Dozen Gloves Produced Monthly' },
  { icon: 'flaticon-happy', target: 40, display: '40', title: 'Million Gloves Produced Overall' }
];
---

<BaseLayout title={`${BRAND.companyName} — Protecting Hands, Building Futures`} currentPath="/">
  <!-- 1. Hero Section with Synchronized Navigation -->
  <HeroSlider />

  <!-- 2. Our Working Process Section (Fuller Ver BD Signature Circular Process Nodes) -->
  <section class="service-wrap-layout1" aria-label="Our Working Process">
    <div class="container">
      <div class="heading-layout1 heading-light text-center">
        <div class="kicker-tag font-mono">
          <span class="crimson-dot"></span>
          <span>MANUFACTURING INTEGRITY // 4-STAGE PRODUCTION FLOW</span>
        </div>
        <h2 class="process-main-title">Our Working Process</h2>
        <div class="process-rule-bar" aria-hidden="true"></div>
      </div>

      <div class="row g-4 justify-content-center">
        {workingProcess.map((proc) => (
          <div class="col-lg-3 col-md-6 col-12">
            <div class="service-box-layout1 text-center">
              <div class="item-img">
                <a href={proc.url} aria-label={`View ${proc.title} details`}>
                  <img
                    src={proc.img}
                    alt={proc.title}
                    width="250"
                    height="250"
                    loading="lazy"
                    decoding="async"
                    class="process-circular-img"
                  />
                </a>
                <div class="sl-number font-mono" aria-hidden="true">
                  {proc.num}
                </div>
              </div>
              <div class="item-content">
                <h3 class="item-title">
                  <a href={proc.url} class="process-title-link">
                    {proc.title}
                  </a>
                </h3>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Product Categories Section (13 Category Tiles with Studio-Well Lighting & Hover Reveal) -->
  <section class="project-wrap-layout1" aria-label="Our Product Categories">
    <div class="container text-center">
      <!-- Section Banner Header -->
      <div class="categories-header-wrap">
        <img
          src="/front-end/img/CT.png"
          alt="Our Product Categories"
          width="480"
          height="75"
          loading="lazy"
          decoding="async"
          class="categories-header-img"
        />
        <div class="kicker-tag font-mono mt-3">
          <span class="crimson-dot"></span>
          <span>CERTIFIED EXPORT PPE // DIRECT FACTORY CATALOG</span>
        </div>
      </div>

      <!-- 13 Category Tiles Grid -->
      <div class="row gutters-15 g-4 mt-2">
        {categoryTiles.map((cat) => (
          <div class="col-lg-4 col-md-6 col-12">
            <div class="project-box-layout1">
              <!-- 4:3 Studio Well Background -->
              <div class="item-img">
                <img
                  src={cat.img}
                  alt={cat.title}
                  loading="lazy"
                  decoding="async"
                  class="category-tile-img"
                />
              </div>

              <!-- Fullerver Signature Hover Reveal Overlay -->
              <div class="item-content">
                <a href={cat.url} class="item-btn font-mono" aria-label={`Explore ${cat.title}`}>
                  <span>{cat.title}</span>
                  <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- More Category Link -->
      <div class="more-catalog-callout">
        <a href="/category/20" class="more-category-link font-mono">
          <span>More.. Click Menu Our Product</span>
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Signature Fuller Ver BD Diagonal Red Angled Polygon About Section (Image 1 Signature) -->
  <section class="about-wrap-layout1" aria-label="Company Overview">
    <!-- Factory Building Background Layer -->
    <div class="about-building-layer" aria-hidden="true">
      <img
        src="/front-end/img/about/about-bg.png"
        alt="MAX GLOVES BD LTD Industrial Factory in Savar, Dhaka"
        class="about-building-img"
        loading="lazy"
        decoding="async"
      />
    </div>

    <!-- Slanted Industrial Crimson Polygon Box -->
    <div class="about-box-layout1">
      <div class="about-box-content">
        <div class="item-header">
          <div class="experience-year font-heading">
            4<span class="zero-target">0</span>
          </div>
          <div class="experience-title font-heading">
            <span class="title-top">Years Of</span>
            <span class="title-bottom">Working Experience</span>
          </div>
        </div>

        <div class="about-divider-line" aria-hidden="true"></div>

        <p class="about-lead-text">
          <strong>MAX GLOVES BD LTD.</strong> is a dedicated safety gloves manufacturer based in Savar, Hemayetpur, Bangladesh, backed by over 40 years of industrial expertise beginning with technical partnerships in China. Engineered for high-durability protection across international B2B export markets.
        </p>

        <a href="/about" class="about-readmore-btn font-heading">
          <span>READ MORE</span>
          <i class="fas fa-chevron-right" aria-hidden="true"></i>
        </a>
      </div>
    </div>
  </section>

  <!-- 5. Industrial Progress & Statistics Counter Section (Image 1 4-Stat Row) -->
  <section class="progress-wrap-layout1" aria-label="Production Statistics">
    <div class="container">
      <div class="row g-3">
        {stats.map((st) => (
          <div class="col-lg-3 col-sm-6 col-12">
            <div class="stat-card">
              <div class="stat-card-icon" aria-hidden="true">
                <i class={st.icon}></i>
              </div>
              <div class="stat-card-body">
                <div class="counter count-number font-mono" data-num={st.target}>
                  {st.display}
                </div>
                <div class="count-title">{st.title}</div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Certifications Trust Grid -->
  <CertificationSlider />
</BaseLayout>

<style>
  /* --------------------------------------------------------------------------
     Global Reusable Utilities
     -------------------------------------------------------------------------- */
  .kicker-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #64748B);
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 5px 12px;
    border-radius: 4px;
    margin-bottom: 12px;
  }
  .crimson-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-crimson, #C81E1E);
    display: inline-block;
  }

  /* --------------------------------------------------------------------------
