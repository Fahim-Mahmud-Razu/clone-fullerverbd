  }

  .project-box-layout1 .item-btn {
    color: #FFFFFF;
    border: 1.5px solid var(--color-crimson, #C81E1E);
    background-color: var(--color-crimson, #C81E1E);
    padding: 10px 22px;
    border-radius: 4px;
    font-weight: 700;
    text-decoration: none;
    font-size: 14.5px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: background 0.2s ease, transform 0.2s ease;
    box-shadow: 0 4px 12px rgba(200, 30, 30, 0.35);
  }
  .project-box-layout1 .item-btn:hover {
    background-color: #A51818;
    border-color: #A51818;
    transform: translateY(-1px);
  }

  .more-catalog-callout {
    margin-top: 40px;
  }
  .more-category-link {
    color: var(--color-crimson, #C81E1E);
    font-size: 15px;
    font-weight: 700;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    transition: all 0.2s ease;
  }
  .more-category-link:hover {
    background: #FEF2F2;
    border-color: #FCA5A5;
    transform: translateX(3px);
  }

  /* --------------------------------------------------------------------------
     Section 4: Diagonal Red Angled Polygon About Section (Image 1 Signature)
     -------------------------------------------------------------------------- */
  .about-wrap-layout1 {
    background-color: #070B10;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: stretch;
    min-height: 500px;
    border-top: 1px solid #1E293B;
  }

  .about-building-layer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 62%;
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    pointer-events: none;
    z-index: 1;
    overflow: hidden;
  }
  .about-building-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
  }

  .about-box-layout1 {
    position: relative;
    z-index: 2;
    width: 54%;
    background-color: var(--color-crimson, #C81E1E);
    -webkit-clip-path: polygon(0 0, 100% 0%, 78% 100%, 0 100%);
    clip-path: polygon(0 0, 100% 0%, 78% 100%, 0 100%);
    padding-left: max(24px, calc((100vw - 1200px) / 2 + 15px));
    padding-right: 80px;
    padding-top: 80px;
    padding-bottom: 80px;
    display: flex;
    align-items: center;
  }

  @media only screen and (max-width: 1399px) {
    .about-box-layout1 {
      width: 58%;
      -webkit-clip-path: polygon(0 0, 100% 0%, 80% 100%, 0 100%);
      clip-path: polygon(0 0, 100% 0%, 80% 100%, 0 100%);
      padding-right: 70px;
    }
    .about-building-layer {
      width: 58%;
    }
  }

  @media only screen and (max-width: 1199px) {
    .about-box-layout1 {
      padding-left: max(24px, calc((100vw - 960px) / 2 + 15px));
      padding-right: 60px;
      width: 62%;
      -webkit-clip-path: polygon(0 0, 100% 0%, 82% 100%, 0 100%);
      clip-path: polygon(0 0, 100% 0%, 82% 100%, 0 100%);
    }
    .about-building-layer {
      width: 54%;
    }
  }

  @media only screen and (max-width: 991px) {
    .about-wrap-layout1 {
      flex-direction: column;
    }
    .about-box-layout1 {
      width: 100%;
      clip-path: none;
      -webkit-clip-path: none;
      padding: 60px 24px;
    }
    .about-building-layer {
      position: relative;
      width: 100%;
      height: 280px;
    }
  }

  .about-box-content {
    width: 100%;
    max-width: 520px;
  }

  .about-box-layout1 .item-header {
    display: flex;
    align-items: center;
    color: #FFFFFF;
  }

  .experience-year {
    font-size: clamp(64px, 6.5vw, 88px);
    font-weight: 700;
    line-height: 0.85;
    color: #FFFFFF;
    letter-spacing: -0.04em;
    display: inline-flex;
    align-items: center;
  }
  .experience-year .zero-target {
    position: relative;
    display: inline-block;
  }
  .experience-year .zero-target::after {
    content: '';
    position: absolute;
    width: clamp(10px, 1.2vw, 15px);
    height: clamp(10px, 1.2vw, 15px);
    background-color: #FFFFFF;
    border-radius: 50%;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  .experience-title {
    display: flex;
    flex-direction: column;
    margin-left: 20px;
    line-height: 1.15;
  }
  .experience-title .title-top {
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 600;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }
  .experience-title .title-bottom {
    font-size: clamp(20px, 2.2vw, 28px);
    font-weight: 700;
    color: #FFFFFF;
    letter-spacing: -0.01em;
  }

  .about-divider-line {
    width: 100%;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.4);
    margin: 18px 0 22px;
  }

  .about-lead-text {
    color: #FFFFFF;
    margin-bottom: 30px;
    font-size: 15px;
    line-height: 1.75;
    font-weight: 400;
  }

  .about-readmore-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background-color: #FFFFFF;
    color: #0B1118;
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    padding: 12px 28px;
    border-radius: 4px;
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.22);
    transition: all 0.25s ease;
  }
  .about-readmore-btn:hover {
    background-color: #0B1118;
    color: #FFFFFF;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.35);
  }

  /* --------------------------------------------------------------------------
     Section 5: Industrial Progress & Statistics Counter Strip (Image 1 4-Stat Row)
     -------------------------------------------------------------------------- */
  .progress-wrap-layout1 {
    background-color: #070B10;
    padding: 30px 0 35px;
    border-top: 1px solid #1E293B;
    border-bottom: 1px solid #1E293B;
  }

  .stat-card {
    padding: 20px 18px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: #0E1722;
    border-radius: 4px;
    min-height: 110px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: border-color 0.25s ease, background-color 0.25s ease, transform 0.25s ease;
  }
  .stat-card:hover {
    border-color: rgba(200, 30, 30, 0.45);
    background: #131E2B;
    transform: translateY(-2px);
  }

  .stat-card-icon {
    line-height: 1;
    flex-shrink: 0;
  }
  .stat-card-icon i {
    color: var(--color-crimson, #C81E1E);
    font-size: 34px;
    display: block;
  }

  .stat-card-body {
    text-align: left;
    min-width: 0;
  }
  .stat-card-body .count-number {
    font-size: 28px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 4px;
    letter-spacing: -0.02em;
  }
  .stat-card-body .count-title {
    font-size: 13px;
    color: #94A3B8;
    line-height: 1.35;
    font-weight: 500;
  }
    font-weight: 500;
  }
</style>

<script>
  function initCounters() {
    const counters = document.querySelectorAll<HTMLElement>('.counter.count-number');
    if (!counters.length) return;

    const observer = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            obs.unobserve(el);
            const target = parseInt(el.getAttribute('data-num') || '0', 10);
            const duration = 1600;
            const startTime = performance.now();

            function update(currentTime: number) {
              const elapsed = currentTime - startTime;
              const progress = Math.min(elapsed / duration, 1);
              // Ease-out cubic
              const eased = 1 - Math.pow(1 - progress, 3);
              const current = Math.floor(eased * target);

              if (target === 100000) {
                if (current < 100000) {
                  el.textContent = current.toLocaleString();
                } else {
                  el.textContent = '1,00,000';
                }
              } else {
                el.textContent = current.toLocaleString();
              }

              if (progress < 1) {
                requestAnimationFrame(update);
              } else {
                if (target === 100000) {
                  el.textContent = '1,00,000';
                } else {
                  el.textContent = target.toLocaleString();
                }
              }
            }
            requestAnimationFrame(update);
          }
        });
      },
      { threshold: 0.25 }
    );

    counters.forEach((c) => observer.observe(c));
  }

  // Run on initial page load and view transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCounters);
  } else {
    initCounters();
  }
  document.addEventListener('astro:page-load', initCounters);
</script>
