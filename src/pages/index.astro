---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import CertificationSlider from '../components/CertificationSlider.astro';
import BRAND from '../config/site';

const workingProcess = [
  {
    step: '01',
    code: 'LEATHER-GRADE',
    title: 'Raw Material Selection',
    subtitle: 'Grade-A Cowhide & Goatskin',
    desc: 'Incoming leather hides undergo strict caliper thickness testing, tensile grading, and visual defect segregation before staging.',
    url: '/raw-materials',
    img: '/front-end/img/service/rawmaterials.webp'
  },
  {
    step: '02',
    code: 'DIE-CUTTING',
    title: 'Precision Die Cutting',
    subtitle: 'Hydraulic Press & Laser Accuracy',
    desc: 'Heavy-duty hydraulic clicker presses and laser-calibrated steel dies stamp ergonomic glove patterns with zero edge fraying.',
    url: '/cutting-process',
    img: '/front-end/img/service/catting.webp'
  },
  {
    step: '03',
    code: 'KEVLAR-JOIN',
    title: 'Industrial Sewing',
    subtitle: 'Kevlar Thread & Reinforced Seams',
    desc: 'Heavy-duty industrial lockstitch sewing using heat-resistant Kevlar thread, reinforced welting, and double-layered thumb crotches.',
    url: '/sewing-process',
    img: '/front-end/img/service/swwim.webp'
  },
  {
    step: '04',
    code: 'QC-EXPORT',
    title: 'QC & Packaging',
    subtitle: 'Pre-Shipment Compliance Check',
    desc: 'Individual dimensional inspection, pair pairing, anti-mold conditioning, and export-compliant palletization for overseas freight.',
    url: '/packaging',
    img: '/front-end/img/service/Packaging.webp'
  }
];

const categoryTiles = [
  { id: 20, code: 'WELD', count: '27 Models', title: 'Leather Welding Gloves', url: '/category/20', img: '/media-library/walding.png' },
  { id: 19, code: 'SPLT', count: '11 Models', title: 'Leather Split Gloves', url: '/category/19', img: '/media-library/slipt.png' },
  { id: 17, code: 'DRIV', count: '7 Models', title: 'Leather Driver Gloves', url: '/category/17', img: '/media-library/driver.png' },
  { id: 18, code: 'GRAN', count: '10 Models', title: 'Leather Grain Gloves', url: '/category/18', img: '/media-library/Grain-Gloves.png' },
  { id: 23, code: 'WNTR', count: '6 Models', title: 'Leather Winter Gloves', url: '/category/23', img: '/media-library/wenter.png' },
  { id: 21, code: 'PALM', count: '11 Models', title: 'Leather Palm Gloves', url: '/category/21', img: '/media-library/117356021.png' },
  { id: 27, code: 'SYNT', count: '9 Models', title: 'Synthetic Leather Gloves', url: '/category/27', img: '/media-library/Micro-Gloves.png' },
  { id: 29, code: 'MECH', count: '12 Models', title: 'Mechanics Gloves', url: '/category/29', img: '/media-library/0172317000.png' },
  { id: 30, code: 'IMPC', count: '3 Models', title: 'Impact Gloves', url: '/category/30', img: '/media-library/0000025056864_1.png' },
  { id: 24, code: 'AP-J', count: '7 Models', title: 'Leather Welding Jackets', url: '/category/24', img: '/media-library/jek.png' },
  { id: 25, code: 'AP-T', count: '7 Models', title: 'Leather Welding Trousers', url: '/category/25', img: '/media-library/pant.png' },
  { id: 31, code: 'COTN', count: '1 Model', title: 'Cotton Gloves', url: '/category/31', img: '/media-library/cotton_new.png' },
  { id: 32, code: 'GARD', count: '12 Models', title: 'Gardening Gloves', url: '/category/32', img: '/media-library/GG1_F.png' }
];

const stats = [
  { icon: 'fas fa-users-cog', value: '153', num: 153, suffix: '', title: 'Skilled Production Craftsmen', spec: 'FACILITY WORKFORCE' },
  { icon: 'fas fa-industry', value: '1,530', num: 1530, suffix: ' m²', title: 'Square Meters Manufacturing Floor', spec: 'SAVAR PLANT AREA' },
  { icon: 'fas fa-shield-alt', value: '12,750', num: 12750, suffix: ' Dz', title: 'Dozen Gloves Produced Monthly', spec: 'EXPORT CAPACITY' },
  { icon: 'fas fa-globe-americas', value: '5M+', num: 5, suffix: ' Pairs', title: 'Industrial Gloves Exported Globally', spec: 'TOTAL OUTPUT' }
];
---

<BaseLayout title={`${BRAND.companyName} — Protecting Hands, Building Futures`} currentPath="/">
  <!-- 1. Hero Section with High-Contrast Scrim & Tabular Nav -->
  <HeroSlider />

  <!-- 2. Dark Industrial Working Process Timeline (#0B1118 Carbon-Steel) -->
  <section class="industrial-timeline-section" aria-label="Manufacturing process workflow">
    <div class="container">
      <div class="timeline-header-block text-center">
        <div class="kicker-tag font-mono">
          <span class="crimson-dot"></span>
          <span>MANUFACTURING INTEGRITY // 4-STAGE TECHNICAL WORKFLOW</span>
        </div>
        <h2 class="timeline-main-title">
          The Industrial Production Process
        </h2>
        <p class="timeline-intro-text">
          Precision execution at every manufacturing milestone ensures maximum abrasion resistance, ergonomic grip comfort, and compliance with international PPE standards.
        </p>
      </div>

      <div class="row g-4 timeline-cards-row">
        {workingProcess.map((proc) => (
          <div class="col-xl-3 col-md-6 col-12">
            <div class="timeline-step-card">
              <!-- Step Header -->
              <div class="step-card-meta">
                <span class="step-counter-tabular font-mono">{proc.step}</span>
                <span class="step-code-badge font-mono">{proc.code}</span>
              </div>

              <!-- Process Image Well -->
              <div class="timeline-img-box">
                <img
                  src={proc.img}
                  alt={proc.title}
                  width="300"
                  height="200"
                  loading="lazy"
                  decoding="async"
                  class="timeline-img"
                />
                <div class="timeline-img-overlay"></div>
              </div>

              <!-- Content -->
              <div class="step-card-body">
                <h3 class="step-title">
                  <a href={proc.url} class="step-title-link">{proc.title}</a>
                </h3>
                <div class="step-subtitle font-mono">{proc.subtitle}</div>
                <p class="step-desc">{proc.desc}</p>
                <a href={proc.url} class="step-link font-mono">
                  <span>View Process Specs</span>
                  <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. Certified Product Categories Grid (Standardized 4:3 Studio Wells) -->
  <section class="categories-studio-section" aria-label="Industrial PPE Product Categories">
    <div class="container">
      <!-- Section Title Area -->
      <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5">
        <div>
          <div class="kicker-tag font-mono">
            <span class="crimson-dot"></span>
            <span>DIRECT FACTORY CATALOG // 13 CERTIFIED PPE LINES</span>
          </div>
          <h2 class="section-heading-barlow">
            Certified Industrial Glove Categories
          </h2>
          <p class="section-subtext">
            Standardized technical studio view of our heavy industrial work, welding, split, and driver glove lines.
          </p>
        </div>
        <div class="mt-3 mt-md-0">
          <a href="/category/20" class="btn-steel-outline font-mono">
            <span>View All 123 Models</span>
            <i class="fas fa-arrow-right" aria-hidden="true"></i>
          </a>
        </div>
      </div>

      <!-- Categories 4:3 Studio Well Grid -->
      <div class="row g-4">
        {categoryTiles.map((cat) => (
          <div class="col-xl-4 col-md-6 col-12">
            <a href={cat.url} class="category-product-card" aria-label={`View ${cat.title} (${cat.count})`}>
              <!-- 4:3 Studio Well Image Container -->
              <div class="studio-product-well">
                <div class="category-well-badge font-mono">
                  <span class="cat-code">{cat.code}</span>
                  <span class="cat-count">{cat.count}</span>
                </div>
                <img
                  src={cat.img}
                  alt={cat.title}
                  loading="lazy"
                  decoding="async"
                  class="category-well-img"
                />
              </div>

              <!-- Card Info Footer -->
              <div class="category-card-footer">
                <div class="d-flex align-items-center justify-content-between">
                  <h3 class="category-card-title">{cat.title}</h3>
                  <span class="category-card-action font-mono">
                    <i class="fas fa-arrow-right text-crimson" aria-hidden="true"></i>
                  </span>
                </div>
                <div class="category-card-route font-mono">{cat.url}</div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Factory Provenance & Production Capability Teaser (Purged of Legacy Claims) -->
  <section class="factory-provenance-section" aria-label="Company manufacturing credentials">
    <div class="container">
      <div class="row g-5 align-items-center">
        <!-- Left Column: Architectural Profile -->
        <div class="col-lg-6 col-12">
          <div class="provenance-content-block">
            <div class="kicker-tag font-mono">
              <span class="crimson-dot"></span>
              <span>MANUFACTURING PROVENANCE // SAVAR, HEMAYETPUR</span>
            </div>

            <h2 class="provenance-heading">
              Dedicated Leather PPE Exporter with Direct Factory Control
            </h2>

            <p class="provenance-lead">
              <strong>MAX GLOVES BD LTD.</strong> operates a specialized 1,530 m² manufacturing plant in Savar, Hemayetpur, Bangladesh, supplying certified personal protective equipment to leading safety distributors across Asia, Europe, and the Americas.
            </p>

            <p class="provenance-body">
              By controlling raw leather grading, precision die cutting, Kevlar-thread assembly, and export quality verification in-house, we eliminate intermediary costs while ensuring strict compliance with EN 388 mechanical and EN 407 thermal resistance standards.
            </p>

            <div class="provenance-points-grid">
              <div class="point-item">
                <i class="fas fa-check-circle text-crimson" aria-hidden="true"></i>
                <div>
                  <strong>OEM / ODM Customization</strong>
                  <span>Private labeling, custom leather dyeing, and bespoke cuff sizing.</span>
                </div>
              </div>
              <div class="point-item">
                <i class="fas fa-check-circle text-crimson" aria-hidden="true"></i>
                <div>
                  <strong>Direct Export Procurement</strong>
                  <span>Transparent FOB pricing, rapid sample dispatch, and container shipping.</span>
                </div>
              </div>
            </div>

            <div class="provenance-action-group mt-4">
              <a href="/about" class="btn-crimson font-mono">
                <span>READ COMPANY PROFILE</span>
                <i class="fas fa-arrow-right" aria-hidden="true"></i>
              </a>
              <a href="/facilities" class="btn-steel-outline font-mono">
                <span>INSPECT SAVAR FACTORY</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Column: Savar Facility Tour Image Well -->
        <div class="col-lg-6 col-12">
          <div class="facility-preview-card">
            <div class="facility-img-frame">
              <img
                src="/front-end/img/max_cover.png"
                alt="Max Gloves BD Ltd. Savar Manufacturing Plant"
                loading="lazy"
                decoding="async"
                class="facility-main-img"
              />
              <div class="facility-badge-strip font-mono">
                <i class="fas fa-industry text-crimson" aria-hidden="true"></i>
                <span>PLANT: SAVAR, HEMAYETPUR, DHAKA // BANGLADESH</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Tabular Key Metrics Strip (Dark Carbon-Steel #0B1118) -->
  <section class="industrial-metrics-section" aria-label="Key manufacturing capacity metrics">
    <div class="container">
      <div class="row g-4">
        {stats.map((st) => (
          <div class="col-xl-3 col-sm-6 col-12">
            <div class="metric-card">
              <div class="metric-card-top font-mono">
                <span class="metric-spec">{st.spec}</span>
                <i class={`${st.icon} text-crimson`} aria-hidden="true"></i>
              </div>
              <div class="metric-value font-mono">
                {st.value}{st.suffix}
              </div>
              <div class="metric-title">{st.title}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Bordered Trust Grid: Certifications & Compliance -->
  <CertificationSlider />
</BaseLayout>

<style>
  /* Kicker / Badge Utility */
  .kicker-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    letter-spacing: 0.08em;
    color: var(--color-text-muted, #64748B);
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 5px 12px;
    border-radius: 4px;
    margin-bottom: 14px;
  }
  .crimson-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-crimson, #C81E1E);
    display: inline-block;
  }

  /* Section Headings */
  .section-heading-barlow {
    font-size: clamp(28px, 3.8vw, 42px);
    font-weight: 800;
    color: var(--color-steel, #0B1118);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .section-subtext {
    color: var(--color-text-muted, #64748B);
    font-size: 15.5px;
    max-width: 680px;
    margin: 0;
  }

  /* 2. Timeline Section (Dark Carbon-Steel #0B1118) */
  .industrial-timeline-section {
    background-color: var(--color-steel, #0B1118);
    border-top: 1px solid var(--color-steel-border, #223242);
    border-bottom: 1px solid var(--color-steel-border, #223242);
    padding: 90px 0 100px;
  }
  .timeline-header-block {
    max-width: 760px;
    margin: 0 auto 60px;
  }
  .timeline-header-block .kicker-tag {
    background: #15202B;
    border-color: #223242;
    color: #94A3B8;
  }
  .timeline-main-title {
    color: #FFFFFF !important;
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 800;
    margin-bottom: 14px;
  }
  .timeline-intro-text {
    color: #94A3B8;
    font-size: 16px;
    line-height: 1.6;
    margin: 0;
  }

  .timeline-step-card {
    background: #15202B;
    border: 1px solid #223242;
    border-radius: 4px;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }
  .timeline-step-card:hover {
    transform: translateY(-4px);
    border-color: #334155;
  }
  .step-card-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    border-bottom: 1px solid #223242;
    background: #0B1118;
  }
  .step-counter-tabular {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-crimson, #C81E1E);
  }
  .step-code-badge {
    font-size: 11px;
    color: #94A3B8;
    background: #1E293B;
    padding: 3px 8px;
    border-radius: 3px;
    border: 1px solid #334155;
  }

  .timeline-img-box {
    position: relative;
    height: 180px;
    overflow: hidden;
    background: #000;
  }
  .timeline-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .timeline-step-card:hover .timeline-img {
    transform: scale(1.05);
  }
  .timeline-img-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 50%, rgba(11, 17, 24, 0.8) 100%);
  }

  .step-card-body {
    padding: 20px 18px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .step-title {
    margin: 0 0 4px;
  }
  .step-title-link {
    font-size: 18px;
    font-weight: 700;
    color: #FFFFFF;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .step-title-link:hover {
    color: var(--color-crimson, #C81E1E);
  }
  .step-subtitle {
    font-size: 12px;
    color: #94A3B8;
    margin-bottom: 12px;
  }
  .step-desc {
    color: #CBD5E1;
    font-size: 13.5px;
    line-height: 1.55;
    flex: 1;
    margin-bottom: 16px;
  }
  .step-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-crimson, #C81E1E);
    font-size: 12.5px;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.2s ease;
  }
  .step-link:hover {
    gap: 12px;
    color: #FFFFFF;
  }

  /* 3. Product Categories Section */
  .categories-studio-section {
    background-color: var(--color-canvas, #F8FAFC);
    padding: 90px 0 100px;
  }
  .category-product-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    overflow: hidden;
    transition: all 0.2s ease;
  }
  .category-product-card:hover {
    border-color: var(--color-border-dark, #CBD5E1);
    box-shadow: 0 8px 24px rgba(11, 17, 24, 0.06);
    transform: translateY(-2px);
  }
  .category-product-card:focus-visible {
    outline: 2px solid var(--color-crimson, #C81E1E) !important;
    outline-offset: 2px;
  }

  .category-product-card .studio-product-well {
    border: none;
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    border-radius: 0;
    height: 250px;
    aspect-ratio: auto;
  }
  .category-well-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 3px;
    padding: 3px 8px;
    font-size: 11px;
    z-index: 2;
  }
  .cat-code {
    font-weight: 700;
    color: var(--color-crimson, #C81E1E);
  }
  .cat-count {
    color: var(--color-text-muted, #64748B);
  }

  .category-well-img {
    max-height: 82%;
    max-width: 88%;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .category-product-card:hover .category-well-img {
    transform: scale(1.05);
  }

  .category-card-footer {
    padding: 16px 20px 18px;
  }
  .category-card-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-steel, #0B1118);
    margin: 0;
    transition: color 0.15s ease;
  }
  .category-product-card:hover .category-card-title {
    color: var(--color-crimson, #C81E1E);
  }
  .category-card-route {
    font-size: 11.5px;
    color: var(--color-text-muted, #64748B);
    margin-top: 4px;
  }

  /* 4. Factory Provenance Section */
  .factory-provenance-section {
    background: #FFFFFF;
    border-top: 1px solid var(--color-border, #E2E8F0);
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    padding: 95px 0 100px;
  }
  .provenance-heading {
    font-size: clamp(28px, 3.8vw, 42px);
    font-weight: 800;
    color: var(--color-steel, #0B1118);
    letter-spacing: -0.02em;
    margin-bottom: 18px;
  }
  .provenance-lead {
    font-size: 16.5px;
    line-height: 1.6;
    color: #1E293B;
    margin-bottom: 14px;
  }
  .provenance-body {
    font-size: 15px;
    line-height: 1.65;
    color: var(--color-text-muted, #64748B);
    margin-bottom: 24px;
  }
  .provenance-points-grid {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 28px;
  }
  .point-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 14.5px;
  }
  .point-item i {
    font-size: 18px;
    margin-top: 3px;
  }
  .point-item strong {
    display: block;
    color: var(--color-steel, #0B1118);
  }
  .point-item span {
    color: var(--color-text-muted, #64748B);
  }
  .provenance-action-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .facility-img-frame {
    position: relative;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    overflow: hidden;
    background: var(--color-canvas, #F8FAFC);
  }
  .facility-main-img {
    width: 100%;
    height: auto;
    display: block;
  }
  .facility-badge-strip {
    background: #0B1118;
    color: #E2E8F0;
    padding: 10px 16px;
    font-size: 11.5px;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.05em;
  }

  /* 5. Metrics Section */
  .industrial-metrics-section {
    background-color: var(--color-steel, #0B1118);
    border-bottom: 1px solid var(--color-steel-border, #223242);
    padding: 60px 0;
  }
  .metric-card {
    background: #15202B;
    border: 1px solid #223242;
    border-radius: 4px;
    padding: 24px;
    height: 100%;
  }
  .metric-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 10px;
  }
  .metric-spec {
    font-size: 11px;
    color: #64748B;
    letter-spacing: 0.08em;
  }
  .metric-value {
    font-size: 36px;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .metric-title {
    color: #94A3B8;
    font-size: 14px;
  }
</style>
