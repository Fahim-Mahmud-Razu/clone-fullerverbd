---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import categories from '../../data/categories.json';
import products from '../../data/products.json';
import BRAND from '../../config/site';

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { id: cat.id.toString() },
    props: { category: cat }
  }));
}

interface Props {
  category: {
    id: number;
    title: string;
    slug: string;
    route: string;
    tile_image: string;
    product_ids: number[];
  };
}

const { category } = Astro.props;

// Filter products in exact ordered list
const categoryProducts = category.product_ids
  .map((pid) => products.find((p) => p.id === pid))
  .filter((p): p is typeof products[0] => Boolean(p));
---

<BaseLayout title={`${category.title} — ${BRAND.companyName}`} currentPath={category.route}>
  <PageBanner
    title={category.title}
    breadcrumbs={[{ label: 'Home', url: '/' }, { label: 'Glove Catalog', url: '/category/20' }, { label: category.title }]}
  />

  <section class="category-catalog-section" aria-label={`${category.title} Catalog`}>
    <div class="container">
      <!-- Category Catalog Header -->
      <div class="category-header-bar d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 pb-3">
        <div>
          <div class="font-mono text-muted text-uppercase" style="font-size: 11.5px; letter-spacing: 0.08em; margin-bottom: 6px;">
            CATEGORY REF // CAT-{category.id.toString().padStart(2, '0')}
          </div>
          <h2 class="category-page-title">{category.title}</h2>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center gap-3">
          <span class="catalog-count-pill font-mono">
            {categoryProducts.length} CERTIFIED MODELS
          </span>
          <a href="/contact" class="btn-crimson font-mono" style="padding: 9px 18px; font-size: 13px;">
            <i class="far fa-paper-plane" aria-hidden="true"></i>
            <span>REQUEST CATEGORY RFQ</span>
          </a>
        </div>
      </div>

      <!-- Standardized 4:3 Studio Wells Product Grid -->
      <div class="row g-4">
        {categoryProducts.map((prod) => (
          <div class="col-xl-4 col-md-6 col-6">
            <a href={`/product/${prod.id}`} class="product-item-card" aria-label={`View ${prod.title} (SKU: ${prod.sku || prod.id})`}>
              <!-- 4:3 Studio Well -->
              <div class="studio-product-well">
                <div class="product-well-badges font-mono">
                  <span class="badge-sku">SKU: #{prod.sku || prod.id}</span>
                  {prod.sprite_image && <span class="badge-3d">3D VIEW</span>}
                </div>
                <img
                  src={prod.preview_image || prod.sprite_image}
                  alt={prod.title}
                  loading="lazy"
                  decoding="async"
                  class="product-well-img"
                />
              </div>

              <!-- Product Info Card Body -->
              <div class="product-card-body">
                <div class="product-cat-kicker font-mono">{category.title}</div>
                <h3 class="product-card-title">{prod.title}</h3>
                <div class="product-card-action font-mono">
                  <span>Inspect Specifications</span>
                  <i class="fas fa-arrow-right text-crimson" aria-hidden="true"></i>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-catalog-section {
    background-color: var(--color-canvas, #F8FAFC);
    padding: 70px 0 90px;
  }

  .category-header-bar {
    border-bottom: 1px solid var(--color-border, #E2E8F0);
  }
  .category-page-title {
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 800;
    color: var(--color-steel, #0B1118);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .catalog-count-pill {
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 11.5px;
    color: var(--color-steel, #0B1118);
    font-weight: 600;
  }

  /* Product Card Container */
  .product-item-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    overflow: hidden;
    height: 100%;
    transition: all 0.2s ease;
  }
  .product-item-card:hover {
    border-color: var(--color-border-dark, #CBD5E1);
    box-shadow: 0 8px 24px rgba(11, 17, 24, 0.06);
    transform: translateY(-2px);
  }
  .product-item-card:focus-visible {
    outline: 2px solid var(--color-crimson, #C81E1E) !important;
    outline-offset: 2px;
  }

  /* 4:3 Studio Well */
  .product-item-card .studio-product-well {
    border: none;
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    border-radius: 0;
    aspect-ratio: 4 / 3;
    background: var(--color-well, #F1F5F9);
    position: relative;
    padding: 24px;
  }

  .product-well-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    gap: 6px;
    z-index: 2;
  }
  .badge-sku {
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 3px 7px;
    border-radius: 3px;
    font-size: 11px;
    color: var(--color-steel, #0B1118);
    font-weight: 600;
  }
  .badge-3d {
    background: #0B1118;
    color: #FFFFFF;
    padding: 3px 7px;
    border-radius: 3px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
  }

  .product-well-img {
    max-height: 85%;
    max-width: 88%;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .product-item-card:hover .product-well-img {
    transform: scale(1.06);
  }

  .product-card-body {
    padding: 18px 20px 22px;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .product-cat-kicker {
    font-size: 11px;
    color: var(--color-text-muted, #64748B);
    letter-spacing: 0.04em;
    margin-bottom: 6px;
  }
  .product-card-title {
    font-size: 16.5px;
    font-weight: 700;
    color: var(--color-steel, #0B1118);
    margin: 0 0 16px;
    line-height: 1.35;
    transition: color 0.15s ease;
  }
  .product-item-card:hover .product-card-title {
    color: var(--color-crimson, #C81E1E);
  }
  .product-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-steel, #0B1118);
    padding-top: 12px;
    border-top: 1px solid var(--color-border, #E2E8F0);
  }

  @media (max-width: 767px) {
    .category-catalog-section {
      padding: 40px 0 60px;
    }
    .product-card-body {
      padding: 10px 10px 12px;
    }
    .product-card-title {
      font-size: 13px;
      margin: 0 0 8px;
      line-height: 1.3;
    }
    .product-card-action {
      font-size: 11px;
      padding-top: 8px;
    }
    .product-item-card .studio-product-well {
      padding: 12px;
    }
    .badge-sku {
      font-size: 9.5px;
      padding: 2px 5px;
    }
  }
</style>
