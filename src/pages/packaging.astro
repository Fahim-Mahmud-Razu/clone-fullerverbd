---
import ProcessLayout from '../components/ProcessLayout.astro';

const images = [
  '/front-end/img/workingprocess/pa/01.jpg',
  '/front-end/img/workingprocess/pa/02.jpg',
  '/front-end/img/workingprocess/pa/03.jpg',
  '/front-end/img/workingprocess/pa/04.jpg'
];

const paragraphs = [
  'After the gloves come from sewing, we have two quality checks. One for checking the stitching and trimming, and we invert the glove to send them to our ironing stations. A final inspection of any faults or defects is done before sending gloves to our metal detector. At the metal detector we check every finished gloves so there is no contamination in our packaging, and to ensure it arrives on time with consistent high quality',
  'Finally the gloves are prepared and packaged in boxes where they will be sent to the warehouse awaiting to be shipped to our customers. We have an internal import and export department to manage all our shipment, enabling Max Gloves BD Ltd. to provide the best service possible to our customers.'
];
---

<ProcessLayout
  title="Packaging"
  subtitle="Packaging"
  currentPath="/packaging"
  images={images}
  paragraphs={paragraphs}
/>
