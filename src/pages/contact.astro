---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import BRAND from '../config/site';
---

<BaseLayout title={`Contact Us & Factory RFQ — ${BRAND.companyName}`} currentPath="/contact">
  <PageBanner title="Contact & Factory RFQ" breadcrumbs={[{ label: 'Home', url: '/' }, { label: 'Contact Us' }]} />

  <section class="contact-architectural-section" aria-label="Contact information and RFQ inquiry form">
    <div class="container">
      <div class="row g-5">
        <!-- Main Form & Map Column (col-lg-8) -->
        <div class="col-lg-8">
          <div class="contact-main-flow">
            <!-- Google Maps Embed: Office Location -->
            <div class="map-structural-frame">
              <div class="map-meta-strip font-mono">
                <i class="fas fa-map-marker-alt text-crimson" aria-hidden="true"></i>
                <span>CORPORATE HEADQUARTERS // 585/C KHILGAON, DHAKA-1219, BANGLADESH</span>
              </div>
              <iframe
                src="https://maps.google.com/maps?q=585%2FC%2C+Khilgaon%2C+C+Block%2C+Dhaka-1219%2C+Bangladesh&t=&z=15&ie=UTF8&iwloc=&output=embed"
                width="100%"
                height="380"
                style="border:0; display: block;"
                allowfullscreen=""
                loading="lazy"
                title="Max Gloves BD Ltd. Corporate Office Location Map"
              ></iframe>
            </div>

            <!-- Architectural Contact & RFQ Form -->
            <div class="contact-form-card">
              <div class="form-header-block">
                <div class="kicker-tag font-mono">
                  <span class="crimson-dot"></span>
                  <span>PROCUREMENT & OEM INQUIRIES // DIRECT SALES DESK</span>
                </div>
                <h2 class="form-title">
                  Send Factory RFQ or Specification Inquiry
                </h2>
                <p class="form-subtitle">
                  Inquire about bulk leather glove container orders, custom branding/OEM specifications, EN standard certificates, or sample dispatches.
                </p>
              </div>

              <form class="contact-form-box" id="contactForm" novalidate>
                <div class="row g-4">
                  <!-- Name -->
                  <div class="col-md-6 col-12">
                    <div class="input-field-group">
                      <label for="nameInput" class="field-label font-mono">
                        <span>FULL NAME</span>
                        <span class="required-star text-crimson">*</span>
                      </label>
                      <input
                        type="text"
                        class="form-control-architectural"
                        name="name"
                        id="nameInput"
                        placeholder="e.g. John Doe"
                        required
                        autocomplete="name"
                      />
                    </div>
                  </div>

                  <!-- Email -->
                  <div class="col-md-6 col-12">
                    <div class="input-field-group">
                      <label for="emailInput" class="field-label font-mono">
                        <span>BUSINESS EMAIL</span>
                        <span class="required-star text-crimson">*</span>
                      </label>
                      <input
                        type="email"
                        class="form-control-architectural"
                        name="email"
                        id="emailInput"
                        placeholder="e.g. procurement@company.com"
                        required
                        autocomplete="email"
                      />
                    </div>
                  </div>

                  <!-- Phone -->
                  <div class="col-md-6 col-12">
                    <div class="input-field-group">
                      <label for="phoneInput" class="field-label font-mono">
                        <span>PHONE / WHATSAPP</span>
                      </label>
                      <input
                        type="tel"
                        class="form-control-architectural"
                        name="phone"
                        id="phoneInput"
                        placeholder="e.g. +1 555-0199"
                        autocomplete="tel"
                      />
                    </div>
                  </div>

                  <!-- Subject -->
                  <div class="col-md-6 col-12">
                    <div class="input-field-group">
                      <label for="subjectInput" class="field-label font-mono">
                        <span>INQUIRY SUBJECT / SKU</span>
                        <span class="required-star text-crimson">*</span>
                      </label>
                      <input
                        type="text"
                        class="form-control-architectural"
                        name="subject"
                        id="subjectInput"
                        placeholder="e.g. Quotation for Leather Welding Gloves SKU #163"
                        required
                      />
                    </div>
                  </div>

                  <!-- Message -->
                  <div class="col-12">
                    <div class="input-field-group">
                      <label for="commentInput" class="field-label font-mono">
                        <span>DETAILED INQUIRY & SPECIFICATIONS</span>
                        <span class="required-star text-crimson">*</span>
                      </label>
                      <textarea
                        class="form-control-architectural textarea-control"
                        name="comment"
                        id="commentInput"
                        rows="6"
                        placeholder="Please state expected quantity, destination port (FOB Chittagong), leather thickness requirement, and delivery timeline."
                        required
                      ></textarea>
                    </div>
                  </div>

                  <!-- Submit Action -->
                  <div class="col-12">
                    <button
                      type="submit"
                      class="btn-crimson font-mono"
                      id="submitBtn"
                      style="padding: 14px 32px; font-size: 14px;"
                    >
                      <i class="far fa-paper-plane" aria-hidden="true"></i>
                      <span>SUBMIT INQUIRY FOR DISPATCH</span>
                    </button>
                  </div>
                </div>

                <div id="formStatus" class="form-feedback-area" role="alert" aria-live="polite"></div>
              </form>
            </div>
          </div>
        </div>

        <!-- Sidebar Column (col-lg-4) -->
        <div class="col-lg-4">
          <div class="contact-sidebar-stack">
            <!-- 1. Direct Sales & Export Desk Card -->
            <div class="sidebar-info-card">
              <div class="card-kicker font-mono">
                <i class="fas fa-headset text-crimson" aria-hidden="true"></i>
                <span>DIRECT EXPORT PROCUREMENT</span>
              </div>
              <h3 class="sidebar-card-title">Commercial & Sales Desk</h3>
              <p class="sidebar-card-desc">
                Contact our international trade team directly for instant pricing sheets, material grade samples, or factory video inspections.
              </p>

              <div class="sidebar-channel-list">
                <div class="channel-row">
                  <i class="fab fa-whatsapp text-whatsapp" aria-hidden="true" style="color: #25D366; font-size: 16px;"></i>
                  <div>
                    <span class="channel-kicker font-mono">DIRECT PHONE & WHATSAPP</span>
                    <a
                      href={BRAND.whatsappUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="channel-link font-mono"
                      title={`Chat on WhatsApp (${BRAND.phone})`}
                    >
                      {BRAND.phone}
                    </a>
                  </div>
                </div>

                <div class="channel-row">
                  <i class="far fa-envelope text-crimson" aria-hidden="true"></i>
                  <div>
                    <span class="channel-kicker font-mono">SALES INBOX</span>
                    <a href={BRAND.emailMailto} class="channel-link font-mono">{BRAND.email}</a>
                  </div>
                </div>

                <div class="channel-row">
                  <i class="fas fa-globe text-crimson" aria-hidden="true"></i>
                  <div>
                    <span class="channel-kicker font-mono">WEBSITE PORTAL</span>
                    <span class="channel-static font-mono">{BRAND.website}</span>
                  </div>
                </div>
              </div>

              <div class="mt-4 pt-3 border-top">
                <button type="button" class="btn-steel-outline font-mono w-100 justify-content-center" id="vcOpenBtn">
                  <i class="far fa-id-card text-crimson" aria-hidden="true"></i>
                  <span>VIEW OFFICIAL BUSINESS CARD</span>
                </button>
              </div>
            </div>

            <!-- 2. Headquarters Facility Card -->
            <div class="sidebar-info-card">
              <div class="card-kicker font-mono">
                <i class="fas fa-building text-crimson" aria-hidden="true"></i>
                <span>CORPORATE HEADQUARTERS</span>
              </div>
              <h4 class="facility-name">Dhaka Corporate Office</h4>
              <p class="facility-address">
                {BRAND.officeAddress}
              </p>
              <div class="facility-spec font-mono">
                ADMINISTRATION & EXPORT DOCUMENTATION
              </div>
            </div>

            <!-- 3. Factory Plant Facility Card -->
            <div class="sidebar-info-card">
              <div class="card-kicker font-mono">
                <i class="fas fa-industry text-crimson" aria-hidden="true"></i>
                <span>MANUFACTURING FACILITY</span>
              </div>
              <h4 class="facility-name">Savar Production Plant</h4>
              <p class="facility-address">
                {BRAND.factoryAddress}
              </p>
              <div class="facility-spec font-mono">
                1,530 M² FLOOR // CUTTING, SEWING & EXPORT PACKAGING
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Business Card Modal Dialog -->
  <dialog id="vcDialog" class="architectural-modal-dialog">
    <div class="modal-dialog-inner">
      <div class="dialog-header">
        <span class="font-mono text-muted" style="font-size: 11px;">MAX GLOVES BD LTD. // OFFICIAL BUSINESS CARD</span>
        <button type="button" class="modal-close-btn" id="vcCloseBtn" aria-label="Close dialog">&times;</button>
      </div>
      <div class="dialog-body text-center">
        <img
          src="/front-end/img/max-visiting-card.png"
          alt="Max Gloves BD Ltd. Official Business Card"
          loading="lazy"
          class="business-card-img"
        />
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  .contact-architectural-section {
    background-color: var(--color-canvas, #F8FAFC);
    padding: 75px 0 100px;
  }

  /* Map Frame */
  .map-structural-frame {
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 30px;
    background: #FFFFFF;
  }
  .map-meta-strip {
    background: #0B1118;
    color: #CBD5E1;
    padding: 10px 16px;
    font-size: 11px;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: 0.05em;
  }

  /* Form Card */
  .contact-form-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    padding: 36px;
  }
  .form-header-block {
    margin-bottom: 28px;
  }
  .form-title {
    font-size: clamp(24px, 3.2vw, 34px);
    font-weight: 800;
    color: var(--color-steel, #0B1118);
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }
  .form-subtitle {
    color: var(--color-text-muted, #64748B);
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }

  /* Form Controls & Accessible Labels */
  .input-field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field-label {
    font-size: 11.5px;
    font-weight: 600;
    color: var(--color-steel, #0B1118);
    letter-spacing: 0.04em;
  }
  .form-control-architectural {
    height: 48px;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    padding: 10px 16px;
    font-family: var(--font-body);
    font-size: 14.5px;
    color: var(--color-steel, #0B1118);
    background: var(--color-well, #F1F5F9);
    transition: all 0.2s ease;
    width: 100%;
  }
  .form-control-architectural:focus {
    background: #FFFFFF;
    border-color: var(--color-crimson, #C81E1E);
    outline: none;
    box-shadow: 0 0 0 3px rgba(200, 30, 30, 0.12);
  }
  .textarea-control {
    height: auto;
    resize: vertical;
    padding: 14px 16px;
  }

  .form-feedback-area {
    margin-top: 20px;
  }

  /* Sidebar Cards */
  .contact-sidebar-stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .sidebar-info-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    padding: 24px;
  }
  .card-kicker {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 10.5px;
    color: var(--color-text-muted, #64748B);
    letter-spacing: 0.08em;
    margin-bottom: 10px;
  }
  .sidebar-card-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-steel, #0B1118);
    margin-bottom: 6px;
  }
  .sidebar-card-desc {
    color: var(--color-text-muted, #64748B);
    font-size: 13.5px;
    line-height: 1.5;
    margin-bottom: 18px;
  }

  .sidebar-channel-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .channel-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    background: var(--color-well, #F1F5F9);
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 10px 14px;
    border-radius: 4px;
  }
  .channel-row i {
    font-size: 15px;
    margin-top: 3px;
  }
  .channel-kicker {
    display: block;
    font-size: 10px;
    color: var(--color-text-muted, #64748B);
    letter-spacing: 0.06em;
  }
  .channel-link {
    color: var(--color-steel, #0B1118);
    font-size: 13.5px;
    font-weight: 600;
    text-decoration: none;
  }
  .channel-link:hover {
    color: var(--color-crimson, #C81E1E);
  }
  .channel-static {
    color: var(--color-steel, #0B1118);
    font-size: 13.5px;
  }

  .facility-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-steel, #0B1118);
    margin-bottom: 4px;
  }
  .facility-address {
    color: var(--color-text-body, #334155);
    font-size: 14px;
    line-height: 1.45;
    margin-bottom: 10px;
  }
  .facility-spec {
    font-size: 10.5px;
    color: #64748B;
    background: var(--color-well, #F1F5F9);
    padding: 4px 8px;
    border-radius: 3px;
    border: 1px solid var(--color-border, #E2E8F0);
    display: inline-block;
  }

  /* Modal Dialog */
  .architectural-modal-dialog {
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 6px;
    padding: 0;
    box-shadow: 0 16px 40px rgba(11, 17, 24, 0.2);
    max-width: 620px;
    width: 90%;
  }
  .architectural-modal-dialog::backdrop {
    background: rgba(11, 17, 24, 0.7);
    backdrop-filter: blur(4px);
  }
  .modal-dialog-inner {
    background: #FFFFFF;
  }
  .dialog-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    background: #0B1118;
  }
  .modal-close-btn {
    background: transparent;
    border: none;
    color: #CBD5E1;
    font-size: 24px;
    cursor: pointer;
    line-height: 1;
    padding: 0;
  }
  .dialog-body {
    padding: 24px;
  }
  .business-card-img {
    width: 100%;
    height: auto;
    border-radius: 4px;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
  }

  @media (max-width: 767px) {
    .contact-form-card {
      padding: 22px 18px;
    }
  }
</style>

<script>
  function initContactPageScript() {
    // Check URL parameters for pre-filling SKU
    const urlParams = new URLSearchParams(window.location.search);
    const skuParam = urlParams.get('sku');
    const subjectEl = document.getElementById('subjectInput') as HTMLInputElement | null;
    if (skuParam && subjectEl) {
      subjectEl.value = `Quotation Request for Model ${skuParam}`;
    }

    // Modal dialog handling
    const vcOpenBtn = document.getElementById('vcOpenBtn');
    const vcCloseBtn = document.getElementById('vcCloseBtn');
    const vcDialog = document.getElementById('vcDialog') as HTMLDialogElement | null;

    if (vcOpenBtn && vcDialog) {
      vcOpenBtn.addEventListener('click', () => {
        vcDialog.showModal();
      });
    }
    if (vcCloseBtn && vcDialog) {
      vcCloseBtn.addEventListener('click', () => {
        vcDialog.close();
      });
    }
    if (vcDialog) {
      vcDialog.addEventListener('click', (e) => {
        if (e.target === vcDialog) vcDialog.close();
      });
    }

    // Form submission validation & transparent fallback
    const contactForm = document.getElementById('contactForm') as HTMLFormElement | null;
    const formStatus = document.getElementById('formStatus');

    if (contactForm && formStatus) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameEl = document.getElementById('nameInput') as HTMLInputElement | null;
        const emailEl = document.getElementById('emailInput') as HTMLInputElement | null;
        const phoneEl = document.getElementById('phoneInput') as HTMLInputElement | null;
        const commentEl = document.getElementById('commentInput') as HTMLTextAreaElement | null;

        const name = nameEl?.value.trim() || '';
        const email = emailEl?.value.trim() || '';
        const phone = phoneEl?.value.trim() || '';
        const subject = subjectEl?.value.trim() || '';
        const comment = commentEl?.value.trim() || '';

        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

        if (!name || name.length < 2) {
          formStatus.innerHTML = `
            <div style="color: #991B1B; background: #FEF2F2; border: 1px solid #F87171; padding: 14px; border-radius: 4px; font-weight: 600; font-size: 14px;">
              <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> Please provide your full name (minimum 2 characters).
            </div>
          `;
          nameEl?.focus();
          return;
        }

        if (!emailPattern.test(email)) {
          formStatus.innerHTML = `
            <div style="color: #991B1B; background: #FEF2F2; border: 1px solid #F87171; padding: 14px; border-radius: 4px; font-weight: 600; font-size: 14px;">
              <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> Please enter a valid business email address.
            </div>
          `;
          emailEl?.focus();
          return;
        }

        if (!subject || subject.length < 3) {
          formStatus.innerHTML = `
            <div style="color: #991B1B; background: #FEF2F2; border: 1px solid #F87171; padding: 14px; border-radius: 4px; font-weight: 600; font-size: 14px;">
              <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> Please enter an inquiry subject or product SKU.
            </div>
          `;
          subjectEl?.focus();
          return;
        }

        if (!comment || comment.length < 5) {
          formStatus.innerHTML = `
            <div style="color: #991B1B; background: #FEF2F2; border: 1px solid #F87171; padding: 14px; border-radius: 4px; font-weight: 600; font-size: 14px;">
              <i class="fas fa-exclamation-triangle" aria-hidden="true"></i> Please provide details regarding your inquiry or requirements.
            </div>
          `;
          commentEl?.focus();
          return;
        }

        // Construct pre-filled email inquiry for honest transparent direct-dispatch
        const emailBody = `Name: ${name}\nEmail: ${email}\nPhone: ${phone || 'N/A'}\nSubject: ${subject}\n\nMessage:\n${comment}\n\n---\nDispatched via MAX GLOVES BD LTD. Exporter Portal`;
        const mailtoLink = `mailto:maxglovesbdltd@gmail.com?subject=${encodeURIComponent(`[RFQ Inquiry] ${subject}`)}&body=${encodeURIComponent(emailBody)}`;

        formStatus.innerHTML = `
          <div style="background: #F8FAFC; border: 1px solid #CBD5E1; border-radius: 4px; padding: 24px; margin-top: 24px;">
            <div style="display: flex; align-items: flex-start; gap: 14px;">
              <i class="fas fa-info-circle text-crimson" style="font-size: 24px; margin-top: 2px;"></i>
              <div>
                <h4 style="color: #0B1118; font-size: 17px; font-weight: 700; margin: 0 0 6px;">
                  Inquiry Formatted for Direct Dispatch
                </h4>
                <p style="color: #334155; font-size: 14px; line-height: 1.6; margin: 0 0 16px;">
                  Thank you, <strong>${name}</strong>. Your inquiry has been validated and compiled. Click below to launch your email client to transmit it directly to our commercial sales desk at <strong>maxglovesbdltd@gmail.com</strong>, or call us immediately.
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                  <a href="${mailtoLink}" class="btn-crimson font-mono" style="padding: 10px 20px; font-size: 13.5px;">
                    <i class="far fa-envelope"></i> Open in Email Client
                  </a>
                  <a href="https://wa.me/8801710591088" target="_blank" rel="noopener noreferrer" class="btn-steel-outline font-mono" style="padding: 10px 20px; font-size: 13.5px;">
                    <i class="fab fa-whatsapp" style="color: #25D366;"></i> WhatsApp +880 1710-591088
                  </a>
                </div>
              </div>
            </div>
          </div>
        `;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactPageScript);
  } else {
    initContactPageScript();
  }
</script>
