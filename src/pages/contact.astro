---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import BRAND from '../config/site';
---

<BaseLayout title="Contact Us - Max Gloves BD Ltd." currentPath="/contact">
  <PageBanner title="Contact With Us" breadcrumbs={[{ label: 'Home', url: '/' }, { label: 'Contact With Us' }]} />

  <section class="contact-wrap-layout2" style="padding: 70px 0;">
    <div class="container">
      <div class="row">
        <!-- Main Form & Map Column (col-lg-8) -->
        <div class="col-lg-8">
          <div class="contact-box-layout2">
            <!-- Google Maps Embed: Office Location -->
            <div class="contact-wrap-map" style="margin-bottom: 35px; border-radius: 6px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.08);">
              <iframe
                src="https://maps.google.com/maps?q=585%2FC%2C+Khilgaon%2C+C+Block%2C+Dhaka-1219%2C+Bangladesh&t=&z=15&ie=UTF8&iwloc=&output=embed"
                width="100%"
                height="450"
                style="border:0; display: block;"
                allowfullscreen=""
                loading="lazy"
                title="Max Gloves BD Ltd. Office Location Map"
              ></iframe>
            </div>

            <!-- Contact Form -->
            <div class="contact-form" style="background: #ffffff; padding: 40px; border-radius: 6px; box-shadow: 0 4px 20px rgba(0,0,0,0.06); border: 1px solid #ebebeb;">
              <div class="heading-layout3" style="margin-bottom: 25px;">
                <h3 class="mg-b-10" style="font-size: 26px; font-weight: 700; color: var(--brand-navy);">Get In Touch With Us!</h3>
                <p style="color: #666; font-size: 14.5px; margin-top: 6px;">Have questions about our glove catalog, customized OEM manufacturing, or factory orders? Send us an inquiry below.</p>
              </div>

              <form class="contact-form-box" id="contactForm">
                <div class="row gutters-15">
                  <div class="col-md-6 col-12 form-group" style="margin-bottom: 20px;">
                    <input
                      type="text"
                      placeholder="Name *"
                      class="form-control"
                      name="name"
                      id="nameInput"
                      required
                      style="height: 50px; border: 1px solid #ddd; padding: 10px 18px; border-radius: 4px; width: 100%; font-size: 15px;"
                    />
                    <div class="help-block with-errors" style="color: var(--brand-orange); font-size: 13px; margin-top: 4px;"></div>
                  </div>

                  <div class="col-md-6 col-12 form-group" style="margin-bottom: 20px;">
                    <input
                      type="email"
                      placeholder="E-mail *"
                      class="form-control"
                      name="email"
                      id="emailInput"
                      required
                      style="height: 50px; border: 1px solid #ddd; padding: 10px 18px; border-radius: 4px; width: 100%; font-size: 15px;"
                    />
                    <div class="help-block with-errors" style="color: var(--brand-orange); font-size: 13px; margin-top: 4px;"></div>
                  </div>

                  <div class="col-md-6 col-12 form-group" style="margin-bottom: 20px;">
                    <input
                      type="text"
                      placeholder="Phone"
                      class="form-control"
                      name="phone"
                      id="phoneInput"
                      style="height: 50px; border: 1px solid #ddd; padding: 10px 18px; border-radius: 4px; width: 100%; font-size: 15px;"
                    />
                    <div class="help-block with-errors" style="color: var(--brand-orange); font-size: 13px; margin-top: 4px;"></div>
                  </div>

                  <div class="col-md-6 col-12 form-group" style="margin-bottom: 20px;">
                    <input
                      type="text"
                      placeholder="Subject *"
                      class="form-control"
                      name="subject"
                      id="subjectInput"
                      required
                      style="height: 50px; border: 1px solid #ddd; padding: 10px 18px; border-radius: 4px; width: 100%; font-size: 15px;"
                    />
                    <div class="help-block with-errors" style="color: var(--brand-orange); font-size: 13px; margin-top: 4px;"></div>
                  </div>

                  <div class="col-12 form-group" style="margin-bottom: 25px;">
                    <textarea
                      placeholder="Comments *"
                      class="textarea form-control"
                      name="comment"
                      id="commentInput"
                      rows="7"
                      required
                      style="border: 1px solid #ddd; padding: 14px 18px; border-radius: 4px; width: 100%; font-size: 15px; resize: vertical;"
                    ></textarea>
                    <div class="help-block with-errors" style="color: var(--brand-orange); font-size: 13px; margin-top: 4px;"></div>
                  </div>

                  <div class="col-12 form-group">
                    <button
                      type="submit"
                      class="item-btn btn-fill-lg btn-accent text-light"
                      id="submitBtn"
                      style="background: var(--brand-orange); color: #ffffff; border: none; padding: 14px 36px; border-radius: 4px; font-weight: 700; font-size: 16px; cursor: pointer; transition: background 0.25s;"
                    >
                      Send Now
                    </button>
                  </div>
                </div>

                <div id="formStatus" class="form-feedback"></div>
              </form>
            </div>
          </div>
        </div>

        <!-- Sidebar Column (col-lg-4) -->
        <div class="col-lg-4 sidebar-break-md sidebar-widget-area">
          <!-- 1. Direct Contact Card (Phone & Email First) -->
          <ul class="list-group" style="margin-bottom: 25px; list-style: none; padding: 0;">
            <li class="list-group-item list-group-item-info" style="background: var(--brand-navy); color: #ffffff; border: none; padding: 14px 20px; border-radius: 6px 6px 0 0;">
              <h4 style="color: #ffffff; margin: 0; font-size: 18px; display: flex; align-items: center; gap: 10px;">
                <i class="fas fa-headset" style="color: var(--brand-orange);"></i> Direct Contact
              </h4>
            </li>
            <li class="list-group-item" style="border: 1px solid #ebebeb; border-top: none; border-radius: 0 0 6px 6px; padding: 25px 20px; background: #ffffff; box-shadow: 0 4px 15px rgba(0,0,0,0.06);">
              <div class="row section-info ourTeam-box text-center">
                <div class="col-md-12 section2 pb-3" style="margin-bottom: 15px;">
                  <p style="padding-top: 2px; font-size: 18px; font-weight: bold; color: var(--brand-navy); margin-bottom: 4px;">[PLACEHOLDER: contact person name needs confirmation]</p>
                  <span style="font-size: 15px; font-weight: bold; color: var(--brand-orange);">Sales and Marketing</span><br />
                  <span style="font-size: 14px; font-weight: 600; color: #555;">{BRAND.companyName}</span>
                </div>
                <div class="col-md-12" style="font-size: 14.5px; line-height: 32px; text-align: left;">
                  <!-- Phone -->
                  <p style="margin: 0; display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-phone-alt" style="color: var(--brand-orange); width: 18px;"></i>
                    <a href={BRAND.phoneTel} style="color: #111; text-decoration: none; font-weight: 700;">{BRAND.phone}</a>
                  </p>
                  <!-- Email -->
                  <p style="margin: 0; display: flex; align-items: center; gap: 10px;">
                    <i class="far fa-envelope" style="color: var(--brand-orange); width: 18px;"></i>
                    <a href={BRAND.emailMailto} style="color: #111; text-decoration: none; font-weight: 600;">{BRAND.email}</a>
                  </p>
                  <!-- Website -->
                  <p style="margin: 0; display: flex; align-items: center; gap: 10px;">
                    <i class="fas fa-globe" style="color: var(--brand-orange); width: 18px;"></i>
                    <a href={BRAND.websiteUrl} target="_blank" rel="noopener noreferrer" style="color: #111; text-decoration: none; font-weight: 500;">{BRAND.website}</a>
                  </p>

                  <div class="col-md-12 text-center" style="margin-top: 20px;">
                    <button class="vc-trigger" id="vcOpenBtn" style="background: var(--brand-navy); color: #fff; border: none; padding: 10px 22px; border-radius: 4px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
                      <i class="far fa-id-card"></i> View Card
                    </button>
                  </div>
                </div>
              </div>
            </li>
          </ul>

          <!-- 2. Office Address Card -->
          <div class="widget widget-contact-info" style="background: #ffffff; padding: 25px; border-radius: 6px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); border: 1px solid #ebebeb; margin-bottom: 25px;">
            <div class="media" style="display: flex; gap: 15px; align-items: flex-start;">
              <div class="item-icon" style="color: var(--brand-orange); font-size: 28px; line-height: 1;">
                <i class="fas fa-building"></i>
              </div>
              <div class="media-body space-md">
                <h4 style="font-size: 17px; font-weight: 700; color: var(--brand-navy); margin-bottom: 6px;">Head Office</h4>
                <p style="margin: 0; color: #555; line-height: 22px; font-size: 14.5px;">
                  {BRAND.officeAddress}
                </p>
                <div style="margin-top: 8px;">
                  <a href="#wrapper" onclick="window.scrollTo({top: 200, behavior: 'smooth'}); return false;" style="font-size: 13px; color: var(--brand-orange); font-weight: 600; text-decoration: none;">
                    <i class="fas fa-map-marked-alt"></i> View on map above
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- 3. Factory Address Card -->
          <div class="widget widget-contact-info" style="background: #ffffff; padding: 25px; border-radius: 6px; box-shadow: 0 4px 15px rgba(0,0,0,0.06); border: 1px solid #ebebeb; margin-bottom: 25px;">
            <div class="media" style="display: flex; gap: 15px; align-items: flex-start;">
              <div class="item-icon" style="color: var(--brand-orange); font-size: 28px; line-height: 1;">
                <i class="fas fa-industry"></i>
              </div>
              <div class="media-body space-md">
                <h4 style="font-size: 17px; font-weight: 700; color: var(--brand-navy); margin-bottom: 6px;">Factory</h4>
                <p style="margin: 0; color: #555; line-height: 22px; font-size: 14.5px;">
                  {BRAND.factoryAddress}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Visiting Card Modal Dialog -->
  <dialog id="vcDialog">
    <div class="vc-modal-inner">
      <button class="vc-close" id="vcCloseBtn" aria-label="Close">&times;</button>
      <div class="card-badge icon" style="text-align: center;">
        <img
          src="/front-end/img/max-visiting-card.png"
          alt="Max Gloves BD Ltd. Visiting Card"
          loading="lazy"
          style="width: 100%; height: auto; border-radius: 6px; display: block; box-shadow: 0 4px 15px rgba(0,0,0,0.1);"
        />
      </div>
    </div>
  </dialog>
</BaseLayout>

<style>
  @media (max-width: 767px) {
    .contact-wrap-layout2 {
      padding: 40px 0 !important;
    }
    .contact-form {
      padding: 24px 16px !important;
    }
    .contact-wrap-map iframe {
      height: 280px !important;
    }
    .heading-layout3 h3 {
      font-size: 22px !important;
    }
  }
</style>

<script>
  function initContactPage() {
    const vcOpenBtn = document.getElementById('vcOpenBtn');
    const vcCloseBtn = document.getElementById('vcCloseBtn');
    const vcDialog = document.getElementById('vcDialog') as HTMLDialogElement;

    if (vcOpenBtn && vcDialog) {
      vcOpenBtn.addEventListener('click', () => {
        vcDialog.showModal();
      });
    }

    if (vcCloseBtn && vcDialog) {
      vcCloseBtn.addEventListener('click', () => {
        vcDialog.close();
      });
    }

    if (vcDialog) {
      vcDialog.addEventListener('click', (e) => {
        if (e.target === vcDialog) {
          vcDialog.close();
        }
      });
    }

    const contactForm = document.getElementById('contactForm') as HTMLFormElement;
    const formStatus = document.getElementById('formStatus');

    if (contactForm && formStatus) {
      contactForm.addEventListener('submit', (e) => {
        e.preventDefault();

        const nameEl = document.getElementById('nameInput') as HTMLInputElement;
        const emailEl = document.getElementById('emailInput') as HTMLInputElement;
        const phoneEl = document.getElementById('phoneInput') as HTMLInputElement;
        const subjectEl = document.getElementById('subjectInput') as HTMLInputElement;
        const commentEl = document.getElementById('commentInput') as HTMLTextAreaElement;

        const name = nameEl?.value.trim() || '';
        const email = emailEl?.value.trim() || '';
        const phone = phoneEl?.value.trim() || '';
        const subject = subjectEl?.value.trim() || '';
        const comment = commentEl?.value.trim() || '';

        // Email validation regex
        const emailPattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
        if (!name || name.length < 2) {
          formStatus.innerHTML = '<div style="color: #d9534f; background: #fff0f0; border: 1px solid #ffcccc; padding: 12px; border-radius: 4px; font-weight: 600;"><i class="fas fa-exclamation-triangle"></i> Please provide your full name (minimum 2 characters).</div>';
          nameEl?.focus();
          return;
        }

        if (!emailPattern.test(email)) {
          formStatus.innerHTML = '<div style="color: #d9534f; background: #fff0f0; border: 1px solid #ffcccc; padding: 12px; border-radius: 4px; font-weight: 600;"><i class="fas fa-exclamation-triangle"></i> Please provide a valid email address.</div>';
          emailEl?.focus();
          return;
        }

        if (!subject || subject.length < 3) {
          formStatus.innerHTML = '<div style="color: #d9534f; background: #fff0f0; border: 1px solid #ffcccc; padding: 12px; border-radius: 4px; font-weight: 600;"><i class="fas fa-exclamation-triangle"></i> Please enter an inquiry subject.</div>';
          subjectEl?.focus();
          return;
        }

        if (!comment || comment.length < 5) {
          formStatus.innerHTML = '<div style="color: #d9534f; background: #fff0f0; border: 1px solid #ffcccc; padding: 12px; border-radius: 4px; font-weight: 600;"><i class="fas fa-exclamation-triangle"></i> Please enter your message or question.</div>';
          commentEl?.focus();
          return;
        }

        // Construct pre-filled email inquiry for honest fallback
        const emailBody = `Name: ${name}\nEmail: ${email}\nPhone: ${phone || 'N/A'}\nSubject: ${subject}\n\nMessage:\n${comment}\n\n---\nSent via MAX GLOVES BD LTD. Website`;
        const mailtoLink = `mailto:maxglovesbdltd@gmail.com?subject=${encodeURIComponent(`[Website Inquiry] ${subject}`)}&body=${encodeURIComponent(emailBody)}`;

        formStatus.innerHTML = `
          <div style="background: #f0f7ff; border: 2px solid #05254F; border-radius: 6px; padding: 22px 20px; margin-top: 25px; box-shadow: 0 4px 15px rgba(5,37,79,0.08);">
            <div style="display: flex; align-items: flex-start; gap: 14px;">
              <i class="fas fa-info-circle" style="color: var(--brand-navy); font-size: 24px; margin-top: 2px; flex-shrink: 0;"></i>
              <div>
                <h4 style="color: var(--brand-navy); font-size: 17px; font-weight: 700; margin: 0 0 6px;">
                  Thank you, ${name}! Inquiry Prepared
                </h4>
                <p style="color: #334155; font-size: 14px; margin: 0 0 14px; line-height: 1.6;">
                  Direct automated form delivery is currently operating in direct-inquiry mode. Your inquiry has been validated and formatted. Click below to launch your email client to dispatch it directly to our sales inbox at <strong>maxglovesbdltd@gmail.com</strong>, or call us directly.
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 12px;">
                  <a href="${mailtoLink}" class="btn" style="background: var(--brand-orange); color: #ffffff; text-decoration: none; padding: 10px 22px; border-radius: 4px; font-weight: 700; font-size: 14px; display: inline-flex; align-items: center; gap: 8px;">
                    <i class="far fa-envelope"></i> Open in Email Client
                  </a>
                  <a href="tel:+8801710591088" class="btn" style="background: var(--brand-navy); color: #ffffff; text-decoration: none; padding: 10px 22px; border-radius: 4px; font-weight: 700; font-size: 14px; display: inline-flex; align-items: center; gap: 8px;">
                    <i class="fas fa-phone-alt"></i> Call +880 1710-591088
                  </a>
                </div>
              </div>
            </div>
          </div>
        `;
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContactPage);
  } else {
    initContactPage();
  }
</script>
