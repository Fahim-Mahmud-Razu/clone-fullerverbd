---
import ProcessLayout from '../../components/ProcessLayout.astro';

const images = [
  '/front-end/img/workingprocess/pro/01.jpg',
  '/front-end/img/workingprocess/pro/02.jpg',
  '/front-end/img/workingprocess/pro/03.jpg'
];

const paragraphs = [
  '가죽 부분을 재봉 부서로 가져간 후 함께 재봉하여 장갑을 만듭니다. 우리는 모든 필요에 맞는 다양한 유형의 장갑을 생산하는 18가지 재봉 라인을 보유하고 있습니다. 그런 다음 장갑을 다시 검사하고 그룹별로 분류하여 마감 부서로 보냅니다.',
  'Max Gloves BD Ltd.가 다른 안전 장갑 제조업체에 비해 최고 수준의 제품을 생산하는 이유 중 하나는 세부 사항에 대한 관심입니다. 당사의 장갑은 일반 업계 관행인 5~6바늘과 비교하여 장갑 인치당 표준 8바늘로 재봉됩니다. 스티치를 늘리면 장갑 내구성과 장갑의 수명이 크게 늘어납니다.'
];
---

<ProcessLayout
  title="봉제 공정"
  subtitle="봉제 공정"
  currentPath="/kr/sewing-process"
  images={images}
  paragraphs={paragraphs}
  locale="kr"
/>
