---
import ProcessLayout from '../components/ProcessLayout.astro';

const images = [
  '/front-end/img/workingprocess/ps/01.jpg',
  '/front-end/img/workingprocess/ps/02.jpg',
  '/front-end/img/workingprocess/ps/03.jpg'
];

const paragraphs = [
  'Once inspected and graded for production, raw leather is transferred to our precision cutting department. Max Gloves BD Ltd. utilizes modern automated hydraulic and die cutting presses for high precision, optimal hide yield, and uniform component shapes. Once cut, components are sorted, paired, and inspected before progressing to the sewing assembly line.',
  'Through disciplined craftsmanship, automated cutting technology, and continuous quality monitoring, Max Gloves BD Ltd. operates a highly efficient production facility capable of scaling to meet demanding volume requirements [PLACEHOLDER — Exact monthly capacity to be confirmed with Max Gloves].'
];
---

<ProcessLayout
  title="Cutting Process"
  subtitle="Cutting Process"
  currentPath="/cutting-process"
  images={images}
  paragraphs={paragraphs}
/>
