---
import ProcessLayout from '../components/ProcessLayout.astro';

const images = [
  '/front-end/img/workingprocess/rm/01.jpg',
  '/front-end/img/workingprocess/rm/02.jpg',
  '/front-end/img/workingprocess/rm/03.jpg'
];

const paragraphs = [
  'At Max Gloves BD Ltd., we source premium quality leather from established, trusted suppliers. The majority of our leather and accessories are procured from certified domestic tanneries in Bangladesh alongside specialized international material partners, enabling Max Gloves BD Ltd. to maintain consistent supply chains and eliminate production delays.',
  'All incoming raw leather undergoes stringent multi-stage inspection before entering production to ensure superior durability and protection. We select premium cow split, shoulder suede, and high-grade A/B grain leathers suited for demanding industrial safety applications.'
];
---

<ProcessLayout
  title="Raw Materials"
  subtitle="Raw Materials"
  currentPath="/raw-materials"
  images={images}
  paragraphs={paragraphs}
/>
