---
import ProcessLayout from '../../components/ProcessLayout.astro';

const images = [
  '/front-end/img/workingprocess/rm/01.jpg',
  '/front-end/img/workingprocess/rm/02.jpg',
  '/front-end/img/workingprocess/rm/03.jpg'
];

const paragraphs = [
  'FULLEVER BD LIMITED では、安全で信頼できるサプライヤーから供給される高品質の革を調達するよう努めています。 その結果、当社の革製品および生産用アクセサリーの 80% はバングラデシュ国内から供給され、グレインレザーの残りの 20% は中国の信頼できる供給元から供給されています。 これにより、FULLEVER BD LIMITED は生産の遅延を最小限に抑えることができます',
  '高品質のグローブを保証するために、私たちが購入するすべての革は生産の複数のポイントで検査および品質チェックされます。 当社がすべての手袋に使用している革は、バット スプリットまたはショルダー スプリットのスエード品質と、A、B グレードのグレイン レザーで構成されています。'
];
---

<ProcessLayout
  title="原材料"
  subtitle="原材料"
  currentPath="/jp/raw-materials"
  images={images}
  paragraphs={paragraphs}
  locale="jp"
/>
