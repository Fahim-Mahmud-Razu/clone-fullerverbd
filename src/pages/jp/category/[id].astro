---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageBanner from '../../../components/PageBanner.astro';
import jpData from '../../../data/jp_data.json';
import products from '../../../data/products.json';
import categories from '../../../data/categories.json';
import BRAND from '../../../config/site';

export function getStaticPaths() {
  return jpData.categories.map((cat) => ({
    params: { id: cat.id.toString() },
    props: { category: cat }
  }));
}

interface Props {
  category: {
    id: number;
    title: string;
    url: string;
    img: string;
  };
}

const { category } = Astro.props;

// Find matching product IDs from main category definition
const baseCat = categories.find((c) => c.id === category.id);
const categoryProducts = (baseCat?.product_ids || [])
  .map((pid) => products.find((p) => p.id === pid))
  .filter((p): p is typeof products[0] => Boolean(p));
---

<BaseLayout title={`${category.title} — ${BRAND.companyName}`} currentPath={`/jp/category/${category.id}`} locale="jp">
  <PageBanner
    title={category.title}
    breadcrumbs={[{ label: 'ホームページ', url: '/jp/' }, { label: '製品カテゴリー', url: '/jp/category/20' }, { label: category.title }]}
  />

  <section class="category-catalog-section" aria-label={`${category.title} カタログ`}>
    <div class="container">
      <!-- Category Catalog Header -->
      <div class="category-header-bar d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-5 pb-3">
        <div>
          <div class="font-mono text-muted text-uppercase" style="font-size: 11.5px; letter-spacing: 0.08em; margin-bottom: 6px;">
            CATEGORY REF // CAT-{category.id.toString().padStart(2, '0')}
          </div>
          <h2 class="category-page-title">{category.title}</h2>
        </div>
        <div class="mt-3 mt-md-0 d-flex align-items-center gap-3">
          <span class="catalog-count-pill font-mono">
            {categoryProducts.length} モデル認証
          </span>
          <a href="/jp/contact" class="btn-crimson font-mono" style="padding: 9px 18px; font-size: 13px;">
            <i class="far fa-paper-plane" aria-hidden="true"></i>
            <span>見積依頼 (RFQ)</span>
          </a>
        </div>
      </div>

      <!-- Standardized 4:3 Studio Wells Product Grid -->
      <div class="row g-4">
        {categoryProducts.map((prod) => (
          <div class="col-xl-4 col-md-6 col-12">
            <a href={`/product/${prod.id}`} class="product-item-card" aria-label={`${prod.title} (SKU: ${prod.sku || prod.id}) を見る`}>
              <!-- 4:3 Studio Well -->
              <div class="studio-product-well">
                <div class="product-well-badges font-mono">
                  <span class="badge-sku">SKU: #{prod.sku || prod.id}</span>
                  {prod.sprite_image && <span class="badge-3d">3D表示</span>}
                </div>
                <img
                  src={prod.preview_image || prod.sprite_image}
                  alt={prod.title}
                  loading="lazy"
                  decoding="async"
                  class="product-well-img"
                />
              </div>

              <!-- Product Info Card Body -->
              <div class="product-card-body">
                <div class="product-cat-kicker font-mono">{category.title}</div>
                <h3 class="product-card-title">{prod.title}</h3>
                <div class="product-card-action font-mono">
                  <span>仕様・詳細を確認</span>
                  <i class="fas fa-arrow-right text-crimson" aria-hidden="true"></i>
                </div>
              </div>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-catalog-section {
    background-color: var(--color-canvas, #F8FAFC);
    padding: 70px 0 90px;
  }

  .category-header-bar {
    border-bottom: 1px solid var(--color-border, #E2E8F0);
  }
  .category-page-title {
    font-size: clamp(26px, 3.5vw, 36px);
    font-weight: 800;
    color: var(--color-steel, #0B1118);
    letter-spacing: -0.02em;
    margin: 0;
  }
  .catalog-count-pill {
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 11.5px;
    color: var(--color-steel, #0B1118);
    font-weight: 600;
  }

  /* Product Card Container */
  .product-item-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: #FFFFFF;
    border: 1px solid var(--color-border, #E2E8F0);
    border-radius: 4px;
    overflow: hidden;
    height: 100%;
    transition: all 0.2s ease;
  }
  .product-item-card:hover {
    border-color: var(--color-border-dark, #CBD5E1);
    box-shadow: 0 8px 24px rgba(11, 17, 24, 0.06);
    transform: translateY(-2px);
  }

  /* 4:3 Neutral Studio Well */
  .studio-product-well {
    position: relative;
    aspect-ratio: 4 / 3;
    background-color: var(--color-well, #F1F5F9);
    border-bottom: 1px solid var(--color-border, #E2E8F0);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    overflow: hidden;
  }

  .product-well-badges {
    position: absolute;
    top: 12px;
    left: 12px;
    right: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    pointer-events: none;
    z-index: 2;
  }
  .badge-sku {
    font-size: 11px;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.95);
    color: var(--color-steel, #0B1118);
    border: 1px solid var(--color-border, #E2E8F0);
    padding: 2px 8px;
    border-radius: 3px;
  }
  .badge-3d {
    font-size: 10.5px;
    font-weight: 700;
    background: var(--color-steel, #0B1118);
    color: #FFFFFF;
    padding: 2px 7px;
    border-radius: 3px;
    letter-spacing: 0.04em;
  }

  .product-well-img {
    max-width: 85%;
    max-height: 85%;
    object-fit: contain;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    filter: drop-shadow(0 4px 12px rgba(11, 17, 24, 0.08));
  }
  .product-item-card:hover .product-well-img {
    transform: scale(1.05);
  }

  /* Card Body */
  .product-card-body {
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background: #FFFFFF;
  }
  .product-cat-kicker {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #64748B;
    margin-bottom: 6px;
  }
  .product-card-title {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-steel, #0B1118);
    line-height: 1.35;
    margin-bottom: 16px;
    flex-grow: 1;
  }
  .product-card-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--color-steel, #0B1118);
    padding-top: 14px;
    border-top: 1px solid #F1F5F9;
  }
  .product-item-card:hover .product-card-action {
    color: var(--color-crimson, #C81E1E);
  }
  .product-item-card:hover .product-card-action i {
    transform: translateX(4px);
    transition: transform 0.2s ease;
  }
</style>
