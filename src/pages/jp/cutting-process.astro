---
import ProcessLayout from '../../components/ProcessLayout.astro';

const images = [
  '/front-end/img/workingprocess/ps/01.jpg',
  '/front-end/img/workingprocess/ps/02.jpg',
  '/front-end/img/workingprocess/ps/03.jpg'
];

const paragraphs = [
  '当社の革は、生産に適していることが品質検査された後、裁断部門に送られます。 FULLEVER BD LIMITED は強力な自動切断機を使用しており、より速い速度でより高い歩留まりを実現します。 裁断工程が完了した後、すべての手袋の部品がグループ化され、別の品質検査が行われます。 私たちの縫製部門に送られる前に',
  '当社の最先端の技術革新と西洋的な管理スタイルにより、フルエバーは月に 80,000 ～ 100,000 ダースの手袋を生産できる効率的で熟練した工場を運営することができます。'
];
---

<ProcessLayout
  title="切断工程"
  subtitle="切断工程"
  currentPath="/jp/cutting-process"
  images={images}
  paragraphs={paragraphs}
  locale="jp"
/>
