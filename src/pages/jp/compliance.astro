---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageBanner from '../../components/PageBanner.astro';
import CertificationSlider from '../../components/CertificationSlider.astro';
---

<BaseLayout title="コンプライアンス - FULLEVER BD LIMITED" currentPath="/jp/compliance" locale="jp">
  <PageBanner title="コンプライアンス" breadcrumbs={[{ label: 'ホームページ', url: '/jp/' }, { label: 'コンプライアンス' }]} />

  <section class="about-wrap-layout7 bg-shape-2" style="padding: 70px 0; background: #ffffff;">
    <div class="container">
      <div class="row about-box-layout9">
        <!-- Left Column -->
        <div class="col-lg-6 col-12 single-item left-item">
          <!-- 1. 法的遵守 -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="far fa-file" style="font-size: 50px; color: #082c4b;"></i>
              <b style="font-size: 20px;">法的遵守</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 組織方針（ILO、労働法、組織基準に基づく）</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 貿易ライセンス</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 消防免許</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 工場ライセンス</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 債券ライセンス</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> バングラデシュ投資開発庁 (BIDA)</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 会員証 バングラデシュ皮革製品・履物製造輸出業者協会 (LFMEAB)</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 環境クリアランス証明書</p>
          </div>

          <!-- 2. 管理システム -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="fas fa-th-large" style="font-size: 50px; color: #082c4b;"></i>
              <b style="font-size: 20px;">管理システム</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 強力なポリシー/行動規範</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 各ポリシーには、実装、制御、報告、監視のための異なるチームが存在します</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> バングラデシュ労働法と規則、ILO中心条約、ECA-1995、ECR:2023、ISO-14001、ISO-5001に基づいた強力なコンプライアンスの維持</p>
          </div>

          <!-- 3. 勤務時間 -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="far fa-clock" style="font-size: 50px; color: #082c4b;"></i>
              <b style="font-size: 20px;">勤務時間</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 一般労働 08時間勤務</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 通常勤務 午前8時から午後5時まで</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> バングラデシュ労働法/ILO基準に基づく時間外勤務</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 週休01日</p>
          </div>

          <!-- 4. 報酬と福利厚生 -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="fas fa-hand-holding-usd" style="font-size: 50px; color: #082c4b;"></i>
              <b style="font-size: 20px;">報酬と福利厚生:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> すべての給付と報酬はバングラデシュ労働法に従います</p>
          </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-6 col-12 single-item right-item">
          <!-- 5. 結社の自由と団体交渉の権利 -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <img src="/front-end/img/gallery/Freedom-of-Association-and-Collective-Bargaining1-150x150.png" width="60" height="60" alt="結社の自由" />
              <b style="font-size: 20px;">結社の自由と団体交渉の権利</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 労働者は自らの表現方法を自由に選択できる</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 企業交渉は、企業協定を締結することを目的として、雇用主と従業員の交渉代表者の間で交渉されます</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 会議議事録は工場および事業所の検査局に送信されます</p>
          </div>

          <!-- 6. 児童労働の禁止 -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <img src="/front-end/img/gallery/No_Child_labor.png" width="65" height="65" alt="児童労働の禁止" />
              <b style="font-size: 20px;">児童労働の禁止</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 18歳未満の従業員の採用は禁止</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> NID/出生証明書/学歴証明書で年齢確認済み</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 医師および医療助手による体力チェック</p>
          </div>

          <!-- 7. 差別の禁止 -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <img src="/front-end/img/gallery/prohibition_discrimination.png" width="60" height="60" alt="差別の禁止" />
              <b style="font-size: 20px;">差別の禁止</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 差別の禁止</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 誰もが平等に扱われる</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 経営陣は差別を一切許容しません</p>
          </div>

          <!-- 8. 職場の健康と安全 -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="fas fa-user-md" style="font-size: 50px; color: #082c4b;"></i>
              <b style="font-size: 20px;">職場の健康と安全</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 環境衛生と安全に関する強力なポリシーを持つ</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 応急処置、医療契約の確保</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 職場における健康と衛生の確保</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 定期的な清掃、換気、温度管理</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> 粉塵・ガスの防止、過密防止</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> すべての従業員に適切な照明と清潔な飲料水を提供</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> すべての従業員に個人用保護具 (PPE) を確保</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <CertificationSlider />
</BaseLayout>
