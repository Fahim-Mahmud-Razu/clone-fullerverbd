---
import ProcessLayout from '../../components/ProcessLayout.astro';

const images = [
  '/front-end/img/workingprocess/pa/01.jpg',
  '/front-end/img/workingprocess/pa/02.jpg',
  '/front-end/img/workingprocess/pa/03.jpg',
  '/front-end/img/workingprocess/pa/04.jpg'
];

const paragraphs = [
  '手袋が縫製された後、2 つの品質検査が行われます。 1 つはステッチとトリミングをチェックするためのもので、手袋を裏返してアイロンステーションに送ります。 手袋を金属探知機に送る前に、欠陥や欠陥がないか最終検査が行われます。 金属探知機では、梱包に汚れがないこと、および安定した高品質で時間どおりに届くことを保証するために、完成したすべての手袋をチェックします。',
  '最後に、手袋は準備され、箱に梱包され、顧客への出荷を待つ倉庫に送られます。 Max Gloves BD Ltd. はお客様に可能な限り最高のサービスを提供できるように、すべての出荷を管理する社内輸出入部門を持っています。'
];
---

<ProcessLayout
  title="包装"
  subtitle="包装"
  currentPath="/jp/packaging"
  images={images}
  paragraphs={paragraphs}
  locale="jp"
/>
