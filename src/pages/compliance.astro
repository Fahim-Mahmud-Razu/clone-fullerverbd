---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import CertificationSlider from '../components/CertificationSlider.astro';
---

<BaseLayout title="Compliance - Max Gloves BD Ltd." currentPath="/compliance">
  <PageBanner title="Compliance" breadcrumbs={[{ label: 'Home', url: '/' }, { label: 'Compliance' }]} />

  <section class="about-wrap-layout7 bg-shape-2" style="padding: 70px 0; background: #ffffff;">
    <div class="container">
      <div class="row about-box-layout9">
        <!-- Left Column -->
        <div class="col-lg-6 col-12 single-item left-item">
          <!-- 1. Legal Compliance -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="far fa-file" style="font-size: 50px; color: var(--brand-navy);"></i>
              <b style="font-size: 20px;">Legal Compliance:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Organization Policy (Based on ILO, Labour Law & Organization Standard)</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Trade License</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Fire License</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Factory License</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Bond License</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Bangladesh Investments Development Authority (BIDA)</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Membership Certificate Leather goods And Footwear Manufacturers & Exporters Association of Bangladesh (LFMEAB)</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Environment Clearance Certificate</p>
          </div>

          <!-- 2. Management Systems -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <img src="/front-end/img/gallery/management_Systems.png" width="60" height="60" alt="Management Systems" />
              <b style="font-size: 20px;">Management Systems:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Strong Policy / Code of Conduct</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Every policy has different team for Implementing, Controlling, Reporting & Monitoring</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Maintain strong compliance based on Bangladesh Labor Law & Rules, ILO core convention, ECA-1995, and ECR: 2023 [PLACEHOLDER: ISO certification audits pending confirmation]</p>
          </div>

          <!-- 3. Working Hours -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="far fa-clock" style="font-size: 50px; color: var(--brand-navy);"></i>
              <b style="font-size: 20px;">Working Hours:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> General Working 08 hours duty</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Normal Duty From 8.00 AM to 5.00 PM</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Over Time duty based as per Bangladesh Labour law / ILO standard</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Weekly Holiday 01 Day</p>
          </div>

          <!-- 4. Compensation & Benefits -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="fas fa-hand-holding-usd" style="font-size: 50px; color: var(--brand-navy);"></i>
              <b style="font-size: 20px;">Compensation & Benefits:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> All benefits & compensation are followed as per Bangladesh Labour Law</p>
          </div>
        </div>

        <!-- Right Column -->
        <div class="col-lg-6 col-12 single-item right-item">
          <!-- 5. Freedom of Association -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <img src="/front-end/img/gallery/Freedom-of-Association-and-Collective-Bargaining1-150x150.png" width="60" height="60" alt="Freedom of Association" />
              <b style="font-size: 20px;">Freedom of Association and Collective Bargaining:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Workers are free to choose how they are represented</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Enterprise bargaining is negotiated between the employer and employee bargaining representatives with the goal of making an enterprise agreement</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Meeting minutes are sent to Department of Inspection for Factories and Establishments</p>
          </div>

          <!-- 6. Prohibition of Child Labour -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <img src="/front-end/img/gallery/No_Child_labor.png" width="65" height="65" alt="No Child Labor" />
              <b style="font-size: 20px;">Prohibition of Child Labour:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> No recruitment under 18 years old employee</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Age verified with NID / Birth Certificate / Academic certificate</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Physical fitness check by Medical Officer & Medical Assistant</p>
          </div>

          <!-- 7. Prohibition of Discrimination -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <img src="/front-end/img/gallery/prohibition_discrimination.png" width="60" height="60" alt="Prohibition of Discrimination" />
              <b style="font-size: 20px;">Prohibition of Discrimination:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> No discrimination based on gender, religion, race, or caste</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Everyone is treated equally</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Management has zero tolerance for discrimination</p>
          </div>

          <!-- 8. Workplace Health and Safety -->
          <div class="item-content" style="text-align: justify; margin-bottom: 35px;">
            <h4 style="display: flex; align-items: center; gap: 15px; margin-bottom: 15px;">
              <i class="fas fa-user-md" style="font-size: 50px; color: var(--brand-navy);"></i>
              <b style="font-size: 20px;">Workplace Health and Safety:</b>
            </h4>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Strong policy on environmental health & safety</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Ensuring First Aid Treatment, Medical Contract</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Ensuring Health & Hygiene in the workplace</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Regular Cleanliness, Ventilation and temperature controlling</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Dust & fume protection, Over Crowding Prevention</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Proper lighting & Pure drinking water for all employees</p>
            <p style="margin-bottom: 8px;"><i class="fa fa-check" style="color: #28a745; margin-right: 8px;"></i> Ensure Personal Protective Equipment (PPE) for all employees</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Certifications Slider Section -->
  <CertificationSlider />
</BaseLayout>

<style>
  @media (max-width: 767px) {
    .about-wrap-layout7 {
      padding: 40px 0 !important;
    }
    .item-content {
      text-align: left !important;
      margin-bottom: 25px !important;
    }
    .item-content h4 {
      gap: 12px !important;
    }
    .item-content h4 i {
      font-size: 36px !important;
    }
    .item-content h4 img {
      width: 45px !important;
      height: 45px !important;
    }
    .item-content h4 b {
      font-size: 18px !important;
    }
    .item-content p {
      font-size: 14.5px !important;
      line-height: 22px !important;
    }
  }
</style>
