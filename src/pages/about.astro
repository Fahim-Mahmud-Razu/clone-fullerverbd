---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageBanner from '../components/PageBanner.astro';
import '../styles/about.css';
---

<BaseLayout title="About Us - Max Gloves BD Ltd." currentPath="/about">
  <PageBanner title="About Us" breadcrumbs={[{ label: 'Home', url: '/' }, { label: 'About Us' }]} />

  <div class="about-page-wrap">
    <!-- Company Profile Section -->
    <section class="section" id="about">
      <div class="container">
        <div class="head" style="margin-bottom: 25px;">
          <div class="kicker">About Us</div>
          <div class="rule" style="background: var(--brand-orange); height: 3px; width: 50px; margin: 10px 0;"></div>
          <h5 style="color: #4e6172; font-size: 16px; font-weight: 500; line-height: 1.7; margin-top: 10px;">
            A premier manufacturer and supplier of leather safety goods based in Savar, Hemayetpur, Bangladesh. Committed to delivering high-quality personal protective equipment and reliable service to global partners.
          </h5>
        </div>

        <div class="head">
          <div class="kicker">Who We Are</div>
          <h2 style="color: var(--brand-navy); font-weight: 800;">Experience, capacity and quality in every glove.</h2>
          <div class="rule" style="background: var(--brand-orange); height: 3px; width: 50px; margin: 10px 0;"></div>
        </div>

        <div class="about-grid">
          <article class="copy-card">
            <p>
              <strong>Max Gloves BD Ltd.</strong> is a dedicated manufacturer and supplier of leather safety goods based in Savar, Hemayetpur, Bangladesh. Guided by our core commitment—<em>Protecting Hands, Building Futures</em>—we provide workers worldwide with dependable, high-performance personal protective equipment.
            </p>
            <p>
              Our production facility in Savar, Hemayetpur specializes in industrial safety gloves, heavy-duty welding articles, and driver gloves engineered for maximum durability, ergonomics, and comfort.
            </p>
            <p>
              We maintain rigorous quality control across every stage of manufacturing—from raw leather grading and automated precision cutting to reinforced stitching and pre-shipment inspections.
            </p>
            <p>
              Customer service and consistent high-quality supply are our highest priorities. We provide professional, responsive service and customized OEM/ODM glove solutions tailored to the needs of our international partners.
            </p>
            <p>
              We record and track leather quality, inventory, and production data so that every glove batch meets strict safety standards before export.
            </p>
            <p>
              Our team manages international orders efficiently, providing transparent communication and reliable fulfillment to customers across the globe.
            </p>
          </article>

          <article class="image-card" style="display: flex; align-items: center; justify-content: center; background: #ffffff;">
            <img
              src="/front-end/img/max_cover.png"
              alt="Max Gloves BD Ltd. Company Profile"
              style="border: 2px solid var(--brand-orange); width: 100%; height: auto; object-fit: cover; border-radius: 8px; box-shadow: 0 8px 25px rgba(5,37,79,0.15);"
            />
          </article>
        </div>
      </div>
    </section>

    <!-- Statistics Strip -->
    <section class="stats">
      <div class="container">
        <div class="stats-grid">
          <div class="stat">
            <strong style="color: var(--brand-orange);">100%</strong>
            <span>Quality Commitment</span>
          </div>
          <div class="stat">
            <strong style="color: var(--brand-orange);">Premium</strong>
            <span>Leather Selection</span>
          </div>
          <div class="stat">
            <strong style="color: var(--brand-orange);">Export</strong>
            <span>Standard Compliance</span>
          </div>
          <div class="stat">
            <strong style="color: var(--brand-orange);">Global</strong>
            <span>Delivery Capability</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Vision Section -->
    <section class="section" id="vision">
      <div class="container">
        <div class="section-title">
          <div class="kicker">Our Vision</div>
          <h2 style="color: var(--brand-navy); font-weight: 800;">Responsible growth with a global purpose.</h2>
          <div class="title-line" style="background: var(--brand-orange);"></div>
        </div>

        <div class="vision">
          <figure class="image-card vision-image">
            <img style="border: 2px solid var(--brand-navy); border-radius: 8px;" src="/front-end/img/about/mission.jpg" alt="Mission and Vision" />
          </figure>

          <article class="copy-card vision-copy">
            <p>
              Our vision focuses on minimizing supply chain delays and delivering consistent excellence. By sourcing high quality raw materials and working with dependable local tanneries, we ensure stable production timelines and cost efficiency.
            </p>
            <p>
              Located strategically in Savar, Hemayetpur, Bangladesh, our facility benefits from excellent transportation links to Dhaka international airport and direct highway routes to major seaport hubs, enabling smooth logistics for air and sea freight.
            </p>
            <p>
              As a company, our goal is to become an indispensable partner in hand safety across global industries. We continually optimize patterns, reinforced palms, and stitching methods to create gloves that protect lives in tough working conditions.
            </p>
            <p>
              We believe that with the right partners, Max Gloves BD Ltd. can advance the rapidly growing PPE industry.
            </p>

            <div class="vision-points">
              <div class="point"><b>Domestic &amp; Global Sourcing</b><span>Dependable supply chain foundation.</span></div>
              <div class="point"><b>Efficient Logistics</b><span>Streamlined transit to airport and sea shipping hubs.</span></div>
              <div class="point"><b>Continuous Innovation</b><span>Improving glove ergonomics, protection, and durability.</span></div>
              <div class="point"><b>Global Safety Ambition</b><span>Protecting hands and building futures everywhere.</span></div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Commitment & CTA Section -->
    <section class="section commit">
      <div class="container">
        <div class="head">
          <div class="kicker">Our Commitment</div>
          <h2 style="color: var(--brand-navy); font-weight: 800;">What our partners can expect.</h2>
          <div class="rule" style="background: var(--brand-orange); height: 3px; width: 50px; margin: 10px 0;"></div>
        </div>

        <div class="grid3">
          <div class="mini">
            <div class="icon" style="background: var(--brand-orange-light); color: var(--brand-orange); font-weight: 800;">01</div>
            <h3>Consistent Quality</h3>
            <p>Rigorous multi-stage inspections support reliable, repeatable glove performance.</p>
          </div>
          <div class="mini">
            <div class="icon" style="background: var(--brand-orange-light); color: var(--brand-orange); font-weight: 800;">02</div>
            <h3>Reliable Supply</h3>
            <p>Structured manufacturing schedules and scalable capacity support long-term volume programs.</p>
          </div>
          <div class="mini">
            <div class="icon" style="background: var(--brand-orange-light); color: var(--brand-orange); font-weight: 800;">03</div>
            <h3>Fast Communication</h3>
            <p>Direct contact with our management team for rapid quotes, technical specs, and order tracking.</p>
          </div>
        </div>

        <!-- Sales CTA -->
        <div class="cta">
          <div>
            <h3>Looking for a reliable leather glove manufacturer?</h3>
            <p>Connect with Max Gloves BD Ltd. for sourcing, samples, and manufacturing inquiries.</p>
          </div>
          <a class="btn" href="mailto:maxglovesbdltd@gmail.com">Contact Sales</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
